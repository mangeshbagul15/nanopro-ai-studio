            <div style="display:flex; gap:6px; background:var(--bg-card); padding:3px; border-radius:6px; border:1px solid var(--border);">
                <button type="button" class="btn btn-sm btn-primary active" id="tabBtnDePipeline" onclick="switchDeSubTab('pipeline')">&#128394; 3D Pipeline</button>
                <button type="button" class="btn btn-sm btn-secondary" id="tabBtnDeConnections" onclick="switchDeSubTab('connections')">&#128268; Connections</button>
                <button type="button" class="btn btn-sm btn-secondary" id="tabBtnDeWorkspaces" onclick="switchDeSubTab('workspaces')">&#128187; SQL &amp; Python</button>
                <button type="button" class="btn btn-sm btn-secondary" id="tabBtnDeIngestion" onclick="switchDeSubTab('ingestion')">&#128194; Auto-Ingestion</button>
            </div>
        </div>
    </div>

    <!-- SUB-TAB 1: 3D ETL PIPELINE VISUALIZATION -->
    <div id="deSubTabPipeline">
        <!-- Pipeline Control Bar -->
        <div class="panel-card" style="margin-bottom:12px; padding:10px 14px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="display:flex; gap:8px; align-items:center;">
                    <button type="button" class="btn btn-primary" onclick="triggerEndToEndPipeline()" style="background:linear-gradient(135deg, #10B981, #0284C7); font-weight:700;">
                        &#9889; Run E2E Pipeline (Oracle/S3 &rarr; L0/L1/L2 &rarr; Excel &rarr; Email)
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="pauseAutonomousOps()">&#10074;&#10074; Pause</button>
                    <button type="button" class="btn btn-secondary" onclick="restartFailedTasksOps()">&#8634; Restart Failed</button>
                </div>
                <div style="font-size:11.5px; color:var(--text-muted);">
                    Status: <span style="color:#10B981; font-weight:700;">● Continuous Ops Ready</span>
                </div>
            </div>
        </div>

        <!-- 3D Pipeline Visualizer Viewport -->
        <div class="etl-pipeline-viewport" style="margin-bottom:12px;">
            <div class="pipeline-tiers-track" id="dePipelineTiersTrack">
                <!-- Tier 1: Source Systems -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s1_source')">
                    <div style="font-size:20px; margin-bottom:4px;">&#128452;</div>
                    <div style="font-size:10px; color:#38BDF8; font-weight:800; text-transform:uppercase;">1. Sources</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">Oracle XE &amp; AWS S3</div>
                    <div style="font-size:10px; color:#10B981; margin-top:4px;">● Connected</div>
                </div>

                <div class="pipeline-connector-line">&rarr;</div>

                <!-- Tier 2: Ingestion Engine -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s2_bronze')">
                    <div style="font-size:20px; margin-bottom:4px;">&#9889;</div>
                    <div style="font-size:10px; color:#38BDF8; font-weight:800; text-transform:uppercase;">2. Ingestion</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">Snowpipe &amp; Python CDC</div>
                    <div style="font-size:10px; color:#34D399; margin-top:4px;">142,500 rec/s</div>
                </div>

                <div class="pipeline-connector-line">&rarr;</div>

                <!-- Tier 3: Bronze Raw Staging -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s3_quality')">
                    <div style="font-size:20px; margin-bottom:4px;">&#129353;</div>
                    <div style="font-size:10px; color:#CD7F32; font-weight:800; text-transform:uppercase;">3. Bronze Layer</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">BANK_DB.L0_STAGING</div>
                    <div style="font-size:10px; color:#94A3B8; margin-top:4px;">Raw Immutable</div>
                </div>

                <div class="pipeline-connector-line">&rarr;</div>

                <!-- Tier 4: Silver Quality & Harmonization -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s4_silver')">
                    <div style="font-size:20px; margin-bottom:4px;">&#129352;</div>
                    <div style="font-size:10px; color:#E2E8F0; font-weight:800; text-transform:uppercase;">4. Silver Layer</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">L1 Harmonized</div>
                    <div style="font-size:10px; color:#10B981; margin-top:4px;">Quality Score: 99.4%</div>
                </div>

                <div class="pipeline-connector-line">&rarr;</div>

                <!-- Tier 5: Gold Curated Mart -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s5_gold')">
                    <div style="font-size:20px; margin-bottom:4px;">&#129351;</div>
                    <div style="font-size:10px; color:#F59E0B; font-weight:800; text-transform:uppercase;">5. Gold Layer</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">L2 Star Schema</div>
                    <div style="font-size:10px; color:#F59E0B; margin-top:4px;">Fact &amp; Dims Ready</div>
                </div>

                <div class="pipeline-connector-line">&rarr;</div>

                <!-- Tier 6: Reporting & Dispatch -->
                <div class="pipeline-tier-node" onclick="inspectPipelineStage('s6_dispatch')">
                    <div style="font-size:20px; margin-bottom:4px;">&#128231;</div>
                    <div style="font-size:10px; color:#EC4899; font-weight:800; text-transform:uppercase;">6. Dispatch</div>
                    <div style="font-size:12px; font-weight:700; color:#F8FAFC;">Excel &amp; Gmail SMTP</div>
                    <div style="font-size:10px; color:#38BDF8; margin-top:4px;">T-1 Financial Recon</div>
                </div>
            </div>
        </div>

        <!-- Selected Stage Inspector Box -->
        <div class="panel-card" id="deStageInspectorBox">
            <h3 style="font-size:13px; color:#38BDF8; margin:0 0 6px 0;" id="deStageInspectorTitle">&#128394; Stage Inspector: Click any pipeline stage node above for operational telemetry</h3>
            <div id="deStageInspectorContent" style="font-size:11.5px; color:#CBD5E1; line-height:1.5;">
                Select a stage node across the 3D pipeline flow to inspect active transformation rules, row throughput, AST cleaning checks, or logs.
            </div>
        </div>
    </div>

    <!-- SUB-TAB 2: DATABASE CONNECTIONS -->
    <div id="deSubTabConnections" style="display:none;">
        <div class="panel-card" style="margin-bottom:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <span style="font-size:13px; font-weight:700; color:#38BDF8;">&#128268; Warehouse &amp; Database Connection Endpoints</span>
                <button type="button" class="btn btn-primary" onclick="testDataEngineerConnections()" style="font-size:11px; padding:4px 10px;">&#9889; Test All Endpoints</button>
            </div>
            <div class="conn-nodes-grid" id="deNodesGrid">
                <!-- Populated dynamically via testDataEngineerConnections() -->
            </div>
        </div>
    </div>

    <!-- SUB-TAB 3: SQL & PYTHON WORKSPACES -->
    <div id="deSubTabWorkspaces" style="display:none;">
        <div class="panel-card" style="margin-bottom:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:13px; font-weight:700; color:#38BDF8;">&#128187; Interactive Data Engineering SQL &amp; Python Workspace</span>
                <div style="display:flex; gap:6px;">
                    <button type="button" class="btn btn-secondary" onclick="loadSampleDeSql('recon')" style="font-size:10px; padding:3px 8px;">Recon Query</button>
                    <button type="button" class="btn btn-secondary" onclick="loadSampleDeSql('dedup')" style="font-size:10px; padding:3px 8px;">AST Deduplication</button>
                    <button type="button" class="btn btn-secondary" onclick="loadSampleDeSql('star')" style="font-size:10px; padding:3px 8px;">Star Schema</button>
                </div>
            </div>
            <textarea class="studio-input" id="deSqlWorkspaceInput" rows="5" placeholder="-- Write SQL or Python ETL snippet here...
SELECT customer_id, count(*), sum(amount) 
FROM data_engineer_records 
GROUP BY customer_id HAVING count(*) > 1;"></textarea>
            <div class="btn-row">
                <button type="button" class="btn btn-primary" onclick="executeDeSqlQuery()">&#9654; Execute Query</button>
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('deSqlWorkspaceInput').value=''">Clear</button>
            </div>
            <div class="viewer-box" id="deSqlOutputBox" style="margin-top:10px; max-height:200px;">Results will appear here upon execution.</div>
        </div>
    </div>

    <!-- SUB-TAB 4: REAL-TIME FOLDER INGESTION -->
    <div id="deSubTabIngestion" style="display:none;">
        <div class="panel-card">
            <span style="font-size:13px; font-weight:700; color:#10B981; text-transform:uppercase;">&#128194; Real-Time Folder Ingestion &amp; Live Warehouse Load</span>
            <label class="input-label" style="margin-top:8px;">Directory Path to Scan (.xlsx, .csv, .tsv, .txt):</label>
            <div style="display:flex; gap:8px; margin-bottom:10px;">
                <input type="text" class="studio-input" id="folderIngestPath" value="data_ingestion" style="flex:1;" />
                <button type="button" class="btn btn-primary" onclick="runFolderIngestion()">&#9889; Run Batch Ingestion Now</button>
            </div>
            <div class="btn-row">
                <button type="button" class="btn btn-secondary" onclick="generateT1Report()">&#128196; Generate T-1 Report (Email &amp; Telegram)</button>
                <button type="button" class="btn btn-secondary" onclick="discoverDBSchema('sqlite')">&#128269; Ingested Table Schema</button>
            </div>
            <div class="viewer-box" id="dataEngineerOutput" style="margin-top:10px;">Ingestion Engine Ready. Click [Run Batch Ingestion Now] to scan files.</div>
        </div>
    </div>
</div>

