                            <span class="conn-status-dot"></span>
                        </div>
                        <div class="conn-node-meta">Verified no-credit-card free developer tiers (Gemini Flash, Open-Meteo, Public APIs).</div>
                        <button type="button" class="btn btn-secondary" style="margin-top:10px; width:100%; font-size:11px; padding:6px 0;">&#128273; Send Free APIs</button>
                    </div>

                    <div class="conn-node-card" style="cursor:pointer;" onclick="dispatchTgBroadcast('tech')">
