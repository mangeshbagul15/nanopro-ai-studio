    <!-- 2. MAIN CENTER CONTENT PANELS -->
    <div id="main-panel" class="app-main-panel">
        <!-- GLOBAL STICKY HEADER -->
        <header class="global-header workspace-topbar">
            <!-- Left Group: Sidebar Toggle & Breadcrumbs -->
            <div class="header-left-group">
                <button type="button" class="header-btn btn-icon-only" id="sidebarToggleBtn" onclick="toggleSidebarCollapse()" title="Toggle Sidebar (Ctrl+B)">
                    &#9776;
                </button>
                <div style="display:flex; gap:4px;">
                    <button type="button" class="header-btn btn-icon-only" onclick="navigateHistory(-1)" id="btnNavBack" title="Back" disabled>&#8592;</button>
                    <button type="button" class="header-btn btn-icon-only" onclick="navigateHistory(1)" id="btnNavForward" title="Forward" disabled>&#8594;</button>
                </div>
                <div class="header-breadcrumbs">
                    <span class="crumb-root">NanoPro</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-active" id="breadcrumbCurrent">AI Manager</span>
                    <span id="topbarModeBadge" class="badge badge-primary" style="margin-left:6px; font-size:10px;">AI MANAGER</span>
                </div>
                <!-- Hidden Topbar Title for Legacy JS Selectors -->
                <h1 id="topbarTitle" style="display:none;">AI MANAGER</h1>
            </div>

            <!-- Center Group: Command Palette Search Box -->
            <div class="header-center-group">
                <div class="header-search-box" onclick="openCommandPalette()" title="Press Ctrl+K to search all views &amp; actions">
                    <span class="header-search-icon">&#128269;</span>
                    <input type="text" class="header-search-input" placeholder="Search views, models, tools... (Ctrl+K)" readonly />
                    <span class="header-search-kbd">Ctrl+K</span>
                </div>
            </div>

            <!-- Right Group: Status, AI Manager Orb, Badges, Theme & Telemetry Toggles -->
            <div class="header-right-group">
                <!-- AI Manager Symbol / Status Orb -->
                <div id="aiManagerSymbolWrapper" class="ai-manager-symbol-container state-ready" onclick="toggleVoiceOrManagerPrompt()" title="AI Manager — Click to Speak or Activate" style="cursor:pointer; display:flex; align-items:center; gap:6px; padding:4px 8px; border-radius:20px; background:var(--bg-panel); border:1px solid var(--border);">
                    <div class="manager-core-orb" id="managerCoreOrb" style="width:22px; height:22px;">
                        <div class="orb-inner"></div>
                        <div class="orb-ring ring-1"></div>
                        <div class="orb-ring ring-2"></div>
                        <div class="orb-status-glow" id="orbStatusGlow"></div>
                    </div>
                    <div class="manager-symbol-label" style="display:flex; flex-direction:column;">
                        <span class="symbol-name" style="font-size:10px; font-weight:800; color:var(--text-main);">AI MANAGER</span>
                        <span class="symbol-state" id="managerStateText" style="font-size:8.5px; color:var(--accent-blue);">READY</span>
                    </div>
                </div>

                <!-- Live Studio Online Pill -->
                <span class="badge badge-success" id="studioStatusPill">&#9679; Online</span>

                <!-- Quick Approvals Queue Button -->
                <button type="button" class="header-btn" onclick="switchView('approvals')" title="Action Approvals Queue">
                    <span>&#128737;</span>
                    <span class="header-badge" id="headerApprovalBadge">0</span>
                </button>

                <!-- System Notifications Button -->
                <button type="button" class="header-btn" onclick="switchView('logs')" title="System Notifications & Alerts">
                    <span>&#128276;</span>
                    <span class="header-badge" id="topbarNotifBadge" style="background:#10B981;">LIVE</span>
                </button>

                <!-- Theme Toggle Button (Dark / Light) -->
                <button type="button" class="header-btn btn-icon-only" id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Dark / Light Theme">
                    <span id="themeToggleIcon">&#9790;</span>
                </button>

                <!-- Telemetry & Logs Toggle Button -->
                <button type="button" class="header-btn" id="telemetryToggleBtn" onclick="toggleTelemetry()" title="Toggle Real-Time Telemetry &amp; Logs Panel">
                    <span>&#128202; Telemetry</span>
                </button>

                <!-- Refresh Button -->
                <button type="button" class="header-btn btn-icon-only" onclick="reloadActiveView()" title="Refresh workspace data">&#8635;</button>
            </div>
        </header>

