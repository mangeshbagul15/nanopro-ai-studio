function navigateHistory(direction) {
            if (direction === -1 && historyIndex > 0) {
                historyIndex--;
                isNavigatingHistory = true;
                const view = navigationHistory[historyIndex];
                switchView(view, true);
                isNavigatingHistory = false;
                window.history.replaceState({ view: view }, '', '#' + view);
            } else if (direction === 1 && historyIndex < navigationHistory.length - 1) {
                historyIndex++;
                isNavigatingHistory = true;
                const view = navigationHistory[historyIndex];
                switchView(view, true);
                isNavigatingHistory = false;
                window.history.replaceState({ view: view }, '', '#' + view);
            }
            updateHistoryButtons();
        }

        function updateHistoryButtons() {
            const btnBack = document.getElementById('btnNavBack');
            const btnFwd = document.getElementById('btnNavForward') || document.getElementById('btnNavForward');
            if (btnBack) btnBack.disabled = (historyIndex <= 0);
            if (btnFwd) btnFwd.disabled = (historyIndex >= navigationHistory.length - 1);
            const currentTitle = document.getElementById('topbarTitle') ? document.getElementById('topbarTitle').innerText : currentActiveView;
            const bcEl = document.getElementById('breadcrumbCurrent');
            if (bcEl) bcEl.innerText = currentTitle;
        }

        window.addEventListener('popstate', (e) => {
            if (e.state && e.state.view) {
                isNavigatingHistory = true;
                switchView(e.state.view, true);
                const idx = navigationHistory.lastIndexOf(e.state.view);
                if (idx !== -1) historyIndex = idx;
                isNavigatingHistory = false;
                updateHistoryButtons();
            }
        });

        function reloadActiveView() {
            logLocal('Navigation', 'Reloading active view: ' + currentActiveView);
            switchView(currentActiveView, true);
        }

        /* SVG Robot Generator */
        function getRobotSVG(status) {
            return `
            <svg width="70" height="80" viewBox="0 0 70 80" class="robot-figure">
                <circle cx="35" cy="10" r="4" class="robot-antenna-bulb" fill="#38BDF8"/>
                <line x1="35" y1="10" x2="35" y2="20" stroke="#818CF8" stroke-width="2"/>
                <rect x="18" y="20" width="34" height="22" rx="6" fill="#1E293B" stroke="#38BDF8" stroke-width="2"/>
                <rect x="24" y="25" width="22" height="10" rx="3" class="robot-visor" fill="#0284C7"/>
                <rect x="16" y="46" width="38" height="24" rx="4" fill="#0F172A" stroke="#475569" stroke-width="2"/>
                <rect x="22" y="50" width="26" height="14" rx="2" fill="#020617" stroke="#38BDF8" stroke-width="1"/>
                <line x1="12" y1="50" x2="24" y2="64" class="robot-arm robot-arm-left" stroke="#818CF8" stroke-width="3" stroke-linecap="round"/>
                <line x1="58" y1="50" x2="46" y2="64" class="robot-arm robot-arm-right" stroke="#818CF8" stroke-width="3" stroke-linecap="round"/>
                <line x1="26" y1="70" x2="26" y2="78" class="robot-leg robot-leg-left" stroke="#64748B" stroke-width="3" stroke-linecap="round"/>
                <line x1="44" y1="70" x2="44" y2="78" class="robot-leg robot-leg-right" stroke="#64748B" stroke-width="3" stroke-linecap="round"/>
            </svg>`;
        }

        function renderOfficeStations(containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = '';
            AGENT_LIST.forEach(ag => {
                const div = document.createElement('div');
                div.className = 'robot-station idle';
                div.id = containerId + '-' + ag.id;
                div.onclick = () => { logLocal('Office', 'Clicked robot: ' + ag.name); };
                div.innerHTML = `
                    ${getRobotSVG('idle')}
                    <div class="station-desk"></div>
                    <div class="station-name">${ag.name}</div>
                    <div class="station-badge" id="badge-${containerId}-${ag.id}">Idle</div>
                `;
                container.appendChild(div);
            });
        }

        function updateRobotStates(agentStates) {
            if (!agentStates) return;
            ['dashOfficeFloor', 'officeFloorFull'].forEach(cId => {
                for (const [agId, st] of Object.entries(agentStates)) {
                    const el = document.getElementById(cId + '-' + agId);
                    const badge = document.getElementById('badge-' + cId + '-' + agId);
                    if (el && badge) {
                        el.classList.remove('idle', 'working', 'walking');
                        badge.classList.remove('active-work');
                        if (st.status === 'working' || st.status === 'running') {
                            el.classList.add('working');
                            badge.classList.add('active-work');
                            badge.innerText = 'Typing / Working';
                        } else if (st.status === 'queued') {
                            el.classList.add('walking');
                            badge.innerText = 'Travelling';
                        } else {
                            el.classList.add('idle');
                            badge.innerText = 'Idle';
                        }
                    }
                }
            });
        }

        /* Audio Handling */
        function toggleAudio(mode) {
            audioStates[mode] = !audioStates[mode];
            const btn = document.getElementById(mode + 'AudioToggle');
            if (btn) {
                btn.innerText = audioStates[mode] ? "Audio: ON" : "Audio: OFF";
                btn.classList.toggle('btn-success', audioStates[mode]);
                btn.classList.toggle('btn-secondary', !audioStates[mode]);
            }
            logLocal('Audio', `${mode.toUpperCase()} audio toggled: ${audioStates[mode] ? 'ON' : 'OFF'}`);
        }

        function handleAudioFileSelect(mode, inputEl) {
            if (inputEl.files && inputEl.files[0]) {
                const file = inputEl.files[0];
                const pathInput = document.getElementById(mode + 'AudioPath');
                pathInput.value = file.name;
                audioStates[mode] = true;
                const btn = document.getElementById(mode + 'AudioToggle');
                if (btn) {
                    btn.innerText = "Audio: ON";
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-secondary');
                }
                logLocal('Audio', `Selected local audio file: ${file.name}`);
                document.getElementById(mode + 'AudioDurDisplay').innerText = `Audio Selected: ${file.name}`;
            }
        }

        async function probeAudio(mode) {
            const p = document.getElementById(mode + 'AudioPath').value.trim();
            if (!p) { alert('Please select or specify a local audio file path.'); return; }
            logLocal('Audio', `Probing audio duration for: ${p}`);
            try {
                const res = await fetch('/api/audio/probe', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ path: p })
                });
                const d = await res.json();
                if (d.duration !== undefined) {
                    document.getElementById(mode + 'AudioDurDisplay').innerText = `Duration: ${d.duration.toFixed(1)}s`;
                    alert(`Audio file probed successfully!\nDuration: ${d.duration.toFixed(1)} seconds`);
                } else {
                    alert('Probe Error: ' + (d.error || 'Failed to probe file'));
                }
            } catch (e) {
                alert('Probe Exception: ' + e.message);
            }
        }

        /* Video Generation */
        async function generateVideo(mode) {
            const q = document.getElementById(mode + 'Question').value.trim();
            const l = document.getElementById(mode + 'QueryLogic').value.trim();
            const outEl = document.getElementById(mode + 'Output');
            const audioP = document.getElementById(mode + 'AudioPath').value.trim();
            const vol = parseFloat(document.getElementById(mode + 'AudioVol').value);

            if (!q && !l) { alert('Please provide a question or code logic.'); return; }
            outEl.innerText = `Starting ${mode.toUpperCase()} video creation pipeline...\nDispatched to background queue.`;
            logLocal('VideoMaker', `Initiated ${mode.toUpperCase()} video generation: ${q.substring(0, 40)}`);

            try {
                const res = await fetch('/api/prompt', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        prompt: q,
                        query_logic: l,
                        mode: mode + '_video',
                        enable_audio: audioStates[mode],
                        audio_path: audioP,
                        audio_volume: vol
                    })
                });
                const data = await res.json();
                if (data.job_id) {
                    pollJob(data.job_id, outEl);
                } else {
                    outEl.innerText = 'Error: ' + JSON.stringify(data);
                }
            } catch (e) {
                outEl.innerText = 'Network Error: ' + e.message;
            }
        }

        function pollJob(jobId, outEl) {
            const timer = setInterval(async () => {
                try {
                    const res = await fetch('/api/job/' + jobId);
                    const job = await res.json();
                    if (job.status === 'done') {
                        clearInterval(timer);
                        outEl.innerText = JSON.stringify(job.result_data, null, 2);
                        logLocal('TaskManager', `Job ${jobId} finished successfully.`);
                    } else if (job.status === 'error') {
                        clearInterval(timer);
                        outEl.innerText = 'Task Failed: ' + job.error_message;
                        logLocal('TaskManager', `Job ${jobId} failed: ${job.error_message}`);
                    } else {
                        outEl.innerText = `Status: ${job.status.toUpperCase()} | Stage: ${job.stage} (${job.progress}%)\nTask: ${job.prompt}`;
                    }
                } catch (e) {}
            }, 800);
        }

        async function generateThumbnailMeta(mode) {
            const q = document.getElementById(mode + 'Question').value.trim();
            const l = document.getElementById(mode + 'QueryLogic').value.trim();
            const outEl = document.getElementById(mode + 'Output');
            outEl.innerText = `Generating 9:16 PNG thumbnail for ${mode.toUpperCase()}...`;
            logLocal('ImageAgent', `Creating 9:16 thumbnail for ${mode}`);
            const res = await fetch('/api/thumbnail', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ question: q, query_logic: l, mode: mode })
            });
            const data = await res.json();
            outEl.innerText = JSON.stringify(data, null, 2);
        }

        async function generateMeta(mode, kind) {
            const q = document.getElementById(mode + 'Question').value.trim();
            const l = document.getElementById(mode + 'QueryLogic').value.trim();
            const outEl = document.getElementById(mode + 'Output');
            outEl.innerText = `Generating YouTube ${kind}...`;
            logLocal('VideoMaker', `Generating YouTube ${kind} for ${mode}`);
            const res = await fetch('/api/metadata', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ question: q, query_logic: l, mode: mode, kind: kind })
            });
            const data = await res.json();
            outEl.innerText = data.text || JSON.stringify(data);
        }

        /* Image Maker */
        async function generateStudioImage() {
            const prompt = document.getElementById('imgPrompt').value.trim();
            const style = document.getElementById('imgStyle').value;
            const ratio = document.getElementById('imgRatio').value;
            const outEl = document.getElementById('imgOutput');
            if (!prompt) { alert('Please enter an image prompt.'); return; }
            const [w, h] = ratio.split('x').map(Number);
            outEl.innerText = 'Rendering graphic card...';
            logLocal('ImageAgent', `Generating image: ${prompt.substring(0, 40)}`);
            const res = await fetch('/api/image/generate', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ prompt, style, width: w, height: h })
            });
            const d = await res.json();
            outEl.innerText = JSON.stringify(d, null, 2);
        }

        /* Coding Agent */
        async function executeCodingAction(action) {
            const p = document.getElementById('codingPrompt').value.trim();
            const code = document.getElementById('codingSource').value.trim();
            const lang = document.getElementById('codingLang').value;
            const model = document.getElementById('codingModel').value;
            const outEl = document.getElementById('codingOutput');
            if (!p && !code) { alert('Please enter instructions or source code.'); return; }
            outEl.innerText = `Executing [${action.toUpperCase()}] via model [${model}]...`;
            logLocal('CodingAgent', `Action: ${action} (${lang}) via ${model}`);
            try {
                const res = await fetch('/api/coding/execute', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ prompt: p, code: code, action: action, language: lang, model: model })
                });
                const d = await res.json();
                outEl.innerText = d.result || JSON.stringify(d, null, 2);
            } catch (e) {
                outEl.innerText = 'Coding Error: ' + e.message;
            }
        }
        /* Autonomous Code Architect & Prompt-to-Code Engine */
        async function applyCodeModificationPrompt() {
            const file = document.getElementById('codeModCustomPath').value.trim() || document.getElementById('codeModTargetFile').value;
            const instruction = document.getElementById('codeModInstruction').value.trim();
            const outEl = document.getElementById('codeModDiffOutput');
            if (!instruction) {
                alert('Please enter a natural language modification instruction.');
                return;
            }
            outEl.innerText = `[Code Architect] Processing logic changes for '${file}'...\nParsing prompt: "${instruction}"\nSynthesizing AST-safe modifications...`;
            logLocal('CodeArchitect', `Applying logic modification on ${file}`);
            try {
                const res = await fetch('/api/code/modify-by-prompt', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ instruction: instruction, file_path: file })
                });
                const d = await res.json();
                if (d.success) {
                    outEl.innerText = `=== CODE MODIFICATION APPLIED SUCCESSFULLY ===\nAction: ${d.action}\nTarget File: ${d.file}\nBackup File: ${d.backup}\nAST Syntax Valid: ${d.syntax_valid}\nDiff Summary:\n${d.diff || 'No textual diff available'}`;
                } else {
                    outEl.innerText = `=== MODIFICATION FAILED ===\nError: ${d.error || d.message || JSON.stringify(d, null, 2)}`;
                }
            } catch (e) {
                outEl.innerText = 'Code Architect Error: ' + e.message;
            }
        }

        async function analyzeTargetFile() {
            const file = document.getElementById('codeModCustomPath').value.trim() || document.getElementById('codeModTargetFile').value;
            const outEl = document.getElementById('codeModDiffOutput');
            outEl.innerText = `[Code Architect] Analyzing file AST: ${file}...`;
            try {
                const res = await fetch('/api/code/analyze-file', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ file_path: file })
                });
                const d = await res.json();
                outEl.innerText = `=== AST ANALYSIS FOR: ${file} ===\nValid Syntax: ${d.valid_syntax}\nLines of Code: ${d.lines_of_code}\nFunctions Detected: ${(d.functions || []).join(', ')}\nClasses Detected: ${(d.classes || []).join(', ')}\nImports: ${(d.imports || []).slice(0, 15).join(', ')}`;
            } catch (e) {
                outEl.innerText = 'AST Analysis Error: ' + e.message;
            }
        }

        async function fetchCodeBackups() {
            const outEl = document.getElementById('codeModDiffOutput');
            outEl.innerText = `[Code Architect] Fetching code backups...`;
            try {
                const res = await fetch('/api/code/backups');
                const d = await res.json();
                if (d.backups && d.backups.length > 0) {
                    let text = `=== CODE ARCHITECT BACKUPS (${d.backups.length}) ===\n`;
                    d.backups.forEach((b, i) => {
                        text += `[${i+1}] ${(b.filename || b.backup_filename)} (${b.size_kb} KB) - ${b.created_at}\n    Original: ${b.original_file}\n`;
                    });
                    outEl.innerText = text;
                } else {
                    outEl.innerText = 'No backups recorded yet in app/coding_agent/backups/.';
                }
            } catch (e) {
                outEl.innerText = 'Fetch Backups Error: ' + e.message;
            }
        }

        async function rollbackCodeBackup() {
            const outEl = document.getElementById('codeModDiffOutput');
            outEl.innerText = `[Code Architect] Initiating rollback...`;
            try {
                const res = await fetch('/api/code/restore-backup', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({})
                });
                const d = await res.json();
                if (d.success) {
                    outEl.innerText = `=== ROLLBACK SUCCESSFUL ===\nRestored: ${d.target_file}\nFrom Backup: ${d.restored_from}\nStatus: ${d.message}`;
                } else {
                    outEl.innerText = `Rollback Failed: ${d.error || d.message}`;
                }
            } catch (e) {
                outEl.innerText = 'Rollback Error: ' + e.message;
            }
        }


        /* Research Agent */
        async function executeResearch() {
            const q = document.getElementById('researchQuery').value.trim();
            const outEl = document.getElementById('researchOutput');
            if (!q) { alert('Please enter a research topic.'); return; }
            outEl.innerText = 'Conducting research and synthesizing knowledge...';
            logLocal('ResearchAgent', `Querying research: ${q.substring(0, 40)}`);
            try {
                const res = await fetch('/api/research/query', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ query: q })
                });
                const d = await res.json();
                outEl.innerText = d.summary || JSON.stringify(d, null, 2);
            } catch (e) {
                outEl.innerText = 'Research Error: ' + e.message;
            }
        }

