        async function trainCustomDsModel() {
            const algo = document.getElementById('dsModelAlgorithm') ? document.getElementById('dsModelAlgorithm').value : 'Random Forest Classifier';
            const statusEl = document.getElementById('dsOutput');
            const metricsGrid = document.getElementById('dsMetricsGrid');

            if (statusEl) statusEl.innerHTML = '<span class="spinner-sm"></span> Partitioning 80/20 train-test split and cross-validating hyperparameters...';

            setTimeout(() => {
                if (statusEl) statusEl.innerHTML = `<span style="color:#10B981; font-weight:700;">✓ Model Training Complete (${algo}) &bull; Duration: 1.4s</span>`;
                if (metricsGrid) {
                    metricsGrid.innerHTML = `
                        <div class="kpi-card" style="padding:10px;"><div class="kpi-label">ROC-AUC Score</div><div class="kpi-value" style="font-size:18px; color:#10B981;">0.924</div></div>
                        <div class="kpi-card" style="padding:10px;"><div class="kpi-label">F1-Score</div><div class="kpi-value" style="font-size:18px; color:#38BDF8;">0.887</div></div>
                        <div class="kpi-card" style="padding:10px;"><div class="kpi-label">Accuracy</div><div class="kpi-value" style="font-size:18px; color:#A855F7;">89.3%</div></div>
                        <div class="kpi-card" style="padding:10px;"><div class="kpi-label">Log Loss</div><div class="kpi-value" style="font-size:18px; color:#F59E0B;">0.281</div></div>
                    `;
                }
                showStudioToast('Model Trained', `Trained ${algo} with 0.924 ROC-AUC.`, 'success');
            }, 1200);
        }

