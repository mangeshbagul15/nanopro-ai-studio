                                    <td style="padding:6px;"><span style="font-weight:700; color:${l.channel === 'email' ? '#F59E0B' : '#38BDF8'};">${l.channel.toUpperCase()}</span></td>
                                    <td style="padding:6px; color:#E2E8F0;">${l.recipient}</td>
