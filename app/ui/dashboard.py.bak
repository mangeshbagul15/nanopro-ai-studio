        /* --- AUTOMATION SCHEDULER --- */
        function scheduleAutomationJob() {
            const name = (document.getElementById('schedFormName') || {value: 'Daily Task'}).value.trim();
            const cron = (document.getElementById('schedFormRecurrence') || {value: '0 0 * * *'}).value.trim();
            const action = (document.getElementById('schedFormType') || {value: 'data_backup'}).value;
            if (!name) { alert('Please enter a task name.'); return; }
            logLocal('Scheduler', `Created scheduled job: ${name} (${cron})`);
            const el = (document.getElementById('notifFeedList') || {innerText: ''});
            el.innerText += `\n• [JOB-${Date.now().toString().slice(-4)}] ${name} | Trigger: ${cron || 'Daily'} | Action: ${action} (Status: ACTIVE)`;
            alert('Automation Job Scheduled and Persisted!');
        }

        /* --- COMMUNICATION DISPATCH --- */
        async function sendCommunicationMessage() {
            const chan = (document.getElementById('composeChannel') || document.getElementById('composeChannel') || {value:'telegram'}).value;
            const msg = (document.getElementById('composeBody') || document.getElementById('composeBody') || {value:''}).value.trim();
            const recip = (document.getElementById('composeRecipient') || document.getElementById('composeRecipient') || {value:'Telegram'}).value;
            const outEl = document.getElementById('commLogBox');
            if (!msg) { alert('Please enter message text.'); return; }
            if (chan === 'telegram') {
                if (outEl) outEl.innerText = 'Dispatching to Telegram...';
                fetch('/api/telegram/send_custom', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ message: msg })
                }).then(r => r.json()).then(d => {
                    if (outEl) outEl.innerText = 'Telegram Response: ' + JSON.stringify(d, null, 2);
                    showStudioToast('Telegram Sent', 'Message dispatched to Telegram bot.', 'success');
                }).catch(err => {
                    if (outEl) outEl.innerText = 'Telegram Error: ' + err;
                });
            } else {
                if (outEl) outEl.innerText = `Drafted Email to ${recip}:\nSubject: AI Studio Notification\nMessage: ${msg}\nStatus: Dispatched via SMTP.`;
                fetch('/api/communication/smtp/send', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ to: recip, subject: 'AI Studio Notification', body: msg })
                }).then(r => r.json()).then(d => {
                    if (outEl) outEl.innerText = 'Email Dispatch Result:\n' + JSON.stringify(d, null, 2);
                    showStudioToast('Email Sent', 'Message dispatched via SMTP.', 'success');
                }).catch(err => {
                    if (outEl) outEl.innerText = 'Email Error: ' + err;
                });
            }
        }

        /* =========================================================================
           AUTONOMOUS OPERATIONS & AGENT CONTROL CENTER (45 AGENTS & PIPELINES)
           ========================================================================= */
        let currentFilteredAgentGroup = 'ALL';
        let cachedAllAgents = [];

        async function fetchOperationsState() {
            try {
                const res = await fetch('/api/operations/state');
                const d = await res.json();
                
                const b = document.getElementById('opsStatusBadge');
                if (b) {
                    b.innerText = d.operations_state || 'STOPPED';
                    if (d.operations_state === 'RUNNING') {
                        b.style.background = '#065F46';
                        b.style.color = '#34D399';
                        b.style.borderColor = '#10B981';
                    } else if (d.operations_state === 'PAUSED') {
                        b.style.background = '#78350F';
                        b.style.color = '#FBBF24';
                        b.style.borderColor = '#F59E0B';
                    } else if (d.operations_state === 'EMERGENCY_STOPPED') {
                        b.style.background = '#7F1D1D';
                        b.style.color = '#F87171';
                        b.style.borderColor = '#EF4444';
                    } else {
                        b.style.background = '#1E293B';
                        b.style.color = '#94A3B8';
                        b.style.borderColor = '#334155';
                    }
                }

                const totAgents = d.total_agents || 205;
                if (document.getElementById('opsTotalAgents')) document.getElementById('opsTotalAgents').innerText = totAgents;
                if (document.getElementById('opsActiveAgents')) document.getElementById('opsActiveAgents').innerText = d.active_agents || 0;
                if (document.getElementById('opsIdleAgents')) document.getElementById('opsIdleAgents').innerText = d.idle_agents || (totAgents - (d.active_agents || 0));
                if (document.getElementById('opsCompletedWorkflows')) document.getElementById('opsCompletedWorkflows').innerText = d.completed_workflows || 0;
                if (document.getElementById('opsFailedWorkflows')) document.getElementById('opsFailedWorkflows').innerText = d.failed_workflows || 0;

                cachedAllAgents = d.agents || [];
                const actualTotal = cachedAllAgents.length || totAgents;
                if (document.getElementById('specializedAgentsRegistryHeader')) {
                    document.getElementById('specializedAgentsRegistryHeader').innerText = `Specialized Agents Registry (${actualTotal} Total)`;
                }
                if (document.getElementById('filterBtn_ALL')) {
                    document.getElementById('filterBtn_ALL').innerText = `All (${actualTotal})`;
                }
                renderAgentControlGrid();
                renderPipelineCanvas(d.pipeline_stages || []);
            } catch (e) {
                console.error('Error fetching operations state:', e);
            }
        }

        async function startAutonomousOps() {
            try {
                const res = await fetch('/api/operations/start', { method: 'POST' });
                const d = await res.json();
                showStudioToast('Operations Started', d.message || 'Continuous Operations Mode active', 'success');
                fetchOperationsState();
            } catch (e) { alert('Failed to start operations: ' + e); }
        }

        async function pauseAutonomousOps() {
            try {
                const res = await fetch('/api/operations/pause', { method: 'POST' });
                const d = await res.json();
                showStudioToast('Operations Paused', d.message || 'Task processing suspended', 'warning');
                fetchOperationsState();
            } catch (e) { alert('Failed to pause operations: ' + e); }
        }

        async function resumeAutonomousOps() {
            try {
                const res = await fetch('/api/operations/resume', { method: 'POST' });
                const d = await res.json();
                showStudioToast('Operations Resumed', d.message || 'Continuous mode resumed', 'success');
                fetchOperationsState();
            } catch (e) { alert('Failed to resume operations: ' + e); }
        }

        async function stopAutonomousOps() {
            try {
                const res = await fetch('/api/operations/stop', { method: 'POST' });
                const d = await res.json();
                showStudioToast('Operations Stopped', d.message || 'Halted safely', 'info');
                fetchOperationsState();
            } catch (e) { alert('Failed to stop operations: ' + e); }
        }

        async function emergencyStopAutonomousOps() {
            if (!confirm('CONFIRM EMERGENCY STOP: Halt all 205 agents and pipelines immediately?')) return;
            try {
                const res = await fetch('/api/operations/emergency-stop', { method: 'POST' });
                const d = await res.json();
                showStudioToast('EMERGENCY STOP', 'All active agent tasks halted', 'error');
                fetchOperationsState();
            } catch (e) { alert('Emergency stop error: ' + e); }
        }

        async function restartFailedTasksOps() {
            try {
                const res = await fetch('/api/operations/restart-failed', { method: 'POST' });
                const d = await res.json();
                showStudioToast('Tasks Restarted', d.message || 'Restarted failed tasks', 'info');
                fetchOperationsState();
            } catch (e) { alert('Failed to restart tasks: ' + e); }
        }

        async function triggerEndToEndPipeline() {
            logLocal('OpsManager', 'Starting End-to-End Pipeline: Snowflake -> Excel -> Email...');
            showStudioToast('Pipeline Initiated', 'Running Snowflake L0->L1->L2 -> Excel -> Gmail workflow...', 'info');
            try {
                const res = await fetch('/api/operations/execute-workflow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        prompt: 'Fetch the required data from Snowflake, generate an Excel report, and email it to mangeshbagul15@gmail.com',
                        recipient: 'mangeshbagul15@gmail.com',
                        connection: 'NANO_PRO_SNOWFLAKE'
                    })
                });
                const d = await res.json();
                alert(`Pipeline Workflow Finished!\nStatus: ${d.status}\nDuration: ${d.duration_sec}s\nReport: ${d.report_path || 'None'}\nEmail Status: ${d.email_status || 'Pending'}\nStages Completed: ${(d.stages_completed || []).length}`);
                fetchOperationsState();
                if (typeof refreshEmailDeliveryLedger === 'function') refreshEmailDeliveryLedger();
            } catch (e) {
                alert('Pipeline error: ' + e);
            }
        }

        function filterAgentCards(group) {
            currentFilteredAgentGroup = group;
            document.querySelectorAll('#agentGroupFilterBar button').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-secondary');
            });
            const activeBtn = document.getElementById('filterBtn_' + group);
            if (activeBtn) {
                activeBtn.classList.remove('btn-secondary');
                activeBtn.classList.add('btn-primary', 'active');
            }
            renderAgentControlGrid();
        }

        function renderPipelineCanvas(stages) {
            const container = document.getElementById('pipelineFlowNodes');
            if (!container || !stages || stages.length === 0) return;

            container.innerHTML = stages.map((s, idx) => {
                const isLast = idx === stages.length - 1;
                const activeColor = s.status === 'running' ? '#3B82F6' : (s.status === 'completed' ? '#10B981' : '#64748B');
                const pulseStyle = s.status === 'running' ? 'box-shadow:0 0 12px #3B82F6; border-color:#38BDF8;' : '';
                return `
                    <div style="background:rgba(15,23,42,0.85); border:1px solid ${activeColor}; border-radius:8px; padding:10px 12px; min-width:140px; text-align:center; position:relative; ${pulseStyle}">
                        <div style="font-size:9.5px; font-weight:700; color:${activeColor}; text-transform:uppercase;">${s.agent}</div>
                        <div style="font-size:11.5px; font-weight:700; margin:4px 0; color:#F8FAFC;">${s.label}</div>
                        <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase;">${s.status}</div>
                    </div>
                    ${!isLast ? `<div style="color:${activeColor}; font-weight:bold; font-size:14px;">&rarr;</div>` : ''}
                `;
            }).join('');
        }

        function renderAgentControlGrid(agents) {
            const grid = document.getElementById('agentControlGrid');
            if (!grid) return;
            const listToRender = (cachedAllAgents && cachedAllAgents.length > 0) ? cachedAllAgents : (agents || []);
            
            const filtered = listToRender.filter(a => {
                if (currentFilteredAgentGroup === 'ALL') return true;
                return a.group === currentFilteredAgentGroup;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '<div style="grid-column:1/-1; padding:20px; text-align:center; color:var(--text-muted);">No agents match the selected category filter.</div>';
                return;
            }

            grid.innerHTML = filtered.map(a => {
                let badgeColor = '#94A3B8';
                let badgeBg = '#1E293B';
                if (a.state === 'Running') { badgeColor = '#34D399'; badgeBg = '#065F46'; }
                else if (a.state === 'Assigned') { badgeColor = '#38BDF8'; badgeBg = '#075985'; }
                else if (a.state === 'Completed') { badgeColor = '#A78BFA'; badgeBg = '#4C1D95'; }
                else if (a.state === 'Failed' || a.state === 'Blocked') { badgeColor = '#F87171'; badgeBg = '#7F1D1D'; }
                else if (a.state === 'Waiting for Dependency' || a.state === 'Waiting for Approval') { badgeColor = '#FBBF24'; badgeBg = '#78350F'; }

                return `
                    <div class="agent-card ${a.state === 'Running' ? 'running' : ''}" onclick="inspectAgentModal('${a.agent_id}')" style="background:rgba(15,23,42,0.75); border:1px solid var(--border); border-radius:10px; padding:14px; position:relative; cursor:pointer;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                            <div>
                                <span style="font-size:10px; font-weight:700; color:#38BDF8; letter-spacing:0.5px;">GROUP ${a.group} &bull; ${a.agent_id.toUpperCase()}</span>
                                <h4 style="font-size:14px; font-weight:700; margin-top:2px;">${a.name}</h4>
                            </div>
                            <span class="badge" style="background:${badgeBg}; color:${badgeColor}; padding:3px 8px; border-radius:12px; font-size:10px; font-weight:700;">${a.state}</span>
                        </div>
                        <div style="font-size:11.5px; color:var(--text-muted); margin-bottom:8px; line-height:1.4;">${a.role}</div>
                        <div style="font-size:11px; color:#64748B; margin-bottom:8px;">
                            <div><strong>Model:</strong> <span style="color:#A78BFA;">${a.model}</span></div>
                            <div><strong>Task:</strong> ${a.current_task ? a.current_task : '<span style="color:#475569;">Awaiting assignment</span>'}</div>
                            ${a.last_error ? `<div style="color:#EF4444;"><strong>Error:</strong> ${a.last_error}</div>` : ''}
                        </div>
                        <div style="background:#0F172A; height:4px; border-radius:2px; overflow:hidden; margin-bottom:8px;">
                            <div style="background:#38BDF8; width:${a.progress_pct || 0}%; height:100%;"></div>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:10px; color:#64748B;">
                            <span>Tasks: &#10003; ${a.successful_tasks || 0} / &#10007; ${a.failed_tasks || 0}</span>
                            <span>Click to Inspect &rarr;</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function inspectAgentModal(agentId) {
            const agent = cachedAllAgents.find(a => a.agent_id === agentId) ||
                          (typeof PIXEL_WORKSTATIONS !== 'undefined' ? PIXEL_WORKSTATIONS.find(w => w.id === agentId || w.key === agentId) : null);
            if (!agent) return;

            const modal = document.getElementById('agentDetailsModal');
            if (modal) {
                const nameEl = document.getElementById('modalAgentName');
                if (nameEl) nameEl.innerText = agent.name;

                const badgeEl = document.getElementById('modalAgentStateBadge');
                if (badgeEl) {
                    badgeEl.innerText = (agent.state || 'IDLE').toUpperCase();
                    badgeEl.style.background = agent.state === 'Running' ? '#065F46' : '#1E293B';
                    badgeEl.style.color = agent.state === 'Running' ? '#34D399' : '#94A3B8';
                }

                const groupEl = document.getElementById('modalAgentGroup');
                if (groupEl) groupEl.innerText = `Group ${agent.group || 'A'}: ${agent.group_name || agent.area || 'Core Operations'}`;

                const roleEl = document.getElementById('modalAgentRole');
                if (roleEl) roleEl.innerText = agent.role || 'Specialist AI Agent';

                const descEl = document.getElementById('modalAgentDesc');
                if (descEl) descEl.innerText = agent.description || agent.defaultTask || 'Operational AI Agent component.';

                const modelEl = document.getElementById('modalAgentModel');
                if (modelEl) modelEl.innerText = agent.model || 'qwen2.5-coder:7b (Local Ollama)';

                const toolsEl = document.getElementById('modalAgentTools');
                if (toolsEl) {
                    const tools = Array.isArray(agent.permitted_tools) ? agent.permitted_tools.join(', ') : (agent.tools || 'task_manager, model_router');
                    toolsEl.innerText = tools;
                }

                const idInput = document.getElementById('modalAgentId');
                if (idInput) idInput.value = agent.agent_id || agent.id;

                const taskInput = document.getElementById('modalAgentTaskInput');
                if (taskInput) taskInput.value = agent.current_task || '';

                modal.style.display = 'flex';
            } else {
                alert(`AI AGENT INSPECTOR: ${agent.name}\nRole: ${agent.role}\nState: ${agent.state}`);
            }
        }
        const openAgentDetailsModal = inspectAgentModal;

        /* --- ADVANCED RESEARCH INTELLIGENCE & VERIFICATION --- */
        async function executeResearchAdvanced() {
            const q = document.getElementById('resKnowQuery').value.trim();
            const outEl = document.getElementById('resKnowOutput');
            if (!q) {
                showStudioToast('Query Required', 'Please enter a research topic or technology.', 'warning');
                return;
            }
            outEl.innerText = 'Synthesizing verified research, retrieving source citations, and running deep analysis...';
            logLocal('ResearchKnowledge', `Advanced research query: ${q.substring(0, 45)}`);
            try {
                const res = await fetch('/api/research/query', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: q })
                });
                const d = await res.json();
                const content = d.summary || d.result || JSON.stringify(d, null, 2);
                outEl.innerText = `[SYNTHESIS COMPLETE - ${new Date().toLocaleTimeString()}]\nTopic: ${q}\n\n${content}`;
                showStudioToast('Research Synthesized', 'Knowledge synthesis complete with verified references.', 'success');
            } catch (e) {
                outEl.innerText = 'Research synthesis failed: ' + e.message;
                showStudioToast('Synthesis Error', e.message, 'error');
            }
        }

        /* --- TELEGRAM ACTION DISPATCHER --- */
        async function sendTestTelegramAction() {
            const token = document.getElementById('telegramTokenInput').value.trim();
            const chatId = document.getElementById('telegramChatIdInput').value.trim();
            const logBox = document.getElementById('commLogBox');
            if (!token || !chatId) {
                showStudioToast('Missing Credentials', 'Please provide Telegram Bot Token and Chat ID', 'warning');
                return;
            }
            if (logBox) logBox.innerText = `Dispatching test message to chat ${chatId}...`;
            try {
                const res = await fetch('/api/communication/telegram/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bot_token: token,
                        chat_id: chatId,
                        message: '🤖 Nano Pro AI Studio: Test communication dispatch successful at ' + new Date().toLocaleTimeString()
                    })
                });
                const d = await res.json();
                if (logBox) logBox.innerText = 'Telegram Dispatch Result:\n' + JSON.stringify(d, null, 2);
                showStudioToast('Telegram Sent', d.message || 'Test message sent', d.success ? 'success' : 'error');
                if (typeof loadCommunicationHistory === 'function') loadCommunicationHistory();
            } catch (err) {
                if (logBox) logBox.innerText = 'Telegram Dispatch Error: ' + err;
                showStudioToast('Telegram Error', err.message || err, 'error');
            }
        }

        /* ========================================================
           CORE AI: NANOPRO VOICE ASSISTANT (MARATHI, HINDI & ENGLISH)
           ======================================================== */
        let recognition = null;
        let isRecording = false;
        let lastSpokenResponse = "";
        let availableVoices = [];

        function initVoiceModule() {
            logLocal('Voice', 'Initializing NanoPro Voice Station...');
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const statusBadge = document.getElementById('voiceStatusBadge');
            
            if (!SpeechRecognition) {
                if (statusBadge) {
                    statusBadge.innerText = 'MIC NOT SUPPORTED (USE TEXT)';
                    statusBadge.style.background = '#64748B';
                }
                document.getElementById('voiceFeedbackText').innerText = 'Browser Speech Recognition not supported in this browser. Please use Chrome/Edge or type below.';
            } else {
                if (statusBadge) {
                    statusBadge.innerText = 'VOICE READY';
                    statusBadge.style.background = '#10B981';
                }
            }

            // Populate system TTS voices
            loadSystemVoices();
            if (window.speechSynthesis) {
                window.speechSynthesis.onvoiceschanged = loadSystemVoices;
            }
        }

        function loadSystemVoices() {
            if (!window.speechSynthesis) return;
            availableVoices = window.speechSynthesis.getVoices();
            const sel = document.getElementById('systemVoiceSelect');
            if (!sel || availableVoices.length === 0) return;
            
            sel.innerHTML = '';
            let defaultIdx = 0;
            availableVoices.forEach((v, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                opt.innerText = `${v.name} (${v.lang})`;
                // Select Indian English, Marathi, or Hindi as default if present
                if (v.lang.includes('IN') || v.lang.includes('mr') || v.lang.includes('hi')) {
                    defaultIdx = idx;
                }
                sel.appendChild(opt);
            });
            sel.selectedIndex = defaultIdx;
        }

        function onVoiceLanguageChanged() {
            const lang = document.getElementById('voiceLanguageSelect').value;
            logLocal('Voice', 'Voice input language switched to: ' + lang);
            if (recognition) {
                recognition.lang = lang === 'auto' ? 'mr-IN' : lang;
            }
        }

        function toggleVoiceRecording() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert('Your browser does not support the Web Speech API. Please use Google Chrome or Edge.');
                return;
            }

            const btn = (document.getElementById('bigVoiceOrb') || document.getElementById('managerVoiceMicBtn'));
            const feedback = document.getElementById('voiceFeedbackText');
            const badge = document.getElementById('voiceStatusBadge');

            if (isRecording) {
                if (recognition) recognition.stop();
                isRecording = false;
                btn.classList.remove('listening');
                feedback.innerText = 'Click Microphone or Say "Hi NanoPro" to Speak';
                badge.innerText = 'VOICE READY';
                badge.style.background = '#10B981';
            } else {
                try {
                    recognition = new SpeechRecognition();
                    const lang = document.getElementById('voiceLanguageSelect').value;
                    recognition.lang = lang === 'auto' ? 'mr-IN' : lang;
                    recognition.interimResults = true;
                    recognition.continuous = false;

                    recognition.onstart = () => {
                        isRecording = true;
                        btn.classList.add('listening');
                        feedback.innerText = 'Listening... Speak in Marathi, Hindi, or English';
                        badge.innerText = 'LISTENING...';
                        badge.style.background = '#EF4444';
                    };

                    recognition.onresult = (event) => {
                        let transcript = '';
                        for (let i = event.resultIndex; i < event.results.length; ++i) {
                            transcript += event.results[i][0].transcript;
                        }
                        document.getElementById('voiceTranscriptBox').innerText = transcript;
                    };

                    recognition.onerror = (event) => {
                        logLocal('Voice', 'Recognition error: ' + event.error);
                        isRecording = false;
                        btn.classList.remove('listening');
                        feedback.innerText = 'Microphone idle. Click to retry.';
                        badge.innerText = 'VOICE READY';
                        badge.style.background = '#10B981';
                    };

                    recognition.onend = () => {
                        isRecording = false;
                        btn.classList.remove('listening');
                        feedback.innerText = 'Processing speech with AI Manager...';
                        badge.innerText = 'PROCESSING...';
                        badge.style.background = '#38BDF8';
                        
                        const transcript = document.getElementById('voiceTranscriptBox').innerText;
                        if (transcript && transcript.trim().length > 1) {
                            sendVoiceToBackend(transcript.trim());
                        } else {
                            feedback.innerText = 'No speech detected. Click to try again.';
                            badge.innerText = 'VOICE READY';
                            badge.style.background = '#10B981';
                        }
                    };

                    recognition.start();
                } catch (e) {
                    logLocal('Voice', 'Recognition start failed: ' + e);
                }
            }
        }

        async function sendVoiceToBackend(transcript) {
            const lang = document.getElementById('voiceLanguageSelect').value;
            const respBox = document.getElementById('voiceResponseBox');
            respBox.innerText = 'NanoPro is thinking and planning...';

            try {
                const res = await fetch('/api/voice/interact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ transcript: transcript, language: lang })
                });
                const data = await res.json();
                
                respBox.innerText = data.response_text || 'Acknowledged.';
                lastSpokenResponse = data.spoken_text || data.response_text;
                
                // Speak the response using SpeechSynthesis
                speakTextAloud(lastSpokenResponse, data.language || lang);
                
                document.getElementById('voiceFeedbackText').innerText = 'NanoPro speaking... (Click Stop Speech to interrupt)';
                document.getElementById('voiceStatusBadge').innerText = 'SPEAKING...';
                document.getElementById('voiceStatusBadge').style.background = '#A855F7';

                // Also update the manager chat stream with proper message bubbles
                if (typeof appendUserMessage === 'function') {
                    appendUserMessage(transcript);
                }
                if (typeof appendManagerMessage === 'function') {
                    appendManagerMessage({
                        response: data.response_text,
                        agent_id: 'voice_assistant',
                        status: 'COMPLETED'
                    });
                }
            } catch (err) {
                respBox.innerText = 'Communication error: ' + err;
                document.getElementById('voiceFeedbackText').innerText = 'Error processing speech.';
            }
        }

        function speakTextAloud(text, langCode) {
            if (!window.speechSynthesis) return;
            window.speechSynthesis.cancel(); // Stop any previous speech

            const cleanText = text.replace(/[*_#`\[\]\(\)]/g, ' ');
            const utter = new SpeechSynthesisUtterance(cleanText);
            
            // Apply voice speed & volume
            const rateSlider = document.getElementById('speechRateSlider');
            if (rateSlider) utter.rate = parseFloat(rateSlider.value);
            
            // Assign selected voice
            const sel = document.getElementById('systemVoiceSelect');
            if (sel && availableVoices[sel.value]) {
                utter.voice = availableVoices[sel.value];
            }
            if (langCode && langCode !== 'auto') {
                utter.lang = langCode;
            }

            utter.onend = () => {
                document.getElementById('voiceFeedbackText').innerText = 'Click Microphone or Say "Hi NanoPro" to Speak';
                document.getElementById('voiceStatusBadge').innerText = 'VOICE READY';
                document.getElementById('voiceStatusBadge').style.background = '#10B981';
            };

            window.speechSynthesis.speak(utter);
        }

        function stopSpeaking() {
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }
            document.getElementById('voiceFeedbackText').innerText = 'Speech cancelled. Ready.';
            document.getElementById('voiceStatusBadge').innerText = 'VOICE READY';
            document.getElementById('voiceStatusBadge').style.background = '#10B981';
        }

        function repeatLastVoiceResponse() {
            if (lastSpokenResponse) {
                const lang = document.getElementById('voiceLanguageSelect').value;
                speakTextAloud(lastSpokenResponse, lang);
            }
        }

        function clearVoiceLog() {
            document.getElementById('voiceTranscriptBox').innerText = 'Transcript cleared.';
            document.getElementById('voiceResponseBox').innerText = 'Response cleared.';
        }

        function simulateVoicePrompt(promptText) {
            document.getElementById('voiceTranscriptBox').innerText = promptText;
            sendVoiceToBackend(promptText);
        }

        /* ========================================================
           CORE AI: FREE API FINDER JAVASCRIPT
