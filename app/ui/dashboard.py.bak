        let selectedPaletteIndex = 0;
        let filteredPaletteItems = [];

        function openCommandPalette() {
            const modal = document.getElementById('commandPaletteModal');
            if (!modal) return;
            modal.style.display = 'flex';
            const input = document.getElementById('commandPaletteInput');
            if (input) {
                input.value = '';
                input.focus();
            }
            filterCommandPalette('');
        }

        function closeCommandPalette() {
            const modal = document.getElementById('commandPaletteModal');
            if (modal) modal.style.display = 'none';
        }

        function filterCommandPalette(q) {
            const query = (q || '').toLowerCase().trim();
            filteredPaletteItems = allCommandPaletteItems.filter(item => 
                item.title.toLowerCase().includes(query) || 
                item.category.toLowerCase().includes(query) ||
                item.id.toLowerCase().includes(query)
            );
            selectedPaletteIndex = 0;
            renderCommandPaletteList();
        }

        function renderCommandPaletteList() {
            const list = document.getElementById('commandPaletteResults');
            if (!list) return;
            if (filteredPaletteItems.length === 0) {
                list.innerHTML = '<div style="padding:16px; text-align:center; color:var(--text-sub); font-size:12.5px;">No matching views or actions found.</div>';
                return;
            }
            list.innerHTML = filteredPaletteItems.map((item, idx) => `
                <div class="command-palette-item ${idx === selectedPaletteIndex ? 'selected' : ''}" onclick="selectPaletteItem('${item.id}')">
                    <span class="item-title"><span>${item.icon}</span> ${item.title}</span>
                    <span class="item-category">${item.category}</span>
                </div>
            `).join('');
        }

        function handleCommandPaletteKey(e) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (selectedPaletteIndex < filteredPaletteItems.length - 1) {
                    selectedPaletteIndex++;
                    renderCommandPaletteList();
                }
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (selectedPaletteIndex > 0) {
                    selectedPaletteIndex--;
                    renderCommandPaletteList();
                }
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (filteredPaletteItems[selectedPaletteIndex]) {
                    selectPaletteItem(filteredPaletteItems[selectedPaletteIndex].id);
                }
            } else if (e.key === 'Escape') {
                closeCommandPalette();
            }
        }

        function selectPaletteItem(viewId) {
            closeCommandPalette();
            switchView(viewId);
        }

        // Global Keyboard Shortcuts (Ctrl+K, Ctrl+B, Escape)
        window.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                openCommandPalette();
            }
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
                e.preventDefault();
                toggleSidebarCollapse();
            }
            if ((e.ctrlKey || e.metaKey) && e.key === '/') {
                e.preventDefault();
                const si = document.getElementById('sidebarSearchInput');
                if (si) si.focus();
            }
            if (e.key === 'Escape') {
                closeCommandPalette();
                if (typeof closeJobDetailModal === 'function') closeJobDetailModal();
            }
        });

        // Initialize Theme & Sidebar on Load
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(initPixelOffice, 100);
            initTheme();
            initSidebarState();
        });


