                    </div>
                </div>

                <div class="btn-row" style="margin-top:8px; margin-bottom:16px;">
                    <button type="button" class="btn btn-secondary" onclick="checkTgConnection()">&#128269; Check Telegram Bot Connection</button>
                    <button type="button" class="btn btn-secondary" onclick="toggleNotificationDrawer()">&#128276; View Notification Center Drawer</button>
                </div>

                <label class="input-label">Send Custom Formatted Telegram Message:</label>
                <textarea class="studio-input" id="tgCustomMsg" rows="3" placeholder="Enter custom message to broadcast directly to your Telegram channel..."></textarea>
                <div class="btn-row">
                    <button type="button" class="btn btn-success" onclick="sendTgCustom()">Send Message Directly</button>
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('tgCustomMsg').value=''">Clear</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>Telegram Broadcast Status &amp; Live API Response</h2>
                <div class="viewer-box" id="telegramOutput">Telegram status ready. Click any broadcast topic card above to dispatch immediately.</div>
            </div>
        </div>

                <!-- VIEW: TASKS & REMINDERS -->
        <div class="workspace-view" id="view-assistant">
            <div class="panel-card">
                <h2>Tasks &amp; Scheduled Reminders</h2>
