            const role = document.getElementById('docTargetRole').value.trim() || 'Data Engineer';
            const outEl = document.getElementById('docOutput');
            outEl.innerText = `Dear Hiring Team,\n\nI am writing to express my strong interest in the ${role} position. With a solid foundation in Python, data warehouse architecture, and multi-agent system automation, I specialize in delivering reliable data infrastructure that scales.\n\nSincerely,\nMangesh Bagul`;
