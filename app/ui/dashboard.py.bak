        /* Reminders */
        async function createReminder() {
            const title = document.getElementById('remTitle').value.trim();
            const due = document.getElementById('remDue').value.trim();
            const rec = document.getElementById('remRecurrence').value;
            if (!title || !due) { alert('Please provide title and due date/time.'); return; }
            logLocal('AssistantAgent', `Created reminder: ${title}`);
            await fetch('/api/reminders/create', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ title, due_time: due, recurrence: rec })
            });
            document.getElementById('remTitle').value = '';
            document.getElementById('remDue').value = '';
            loadReminders();
        }

        async function loadReminders() {
            const el = document.getElementById('remindersList');
            try {
                const res = await fetch('/api/reminders');
                const list = await res.json();
                if (list.length === 0) {
                    el.innerText = 'No pending reminders in SQLite.';
                } else {
                    el.innerText = list.map(r => `• [${r.id}] ${r.title} | Due: ${r.due_time} (Status: ${r.status})`).join('\n');
                }
            } catch (e) {
                el.innerText = 'Failed to load reminders: ' + e.message;
            }
        }

