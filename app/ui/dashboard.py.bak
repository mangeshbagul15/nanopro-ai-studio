        function switchCommTab(tabName) {
            ['Compose', 'Smtp', 'Telegram', 'History'].forEach(t => {
                const sub = document.getElementById('commSubTab' + t);
                const btn = document.getElementById('commTabBtn' + t);
                if (sub) sub.style.display = 'none';
                if (btn) {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-secondary');
                }
            });
            const cap = tabName.charAt(0).toUpperCase() + tabName.slice(1);
            const activeSub = document.getElementById('commSubTab' + cap);
            const activeBtn = document.getElementById('commTabBtn' + cap);
            if (activeSub) activeSub.style.display = 'block';
            if (activeBtn) {
                activeBtn.classList.add('btn-primary');
                activeBtn.classList.remove('btn-secondary');
            }
            if (tabName === 'history') loadCommunicationHistory();
            if (tabName === 'smtp') loadSmtpConfig();
        }

        function onComposeChannelChange() {
            const ch = document.getElementById('composeChannel').value;
            const subjRow = document.getElementById('emailSubjectRow');
            const recip = document.getElementById('composeRecipient');
            const lbl = document.getElementById('composeRecipientLabel');
            if (ch === 'email') {
                subjRow.style.display = 'block';
                lbl.innerText = 'Recipient Email';
