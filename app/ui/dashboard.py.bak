        /* --- TASK HISTORY --- */
        async function loadTaskHistory() {
            const el = document.getElementById('taskHistoryBox');
            if (!el) return;
            try {
                const res = await fetch('/api/stats');
                const d = await res.json();
                const res2 = await fetch('/api/memory/search?q=');
                const d2 = await res2.json();
                el.innerText = `TOTAL TASKS IN ARCHIVE: ${d.total_tasks}\nCOMPLETED: ${d.completed_tasks} | FAILED: ${d.failed_tasks}\n\n` +
                    JSON.stringify(d2.tasks || [], null, 2);
            } catch (e) {
                el.innerText = 'History error: ' + e.message;
            }
        }

        /* --- CYBERSECURITY LAB --- */
        function runCyberExercise(topic) {
            const outEl = document.getElementById('cyberScanOutput') || document.getElementById('cyberScanOutput');
            logLocal('CyberLab', 'Running exercise: ' + topic);
            if (topic === 'sql_injection') {
                outEl.innerText = `[CYBERSECURITY LAB: SQL INJECTION DEFENSE]\n\n` +
                    `1. Vulnerable Pattern:\n` +
                    `   query = f"SELECT * FROM users WHERE username = '{user_input}'"\n\n` +
                    `2. Defensive Implementation (Parameterized Queries / Prepared Statements):\n` +
                    `   cursor.execute("SELECT * FROM users WHERE username = ?", (user_input,))\n\n` +
                    `3. Verification Test:\n` +
                    `   Test Payload: ' OR '1'='1\n` +
                    `   Outcome: Neutralized safely as plain string literal. No unauthorized records leaked.`;
            } else if (topic === 'auth_hashing') {
                outEl.innerText = `[CYBERSECURITY LAB: SECURE PASSWORD STORAGE]\n\n` +
                    `1. Algorithm Requirement: Argon2id or Bcrypt with minimum cost factor of 12.\n` +
                    `2. Python Example:\n` +
                    `   import bcrypt\n` +
                    `   hashed = bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt(12))\n` +
                    `   is_valid = bcrypt.checkpw(entered.encode('utf-8'), hashed)\n\n` +
                    `3. Protection: Immune to rainbow tables and GPU brute-force parallel cracking.`;
            } else {
                outEl.innerText = `[CYBERSECURITY LAB: OWASP TOP 10 AUDIT]\n\n` +
                    `• A01: Broken Access Control -> Enforce least privilege, verify session authorization on each endpoint.\n` +
                    `• A02: Cryptographic Failures -> Never store plaintext passwords; use TLS 1.3 and Credentials Vault.\n` +
                    `• A03: Injection -> Enforce strict type validation & parameterized SQL.\n` +
                    `• A04: Insecure Design -> Require approval gate on high-impact administrative actions.`;
            }
        }

