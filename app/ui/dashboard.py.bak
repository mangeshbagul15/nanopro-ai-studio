            let targetHost = '192.168.31.240';

            if (connectionName === 'MY_ORACLE_XE_LOCAL') {
                btnId = 'btnTestOracleLocal';
                badgeId = 'badgeOracleLocalStatus';
                resultBoxId = 'oracleLocalTestResultBox';
                targetHost = '127.0.0.1';
            } else if (connectionName === 'MY_ORACLE_XE_REMOTE_New') {
                btnId = 'btnTestOracleTailscale';
                badgeId = 'badgeOracleTailscaleStatus';
                resultBoxId = 'oracleTailscaleTestResultBox';
                targetHost = '100.112.86.83';
            }

            const btn = document.getElementById(btnId);
            const badge = document.getElementById(badgeId);
            const resultBox = document.getElementById(resultBoxId);
            const origHtml = btn ? btn.innerHTML : '🔍 Test Oracle Connection';

            if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Testing Oracle...'; }
            if (badge) { badge.innerText = 'Testing...'; badge.style.color = '#38BDF8'; badge.style.background = 'rgba(56,189,248,0.15)'; }
            if (resultBox) {
                resultBox.style.display = 'block';
                resultBox.style.background = '#0F172A';
                resultBox.style.border = '1px solid #334155';
                resultBox.innerHTML = `<span class="spinner-sm"></span> Probing TCP port 1521 at ${targetHost} (${connectionName})...<br>• Validating authenticated session for SYSTEM (Password: Divyam@123)...<br>• Checking service XEPDB1 with multi-DB failover resilience...`;
            }

            try {
                const res = await fetch('/api/connections/test/oracle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ connection_name: connectionName })
                });

                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    d = { success: false, status: 'Server Error', error_message: `Server returned non-JSON (${res.status}): ${raw.slice(0, 150)}` };
                }

                const isSuccess = d && (d.success === true || d.status === 'Connected');
                if (badge) {
                    badge.innerText = d.status || (isSuccess ? 'Connected' : 'Offline / Standby');
                    badge.style.color = isSuccess ? '#10B981' : '#F59E0B';
                    badge.style.background = isSuccess ? 'rgba(16,185,129,0.15)' : 'rgba(245,158,11,0.15)';
                }

                if (resultBox) {
                    let html = `<div style="font-weight:700; color:${isSuccess ? '#10B981' : '#F59E0B'}; margin-bottom:6px;">
                        ${isSuccess ? '✅ ' + connectionName + ' Verified & Online' : '⚠️ ' + connectionName + ': ' + (d.status || 'Offline / Standby')}
                    </div>`;
                    html += `<div style="line-height:1.5; color:#CBD5E1;">
                        <div><strong>Target:</strong> ${d.host || targetHost}:${d.port || 1521}/${d.service_name || 'XEPDB1'}</div>
                        <div><strong>User:</strong> ${d.username || 'SYSTEM'}</div>
                        <div><strong>Response Time:</strong> ${d.response_time_ms ? d.response_time_ms + ' ms' : '—'}</div>
                        <div><strong>Status Detail:</strong> ${isSuccess ? 'Authenticated Oracle session active' : 'Host unreachable or offline (Multi-DB failover active)'}</div>
                    </div>`;

                    if (d.error_message) {
                        html += `<div style="margin-top:6px; color:#EF4444; font-size:11px; background:rgba(239,68,68,0.1); padding:6px; border-radius:4px;">
                            <strong>Diagnostic:</strong> ${d.error_message}
                        </div>`;
                    }
                    resultBox.innerHTML = html;
                }

                await refreshConnectionHealthTable();
            } catch (e) {
                if (resultBox) {
                    resultBox.innerHTML = `<div style="color:#EF4444;">❌ Network / Server Error: ${e.message || e}</div>`;
                }
            } finally {
                isTestingOracle = false;
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

