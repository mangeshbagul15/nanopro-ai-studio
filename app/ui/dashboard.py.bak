                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="generateStudioImage()">&#127912; Generate Image</button>
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('imgPrompt').value=''">Clear Prompt</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>Generated Image Output &amp; Metadata</h2>
                <div class="viewer-box" id="imgOutput">No images generated yet. Enter prompt and click Generate Image.</div>
            </div>
        </div>

        <!-- VIEW: CODING AGENT -->
        <div class="workspace-view" id="view-coding_agent">
            <div class="panel-card">
                <h2>Coding Agent Workspace</h2>
                <div class="btn-row" style="margin-top:0; margin-bottom:10px;">
                    <div style="flex:1;">
                        <label class="input-label">Programming Language</label>
                        <select class="studio-input" id="codingLang">
                            <option value="python">Python</option>
                            <option value="sql">SQL (PostgreSQL / Oracle / Snowflake)</option>
                            <option value="javascript">JavaScript / TypeScript</option>
                            <option value="html_css">HTML5 &amp; CSS3</option>
                            <option value="bash">Bash / Shell</option>
                        </select>
                    </div>
                    <div style="flex:1;">
                        <label class="input-label">Target Model</label>
                        <select class="studio-input" id="codingModel">
                            <option value="qwen2.5-coder:3b">qwen2.5-coder:3b (Recommended &amp; Fast)</option>
                            <option value="qwen2.5-coder:7b">qwen2.5-coder:7b (High Accuracy)</option>
                            <option value="phi4-mini:latest">phi4-mini:latest</option>
                        </select>
                    </div>
                </div>

                <label class="input-label">Code Generation or Transformation Prompt</label>
                <textarea class="studio-input" id="codingPrompt" rows="2" placeholder="e.g. Write a Python script to read an Excel file and load its data into Oracle with batch inserts."></textarea>
                
                <label class="input-label" style="margin-top:10px;">Source Code / Context (Optional)</label>
                <textarea class="studio-input code-editor" id="codingSource" rows="5" placeholder="// Paste existing code to debug, refactor, or explain..."></textarea>

                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="executeCodingAction('generate')">&#128187; Generate Code</button>
                    <button type="button" class="btn btn-secondary" onclick="executeCodingAction('debug')">&#128027; Debug Code</button>
                    <button type="button" class="btn btn-secondary" onclick="executeCodingAction('explain')">&#128214; Explain Code</button>
                    <button type="button" class="btn btn-secondary" onclick="executeCodingAction('tests')">&#9989; Generate Unit Tests</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>Coding Result &amp; AST Analysis <button type="button" class="btn btn-secondary" onclick="copyViewer('codingOutput')" style="font-size:11px; padding:3px 10px;">Copy Code</button></h2>
                <div class="viewer-box" id="codingOutput">Ready for coding instructions.</div>
            </div>
            <!-- AUTONOMOUS CODE ARCHITECT & SELF-MODIFYING ENGINE -->
            <div class="panel-card" style="border: 1px solid #7c3aed; background: linear-gradient(180deg, rgba(124, 58, 237, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); margin-top: 15px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
                    <div>
                        <h2 style="color:#a78bfa; margin:0; display:flex; align-items:center; gap:8px;">
                            <span>&#9889;</span> Autonomous Code Architect (Prompt-to-Code Engine)
                        </h2>
                        <p style="color:#94a3b8; font-size:12px; margin:4px 0 0 0;">
                            Understands internal architecture from prompt, modifies code safely via AST analysis, validates syntax, creates automatic backups, and supports one-click rollback.
                        </p>
                    </div>
                    <span class="badge" style="background:#7c3aed; color:#fff; font-size:11px; padding:4px 10px; border-radius:12px;">&#10004; Self-Modifying Core Active</span>
                </div>

                <div class="btn-row" style="margin-top:0; margin-bottom:10px;">
                    <div style="flex:1; min-width:240px;">
                        <label class="input-label">Target File to Modify / Inspect</label>
                        <select class="studio-input" id="codeModTargetFile" onchange="document.getElementById('codeModCustomPath').value = this.value;">
                            <option value="main.py">main.py (FastAPI Routes &amp; Server Core)</option>
                            <option value="app/agents/coding_agent.py">app/agents/coding_agent.py (Coding Engine)</option>
                            <option value="app/agents/manager_agent.py">app/agents/manager_agent.py (Manager Orchestrator)</option>
                            <option value="app/core/database.py">app/core/database.py (Database Manager)</option>
                            <option value="app/core/credentials.py">app/core/credentials.py (Vault &amp; Secrets)</option>
                            <option value="app/ui/dashboard.py">app/ui/dashboard.py (Dashboard UI Template)</option>
                        </select>
                    </div>
                    <div style="flex:1; min-width:240px;">
                        <label class="input-label">Custom Relative Path (Optional)</label>
                        <input type="text" class="studio-input" id="codeModCustomPath" value="main.py" placeholder="e.g. main.py or app/core/database.py">
                    </div>
                </div>

                <label class="input-label">Natural Language Logic Modification Prompt</label>
                <textarea class="studio-input" id="codeModInstruction" rows="3" placeholder="e.g. Add a health check endpoint /api/system/audit-summary that returns current uptime, database size, and active worker count. Or: Add a validation check for phone numbers in contact agent."></textarea>

                <div class="btn-row" style="flex-wrap:wrap; gap:8px;">
                    <button type="button" class="btn btn-primary" onclick="applyCodeModificationPrompt()" style="background:#7c3aed; border-color:#6d28d9;">
                        &#9889; Apply Code-Level Modification
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="analyzeTargetFile()">
                        &#128065; Inspect &amp; Analyze AST
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="fetchCodeBackups()">
                        &#128190; View Backups List
                    </button>
                    <button type="button" class="btn btn-warning" onclick="rollbackCodeBackup()" style="color:#f59e0b; border-color:#d97706;">
                        &#9100; Rollback to Previous Backup
                    </button>
                </div>

                <div style="margin-top:12px;">
                    <label class="input-label">Modification Audit, Unified Diff &amp; AST Result</label>
                    <div class="viewer-box" id="codeModDiffOutput" style="min-height:120px; font-family:monospace; font-size:12px; white-space:pre-wrap; background:#0b0f19; border:1px solid #334155; padding:10px; border-radius:6px; color:#38bdf8;">Ready for autonomous code-level modification prompts.</div>
                </div>
            </div>

        </div>

        <!-- VIEW: RESEARCH AGENT -->
        <div class="workspace-view" id="view-research_agent">
            <div class="panel-card">
                <h2>Research &amp; Intelligence Agent</h2>
                <label class="input-label">Research Query or Topic</label>
                <textarea class="studio-input" id="researchQuery" rows="3" placeholder="e.g. Compare Snowflake and Databricks architecture for data engineering workloads with trade-offs."></textarea>

                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="executeResearch()">&#128269; Conduct Research</button>
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('researchQuery').value=''">Clear</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>Synthesized Research Report <button type="button" class="btn btn-secondary" onclick="copyViewer('researchOutput')" style="font-size:11px; padding:3px 10px;">Copy Report</button></h2>
                <div class="viewer-box" id="researchOutput">Enter a research topic to view synthesized insights.</div>
            </div>
        </div>

        <!-- VIEW: TELEGRAM AI AGENT (MULTI-DOMAIN BROADCAST HUB) -->
        <div class="workspace-view" id="view-telegram_agent">
            <div class="panel-card">
                <h2>Telegram AI Agent — 360° Multi-Domain Broadcast Hub</h2>
                <div style="font-size:12.5px; color:var(--text-muted); margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                    <div>Target Bot: <b style="color:var(--accent-blue);">@mangesh_technews_bot</b> | Chat ID: <b style="color:var(--accent-green);">1200023268 (Mangesh Bagul)</b></div>
                    <div style="background:rgba(16, 185, 129, 0.15); border:1px solid #10B981; color:#10B981; font-size:11px; padding:3px 10px; border-radius:20px; font-weight:700;">
                        ⏱️ Recurring 10-Min Broadcast Daemon: ACTIVE
                    </div>
                </div>

                <div style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:10px;">Select Multi-Domain Broadcast Topic:</div>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:12px; margin-bottom:16px;">
                    <div class="conn-node-card" style="cursor:pointer;" onclick="dispatchTgBroadcast('all')">
