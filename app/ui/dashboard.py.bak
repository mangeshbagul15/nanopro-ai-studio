        async function dispatchComposedMessage() {
            const ch = document.getElementById('composeChannel').value;
            const recip = document.getElementById('composeRecipient').value;
            const subj = document.getElementById('composeSubject').value;
            const body = document.getElementById('composeBody').value;
            const logBox = document.getElementById('commLogBox');

            if (!body.trim()) {
                alert('Please enter message content.');
                return;
            }

            logBox.innerText = `Dispatching ${ch.toUpperCase()} message to ${recip}...`;

            try {
                if (ch === 'email') {
                    const res = await fetch('/api/communication/smtp/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ to: recip, subject: subj, body: body })
                    });
                    const d = await res.json();
                    logBox.innerText = 'Email Dispatch Result:\n' + JSON.stringify(d, null, 2);
                } else {
                    const res = await fetch('/api/communication/telegram/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: body, chat_id: recip })
                    });
                    const d = await res.json();
                    logBox.innerText = 'Telegram Dispatch Result:\n' + JSON.stringify(d, null, 2);
                }
            } catch (err) {
                logBox.innerText = 'Dispatch Error: ' + err;
            }
        }

