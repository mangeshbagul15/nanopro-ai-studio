        <div class="workspace-view" id="view-data_science">
    <div class="panel-card" style="margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
                <h2>Data Science &amp; Machine Learning Workbench</h2>
                <p style="font-size:12px; color:var(--text-muted); margin:0;">
                    Feature engineering, dataset distribution profiling, automated model training, evaluation metrics, and prediction playground.
                </p>
