                    <button type="button" class="btn btn-secondary" onclick="pauseAutonomousOps()" style="border-color:#F59E0B; color:#F59E0B;">&#10074;&#10074; Pause Tasks</button>
                    <button type="button" class="btn btn-secondary" onclick="resumeAutonomousOps()" style="border-color:#38BDF8; color:#38BDF8;">&#9654;&#9654; Resume Ops</button>
                    <button type="button" class="btn btn-secondary" onclick="stopAutonomousOps()" style="border-color:#64748B; color:#94A3B8;">&#9632; Stop Safely</button>
                    <button type="button" class="btn btn-danger" onclick="emergencyStopAutonomousOps()" style="background:#EF4444; border:none; font-weight:700;">&#9888; Emergency Stop</button>
                    <button type="button" class="btn btn-secondary" onclick="restartFailedTasksOps()" style="border-color:#8B5CF6; color:#C084FC;">&#8634; Restart Failed</button>
                    <button type="button" class="btn btn-primary" onclick="triggerEndToEndPipeline()" style="background:linear-gradient(135deg, #3B82F6, #8B2EFF); border:none; font-weight:600; margin-left:auto;">&#9889; Run E2E Snowflake &rarr; Report &rarr; Email</button>
