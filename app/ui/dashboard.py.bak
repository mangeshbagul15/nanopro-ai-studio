            <div class="panel-card">
                <h2>AI Studio Manager Central Prompt</h2>
                <label class="input-label">Natural Language Command &amp; Delegation</label>
                <textarea class="studio-input" id="dashPrompt" rows="3" placeholder="e.g. Create a SQL interview video about second-highest salary, generate thumbnail, and post daily news to Telegram."></textarea>
                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="submitDashInstruction()">&#9658; Execute Instruction</button>
                    <button type="button" class="btn btn-secondary" onclick="clearDashPrompt()">Clear</button>
                    <button type="button" class="btn btn-accent" onclick="switchView('sql_video')">SQL Workspace</button>
                    <button type="button" class="btn btn-accent" onclick="switchView('telegram_agent')">Telegram Hub</button>
                </div>
            </div>

