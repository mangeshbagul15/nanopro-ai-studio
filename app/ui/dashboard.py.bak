    </div>

    <!-- MULTI-TABLE JOIN VISUALIZATION CONTAINER -->
    <div class="panel-card" id="sqlJoinVizCard" style="margin-bottom:12px; border-color:#38BDF8;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <div>
                <span style="font-size:13px; font-weight:800; color:#38BDF8; text-transform:uppercase;">&#128452; Interactive Multi-Table Join Visualizer</span>
                <span style="font-size:11px; color:var(--text-muted); margin-left:8px;">CUSTOMERS (Left) &harr; TRANSACTIONS (Right)</span>
            </div>
            <span class="badge" style="background:#065F46; color:#34D399; font-size:10px;">MATCH PROCESS VALIDATED</span>
        </div>

        <div class="join-visualization-grid">
            <!-- Left Table -->
            <div class="join-table-card" id="joinTableA">
                <div class="join-table-header">TABLE 1: CUSTOMERS (Source Left)</div>
                <table style="width:100%; border-collapse:collapse; font-size:11px;">
                    <thead><tr style="color:var(--text-muted);"><th style="text-align:left;">customer_id</th><th style="text-align:left;">name</th><th style="text-align:left;">city</th><th style="text-align:left;">tier</th></tr></thead>
                    <tbody>
                        <tr class="matched-join-row"><td><strong>101</strong></td><td>Mangesh Bagul</td><td>Mumbai</td><td>Gold</td></tr>
                        <tr class="matched-join-row"><td><strong>102</strong></td><td>Aarav Patil</td><td>Pune</td><td>Platinum</td></tr>
                        <tr class="unmatched-join-row"><td><strong>103</strong></td><td>Sneha Kulkarni</td><td>Thane</td><td>Silver</td></tr>
                        <tr class="matched-join-row"><td><strong>104</strong></td><td>Rohan Deshmukh</td><td>Nashik</td><td>Bronze</td></tr>
                        <tr class="unmatched-join-row"><td><strong>105</strong></td><td>Pooja Shinde</td><td>Nagpur</td><td>Silver</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Join Operator Indicator -->
            <div style="text-align:center; padding:10px;">
                <div style="font-size:12px; font-weight:800; color:#38BDF8;">LEFT JOIN</div>
                <div style="font-size:10px; color:var(--text-muted); font-family:monospace;">ON id = cust_id</div>
                <div style="font-size:22px; color:#10B981; margin-top:4px;">&harr;</div>
            </div>

            <!-- Right Table -->
            <div class="join-table-card" id="joinTableB">
                <div class="join-table-header">TABLE 2: TRANSACTIONS (Source Right)</div>
                <table style="width:100%; border-collapse:collapse; font-size:11px;">
                    <thead><tr style="color:var(--text-muted);"><th style="text-align:left;">txn_id</th><th style="text-align:left;">customer_id</th><th style="text-align:left;">amount</th><th style="text-align:left;">date</th></tr></thead>
                    <tbody>
                        <tr class="matched-join-row"><td>TXN_901</td><td><strong>101</strong></td><td>₹14,500</td><td>2026-10-01</td></tr>
                        <tr class="matched-join-row"><td>TXN_902</td><td><strong>101</strong></td><td>₹8,200</td><td>2026-10-03</td></tr>
                        <tr class="matched-join-row"><td>TXN_903</td><td><strong>102</strong></td><td>₹52,000</td><td>2026-10-02</td></tr>
                        <tr class="matched-join-row"><td>TXN_904</td><td><strong>104</strong></td><td>₹3,400</td><td>2026-10-04</td></tr>
                        <tr class="unmatched-join-row"><td>TXN_905</td><td><strong>999</strong> (orphan)</td><td>₹1,200</td><td>2026-10-05</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="joinResultTable" style="margin-top:10px;"></div>
        <div id="joinExplanationBox" style="background:#060B18; border:1px solid var(--border); border-radius:6px; padding:10px; font-size:11.5px; color:#E2E8F0; line-height:1.5; margin-top:10px;">
            <strong>Step-by-Step Join Logic:</strong> LEFT JOIN keeps <em>all 5 customers</em>. Customers 103 and 105 have no matching transaction rows, so their transaction fields become <code>NULL</code>. Transaction TXN_905 has customer_id 999 which does not exist in CUSTOMERS and is naturally filtered out.
        </div>
    </div>

    <!-- Active Challenge Editor & Expected vs Actual Output -->
    <div style="display:grid; grid-template-columns:1.2fr 1fr; gap:12px;">
        <div class="panel-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <h3 style="font-size:13.5px; color:#F8FAFC; margin:0;" id="learningQuestionTitle">Challenge: Cumulative Running Total Spending</h3>
                <span class="badge" style="background:#78350F; color:#FBBF24; font-size:10px;">INTERMEDIATE</span>
            </div>
            <p style="font-size:11.5px; color:var(--text-muted); margin-bottom:10px;" id="learningQuestionPrompt">
                Write a query calculating the running cumulative sum of transaction amount for each customer ordered by transaction date.
            </p>

            <textarea class="studio-input" id="interactiveSqlEditor" rows="5" style="font-family:Consolas, monospace; font-size:12px;">SELECT customer_id, txn_date, amount,
       SUM(amount) OVER(PARTITION BY customer_id ORDER BY txn_date) AS running_total
FROM transactions;</textarea>

            <div class="btn-row">
                <button type="button" class="btn btn-primary" onclick="runInteractiveSqlPractice()">&#9654; Run Query</button>
                <button type="button" class="btn btn-secondary" onclick="toggleSqlHint()">&#128161; Hint</button>
                <button type="button" class="btn btn-secondary" onclick="toggleSqlSolution()">&#10004; Show Solution</button>
            </div>
            <div id="learningHintBox" style="display:none; background:#1E293B; border-radius:6px; padding:10px; font-size:11.5px; color:#38BDF8; margin-top:10px;"></div>
        </div>

        <div class="panel-card">
            <h3 style="font-size:13.5px; color:#F8FAFC; margin-bottom:8px;">Expected vs. Actual Output</h3>
            <div class="viewer-box" id="learningDrillBox" style="max-height:240px; font-size:11.5px;">Click [Run Query] or [Question of the Day] to practice interactive SQL scenarios.</div>
        </div>
    </div>
</div>

        <div class="workspace-view" id="view-startup_recovery">
            <div class="panel-card">
