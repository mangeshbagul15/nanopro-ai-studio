                        <div style="background:#1E293B; padding:8px; border-radius:4px; font-size:11.5px; color:#E2E8F0; margin-bottom:10px;">
                            <div><strong>Free Quota:</strong> ${a.free_quota || 'Standard Quota'}</div>
