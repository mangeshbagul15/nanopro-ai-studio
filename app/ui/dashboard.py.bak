let entertainmentCache = [];

async function loadEntertainmentItems() {
    try {
        const res = await fetch('/api/entertainment/items?limit=60');
        const data = await res.json();
        entertainmentCache = data.items || [];
        renderEntertainmentCards(entertainmentCache);
    } catch(e) {}
}

function renderEntertainmentCards(items) {
    const container = document.getElementById('entertainmentGrid');
    if (!container) return;
    if (items.length === 0) {
        container.innerHTML = '<div style="color:var(--text-muted); padding:20px;">No items match selected category.</div>';
        return;
    }
    container.innerHTML = items.map(it => {
        return `
            <div class="ent-card">
                <div class="ent-card-thumb-wrap">
                    <img src="${it.thumbnail_url || 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&auto=format&fit=crop'}" class="ent-card-thumb" alt="${escapeHtml(it.title)}" onerror="this.src='https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&auto=format&fit=crop';" />
                </div>
                <div class="ent-card-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <span class="badge" style="background:#1E293B; color:#38BDF8; font-size:10px;">${escapeHtml(it.category)}</span>
                        <span style="cursor:pointer; font-size:14px; color:${it.is_favorite ? '#F59E0B' : '#64748B'};" onclick="toggleEntertainmentFav('${it.item_id}', this)">★</span>
                    </div>
                    <div class="ent-card-title">${escapeHtml(it.title)}</div>
                    <div class="ent-card-creator">${escapeHtml(it.creator || '')}</div>
                    <div class="ent-card-desc">${escapeHtml(it.description || '')}</div>
                    <div style="display:flex; gap:6px; margin-top:auto; padding-top:8px; border-top:1px solid #1E293B;">
                        <button type="button" class="btn btn-secondary" style="font-size:10.5px; padding:3px 8px; flex:1;" onclick="askManagerAboutMedia('${it.item_id}')">&#129302; Ask Manager</button>
                        <a href="${it.media_url || '#'}" target="_blank" class="btn btn-primary" style="font-size:10.5px; padding:3px 8px; text-decoration:none;">Open &rarr;</a>
                    </div>
                </div>
            </div>
        `;
    }).join('');
}

function filterEntertainmentCategory(cat, btnEl) {
    const parent = btnEl.parentElement;
    parent.querySelectorAll('.action-chip').forEach(c => c.classList.remove('active'));
    btnEl.classList.add('active');

    if (cat === 'All') {
        renderEntertainmentCards(entertainmentCache);
    } else {
        const filtered = entertainmentCache.filter(it => (it.category || '').toLowerCase() === cat.toLowerCase());
        renderEntertainmentCards(filtered);
    }
}

function filterEntertainmentSearch(query) {
    const q = query.toLowerCase();
    const filtered = entertainmentCache.filter(it => {
        return (it.title || '').toLowerCase().includes(q) ||
               (it.creator || '').toLowerCase().includes(q) ||
               (it.description || '').toLowerCase().includes(q);
    });
    renderEntertainmentCards(filtered);
}

async function toggleEntertainmentFav(itemId, el) {
    try {
        await fetch(`/api/entertainment/favorite/${itemId}`, {method: 'POST'});
        el.style.color = el.style.color === 'rgb(245, 158, 11)' ? '#64748B' : '#F59E0B';
    } catch(e) {}
}

async function askManagerAboutMedia(itemId) {
    switchView('ai_manager');
    const target = entertainmentCache.find(i => i.item_id === itemId);
    const title = target ? target.title : 'this media';
    quickFillPrompt(`Explain and summarize ${title} in simple language.`);
}

/* =========================================================================
   10. BOOK READER & INTELLIGENT LEARNING ASSISTANT
   ========================================================================= */
let currentActiveBook = null;
let currentChapterIndex = 0;
let readerFontSize = 14;

async function loadBooksList() {
    try {
        const res = await fetch('/api/books/list');
        const data = await res.json();
        const books = data.books || [];
        if (books.length > 0) {
            selectBook(books[0]);
        }
    } catch(e) {}
}

function selectBook(book) {
    currentActiveBook = book;
    currentChapterIndex = 0;
    document.getElementById('readerActiveBookTitle').innerText = book.title;
    document.getElementById('readerActiveBookAuthor').innerText = 'Author: ' + (book.author || 'Unknown');
    document.getElementById('readerProgressPct').innerText = Math.round(book.reading_progress_pct || 0) + '%';
    document.getElementById('readerProgressBar').style.width = (book.reading_progress_pct || 0) + '%';

    const chapters = book.chapters || [];
    const listEl = document.getElementById('readerChaptersList');
    if (chapters.length === 0) {
        listEl.innerHTML = '<div style="color:var(--text-muted); font-size:11px;">No chapter headers detected.</div>';
    } else {
        listEl.innerHTML = chapters.map((ch, idx) => {
            const activeClass = idx === 0 ? 'active' : '';
            return `
                <div class="toc-chapter-item ${activeClass}" id="ch_item_${idx}" onclick="selectChapter(${idx})">
                    ${idx + 1}. ${escapeHtml(ch.title)}
                </div>
            `;
        }).join('');
    }
    loadChapterContent(0);
}

function selectChapter(idx) {
    currentChapterIndex = idx;
    document.querySelectorAll('.toc-chapter-item').forEach(el => el.classList.remove('active'));
    const target = document.getElementById('ch_item_' + idx);
    if (target) target.classList.add('active');
    loadChapterContent(idx);

    // Update progress
    if (currentActiveBook && currentActiveBook.chapters) {
        const total = currentActiveBook.chapters.length;
        const pct = Math.round(((idx + 1) / total) * 100);
        document.getElementById('readerProgressPct').innerText = pct + '%';
        document.getElementById('readerProgressBar').style.width = pct + '%';
        fetch(`/api/books/${currentActiveBook.book_id}/progress`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ progress_pct: pct, chapter_idx: idx })
        });
    }
}

function loadChapterContent(idx) {
    if (!currentActiveBook || !currentActiveBook.chapters) return;
    const ch = currentActiveBook.chapters[idx];
    if (!ch) return;
    document.getElementById('readerCurrentChapterTitle').innerText = ch.title;
    const content = ch.content || 'No text found in this chapter.';
    document.getElementById('readerTextArea').innerText = content;
    document.getElementById('readerTextArea').scrollTop = 0;
}

function adjustReaderFontSize(delta) {
    readerFontSize = Math.max(11, Math.min(22, readerFontSize + delta));
    document.getElementById('readerTextArea').style.fontSize = readerFontSize + 'px';
}

function readCurrentChapterAloud() {
    const text = document.getElementById('readerTextArea').innerText;
    speakText(text.substring(0, 500));
}

async function askBookAI(query) {
    if (!currentActiveBook) { alert('Please select a book first.'); return; }
    const outBox = document.getElementById('readerAIExplanationBox');
    outBox.style.display = 'block';
    outBox.innerHTML = '<span style="color:#38BDF8;">Consulting Book Reader Assistant...</span>';

    try {
        const res = await fetch(`/api/books/${currentActiveBook.book_id}/explain`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ query: query, chapter_idx: currentChapterIndex })
        });
        const data = await res.json();
        outBox.innerHTML = formatMarkdown(data.explanation || 'Explanation generated.');
    } catch(e) {
        outBox.innerHTML = `<span style="color:#EF4444;">Error: ${e.message}</span>`;
    }
}

function triggerBookUpload() {
    document.getElementById('bookUploadInputHidden').click();
}

async function handleBookFileUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    logLocal('BookReader', 'Uploading book: ' + file.name);

    try {
        const res = await fetch('/api/books/upload', {
            method: 'POST',
            body: formData
        });
        const d = await res.json();
        if (d.status === 'success') {
            alert(`Book '${d.title}' uploaded and indexed successfully with ${d.total_chapters} chapters!`);
            loadBooksList();
        } else {
            alert('Upload notice: ' + (d.error || 'Failed'));
        }
    } catch(e) {
        alert('Upload error: ' + e.message);
    }
}

function openBookPathImportModal() {
    const path = prompt('Enter accessible local file path to book (.pdf, .docx, .txt):');
    if (!path) return;
    fetch('/api/books/import_path', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ file_path: path.trim() })
    }).then(r => r.json()).then(d => {
        if (d.status === 'success') {
            alert(`Imported '${d.title}' with ${d.total_chapters} chapters.`);
            loadBooksList();
        } else {
            alert('Import notice: ' + (d.error || 'Failed'));
        }
    });
}

/* =========================================================================
   11. UTILITY HELPERS (MARKDOWN, ESCAPING)
   ========================================================================= */
function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function escapeQuotes(str) {
    if (!str) return '';
    return String(str).replace(/'/g, "\\'").replace(/\n/g, ' ');
}

function formatMarkdown(text) {
    if (!text) return '';
    let out = text;
    // Bold
    out = out.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    // Italic
    out = out.replace(/\*(.*?)\*/g, '<em>$1</em>');
    // Code blocks
    out = out.replace(/```(.*?)```/gs, '<pre style="background:#050811; padding:10px; border-radius:6px; overflow-x:auto;"><code>$1</code></pre>');
    // Inline code
    out = out.replace(/`([^`]+)`/g, '<code style="background:#0F172A; color:#38BDF8; padding:2px 5px; border-radius:3px;">$1</code>');
    // Bullet points
    out = out.replace(/^• (.*?)$/gm, '<li style="margin-left:14px;">$1</li>');
    // Numbered lists
    out = out.replace(/^\d+\. (.*?)$/gm, '<li style="margin-left:14px;">$1</li>');
    // Line breaks
    out = out.replace(/\n\n/g, '<br/><br/>').replace(/\n/g, '<br/>');
    return out;
}


window.addEventListener('DOMContentLoaded', () => {
            try { switchView('ai_manager'); } catch(e) { console.error('switchView error:', e); }
            try { renderOfficeStations('dashOfficeFloor'); } catch(e) {}
            try { renderOfficeStations('officeFloorFull'); } catch(e) {}
            try { loadApprovals(); } catch(e) {}
            try { refreshConnectionHealthTable(); } catch(e) {}
            try { loadVaultList(); } catch(e) {}
            try { setInterval(pollStatsAndAgents, 1200); } catch(e) {}
            try { setInterval(pollLogs, 1500); } catch(e) {}
            
            // Initialize Nano Pro Upgraded Centers
            try { refreshSchedulerDashboard(); } catch(e) {}
            try { loadNewsArticles(); } catch(e) {}
            try { loadEntertainmentItems(); } catch(e) {}
            try { loadBooksList(); } catch(e) {}
            try { refreshOfficeLiveState(); } catch(e) {}
            try { loadCloudTrends(); } catch(e) {}
            try { if (typeof loadCareerJobs === 'function') loadCareerJobs(); } catch(e) {}
            try { initPanoramicCanvas(); } catch(e) {}
            try { setInterval(checkFloatingNewsAlerts, 30000); } catch(e) {}
            try { setInterval(refreshOfficeLiveState, 6000); } catch(e) {}

            try { logLocal('System', 'Nano Pro Intelligent Personal AI Operating Center active.'); } catch(e) {}
        });
    
        /* --- NEW JAVASCRIPT HANDLERS FOR AMAZON, CAREER, LEARNING, RECOVERY --- */
        
        
        /* --- LAVISH 3D PANORAMIC CANVAS & CAROUSEL SCRIPT --- */
        let panoramicCanvasAnimId = null;
        let pCanvasMouseX = 0;
        let pCanvasMouseY = 0;

        function scrollPanoramicTrack(direction) {
            const track = document.getElementById('panoramicCardsTrack');
            if (!track) return;
            const amount = direction * 280;
            track.scrollBy({ left: amount, behavior: 'smooth' });
        }

        function toggleLavishCanvas() {
            const wrapper = document.getElementById('lavishCanvasWrapper');
            const btn = document.getElementById('btnToggleCanvas');
            if (!wrapper || !btn) return;
            if (wrapper.style.display === 'none') {
                wrapper.style.display = 'block';
                btn.innerText = '⤡ Minimize Canvas';
                initPanoramicCanvas();
            } else {
                wrapper.style.display = 'none';
                btn.innerText = '⤢ Expand 3D Canvas';
                if (panoramicCanvasAnimId) {
                    cancelAnimationFrame(panoramicCanvasAnimId);
                    panoramicCanvasAnimId = null;
                }
            }
        }

        function initPanoramicCanvas() {
            const canvas = document.getElementById('nanoProPanoramicCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            function resize() {
                const rect = canvas.getBoundingClientRect();
                canvas.width = rect.width || canvas.offsetWidth || 800;
                canvas.height = rect.height || canvas.offsetHeight || 190;
            }
            resize();
            window.addEventListener('resize', resize);

            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                pCanvasMouseX = (e.clientX - rect.left) - canvas.width / 2;
                pCanvasMouseY = (e.clientY - rect.top) - canvas.height / 2;
            });

            // Particles
            const particles = [];
            for (let i = 0; i < 45; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.8,
                    vy: (Math.random() - 0.5) * 0.8,
                    size: Math.random() * 2 + 1,
                    color: i % 3 === 0 ? '#38BDF8' : (i % 3 === 1 ? '#6366F1' : '#F59E0B')
                });
            }

            // Satellite node definitions
            const satellites = [
                { name: 'Snowflake (COMPUTE_WH)', color: '#38BDF8', angle: 0, dist: 130 },
                { name: 'Oracle XE (XEPDB1)', color: '#EF4444', angle: (Math.PI * 2) / 5, dist: 140 },
                { name: 'AWS S3 Lakehouse', color: '#F59E0B', angle: (Math.PI * 4) / 5, dist: 130 },
                { name: 'Telegram Bot', color: '#06B6D4', angle: (Math.PI * 6) / 5, dist: 135 },
                { name: 'SMTP Alert Hub', color: '#10B981', angle: (Math.PI * 8) / 5, dist: 140 }
            ];

            let rotAngle = 0;
            let packetProgress = [0, 0.2, 0.4, 0.6, 0.8];

            function draw() {
                if (canvas.offsetWidth === 0 || canvas.offsetHeight === 0) {
                    panoramicCanvasAnimId = requestAnimationFrame(draw);
                    return;
                }
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                // 1. Draw subtle isometric cyber grid
                ctx.strokeStyle = 'rgba(38, 51, 84, 0.3)';
                ctx.lineWidth = 1;
                const gridSpacing = 40;
                for (let x = 0; x < canvas.width; x += gridSpacing) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, canvas.height);
                    ctx.stroke();
                }
                for (let y = 0; y < canvas.height; y += gridSpacing) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(canvas.width, y);
                    ctx.stroke();
                }

                // 2. Draw floating particles
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                });

                // Center coordinates with slight parallax
                const centerX = canvas.width / 2 + pCanvasMouseX * 0.05;
                const centerY = canvas.height / 2 + pCanvasMouseY * 0.05;

                // 3. Central NanoPro Core Orb
                rotAngle += 0.008;
                ctx.save();
                ctx.translate(centerX, centerY);

                // Outer rotating ring 1
                ctx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.ellipse(0, 0, 36, 14, rotAngle, 0, Math.PI * 2);
                ctx.stroke();

                // Outer rotating ring 2
                ctx.strokeStyle = 'rgba(99, 102, 241, 0.6)';
                ctx.beginPath();
                ctx.ellipse(0, 0, 36, 14, -rotAngle * 1.2, 0, Math.PI * 2);
                ctx.stroke();

                // Core Sphere
                const grad = ctx.createRadialGradient(0, 0, 4, 0, 0, 20);
                grad.addColorStop(0, '#38BDF8');
                grad.addColorStop(0.7, '#6366F1');
                grad.addColorStop(1, '#0B0F19');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(0, 0, 18, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();

                // 4. Draw Satellites and Energy Arcs
                satellites.forEach((sat, idx) => {
                    const currentAngle = sat.angle + rotAngle * 0.5;
                    const satX = centerX + Math.cos(currentAngle) * sat.dist;
                    const satY = centerY + Math.sin(currentAngle) * (sat.dist * 0.42);

                    // Connection Line
                    ctx.strokeStyle = 'rgba(56, 189, 248, 0.25)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.moveTo(centerX, centerY);
                    ctx.lineTo(satX, satY);
                    ctx.stroke();

                    // Energy Packet travelling along line
                    packetProgress[idx] = (packetProgress[idx] + 0.01) % 1;
                    const pktX = centerX + (satX - centerX) * packetProgress[idx];
                    const pktY = centerY + (satY - centerY) * packetProgress[idx];
                    ctx.fillStyle = '#FFFFFF';
                    ctx.beginPath();
                    ctx.arc(pktX, pktY, 2.5, 0, Math.PI * 2);
                    ctx.fill();

                    // Satellite Node
                    ctx.fillStyle = sat.color;
                    ctx.beginPath();
                    ctx.arc(satX, satY, 7, 0, Math.PI * 2);
                    ctx.fill();

                    // Satellite Label
                    ctx.fillStyle = '#E2E8F0';
                    ctx.font = '10px "Segoe UI", sans-serif';
                    ctx.fillText(sat.name, satX - 35, satY + 18);
                });

                panoramicCanvasAnimId = requestAnimationFrame(draw);
            }

            if (panoramicCanvasAnimId) cancelAnimationFrame(panoramicCanvasAnimId);
            panoramicCanvasAnimId = requestAnimationFrame(draw);
        }


        /* --- CLOUD TRENDS (SNOWFLAKE VS AWS 2026) JAVASCRIPT HANDLERS --- */
        let allCloudTrendsData = null;
        let currentCloudTab = 'all';

        async function loadCloudTrends() {
            try {
                const res = await fetch('/api/cloud-trends/summary');
                const data = await res.json();
                allCloudTrendsData = data;
                renderCloudTrends();
            } catch(e) {
                logLocal('CloudTrends', 'Failed to load cloud trends: ' + e);
            }
        }

        function renderCloudTrends() {
            if (!allCloudTrendsData) return;
            const sfList = document.getElementById('snowflakeTrendsList');
            const awsList = document.getElementById('awsTrendsList');
            if (!sfList || !awsList) return;

            const searchTerm = (document.getElementById('cloudTrendSearch') ? document.getElementById('cloudTrendSearch').value : '').toLowerCase().trim();

            // Render Snowflake
            let sfHtml = '';
            allCloudTrendsData.snowflake_trends.forEach(item => {
                if (searchTerm && !item.name.toLowerCase().includes(searchTerm) && !item.de_use_case.toLowerCase().includes(searchTerm) && !item.name_mr.includes(searchTerm)) {
                    return;
                }
                sfHtml += '<div class="conn-node-card" style="background:#0F172A; border:1px solid #263354; padding:12px; border-radius:8px;">' +
                    '<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">' +
                        '<div style="display:flex; align-items:center; gap:8px;">' +
                            '<span style="background:#1E293B; color:#38BDF8; font-weight:800; font-size:11px; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center;">' + item.rank + '</span>' +
                            '<strong style="font-size:13px; color:#F8FAFC;">' + item.name + '</strong>' +
                        '</div>' +
                        '<span class="badge" style="background:rgba(56,189,248,0.15); border:1px solid #38BDF8; color:#38BDF8; font-size:10px;">' + item.status + '</span>' +
                    '</div>' +
                    '<div style="font-size:11px; color:#38BDF8; margin-bottom:4px; font-weight:600;">' + item.name_mr + '</div>' +
                    '<div style="font-size:11.5px; color:#94A3B8; margin-bottom:6px; line-height:1.4;">' + item.de_use_case + '</div>' +
                    '<div style="font-size:11px; color:#CBD5E1; background:#0B1120; padding:6px; border-radius:4px; margin-bottom:8px; border-left:2px solid #38BDF8;">' +
                        '<strong>मराठी उपयोग:</strong> ' + item.de_use_case_mr +
                    '</div>' +
                    '<div style="display:flex; justify-content:space-between; align-items:center;">' +
                        '<span style="font-size:10.5px; color:#64748B;">Category: ' + item.category + '</span>' +
                        '<button type="button" class="btn btn-secondary" onclick="generateCloudTrendCode(\'snowflake\', \'' + item.id + '\')" style="font-size:10px; padding:3px 8px;">💻 Generate DDL</button>' +
                    '</div>' +
                '</div>';
            });
            sfList.innerHTML = sfHtml || '<div style="color:#64748B; padding:12px;">No matching Snowflake trends found.</div>';

            // Render AWS
            let awsHtml = '';
            allCloudTrendsData.aws_trends.forEach(item => {
                if (searchTerm && !item.name.toLowerCase().includes(searchTerm) && !item.de_use_case.toLowerCase().includes(searchTerm) && !item.name_mr.includes(searchTerm)) {
                    return;
                }
                awsHtml += '<div class="conn-node-card" style="background:#0F172A; border:1px solid #263354; padding:12px; border-radius:8px;">' +
                    '<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">' +
                        '<div style="display:flex; align-items:center; gap:8px;">' +
                            '<span style="background:#1E293B; color:#F59E0B; font-weight:800; font-size:11px; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center;">' + item.rank + '</span>' +
                            '<strong style="font-size:13px; color:#F8FAFC;">' + item.name + '</strong>' +
                        '</div>' +
                        '<span class="badge" style="background:rgba(245,158,11,0.15); border:1px solid #F59E0B; color:#F59E0B; font-size:10px;">' + item.status + '</span>' +
                    '</div>' +
                    '<div style="font-size:11px; color:#F59E0B; margin-bottom:4px; font-weight:600;">' + item.name_mr + '</div>' +
                    '<div style="font-size:11.5px; color:#94A3B8; margin-bottom:6px; line-height:1.4;">' + item.de_use_case + '</div>' +
                    '<div style="font-size:11px; color:#CBD5E1; background:#0B1120; padding:6px; border-radius:4px; margin-bottom:8px; border-left:2px solid #F59E0B;">' +
                        '<strong>मराठी उपयोग:</strong> ' + item.de_use_case_mr +
                    '</div>' +
                    '<div style="display:flex; justify-content:space-between; align-items:center;">' +
                        '<span style="font-size:10.5px; color:#64748B;">Category: ' + item.category + '</span>' +
                        '<button type="button" class="btn btn-secondary" onclick="generateCloudTrendCode(\'aws\', \'' + item.id + '\')" style="font-size:10px; padding:3px 8px;">💻 Generate Code</button>' +
                    '</div>' +
                '</div>';
            });
            awsList.innerHTML = awsHtml || '<div style="color:#64748B; padding:12px;">No matching AWS trends found.</div>';
        }

        function filterCloudTrends() {
            renderCloudTrends();
        }

        async function generateCloudTrendCode(platform, trendId) {
            try {
                const res = await fetch('/api/cloud-trends/generate-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({platform: platform, trend_id: trendId})
                });
                const d = await res.json();
                const pnl = document.getElementById('cloudCodeViewerPanel');
                if (pnl) {
                    pnl.style.display = 'block';
                    document.getElementById('cloudCodeTitle').innerText = d.name + ' (' + d.platform.toUpperCase() + ') — ' + d.category;
                    document.getElementById('cloudCodeDesc').innerText = 'Data Engineer Use Case: ' + d.usage_tip;
                    document.getElementById('cloudCodeBlock').innerText = d.code;
                    pnl.scrollIntoView({behavior: 'smooth'});
                }
            } catch(e) {
                alert('Failed to generate code: ' + e);
            }
        }

        function closeCloudCodeViewer() {
            const pnl = document.getElementById('cloudCodeViewerPanel');
            if (pnl) pnl.style.display = 'none';
        }

        function copyGeneratedCloudCode() {
            const code = document.getElementById('cloudCodeBlock').innerText;
            navigator.clipboard.writeText(code).then(() => {
                alert('Code copied to clipboard!');
            });
        }

        function switchCloudTrendTab(tab) {
            currentCloudTab = tab;
            const dualGrid = document.getElementById('cloudTrendsDualGrid');
            const matrixSec = document.getElementById('cloudTrendsMatrixSection');
            const roadmapSec = document.getElementById('cloudTrendsRoadmapSection');

            ['btnTabAllTrends', 'btnTabSnowflake', 'btnTabAWS', 'btnTabMatrix', 'btnTabRoadmap'].forEach(id => {
                const b = document.getElementById(id);
                if (b) b.className = 'btn btn-secondary';
            });

            if (tab === 'all') {
                if (document.getElementById('btnTabAllTrends')) document.getElementById('btnTabAllTrends').className = 'btn btn-primary';
                if (dualGrid) {
                    dualGrid.style.display = 'grid';
                    if (dualGrid.children[0]) dualGrid.children[0].style.display = 'block';
                    if (dualGrid.children[1]) dualGrid.children[1].style.display = 'block';
                }
                if (matrixSec) matrixSec.style.display = 'none';
                if (roadmapSec) roadmapSec.style.display = 'none';
            } else if (tab === 'snowflake') {
                if (document.getElementById('btnTabSnowflake')) document.getElementById('btnTabSnowflake').className = 'btn btn-primary';
                if (dualGrid) {
                    dualGrid.style.display = 'grid';
                    if (dualGrid.children[0]) dualGrid.children[0].style.display = 'block';
                    if (dualGrid.children[1]) dualGrid.children[1].style.display = 'none';
                }
                if (matrixSec) matrixSec.style.display = 'none';
                if (roadmapSec) roadmapSec.style.display = 'none';
            } else if (tab === 'aws') {
                if (document.getElementById('btnTabAWS')) document.getElementById('btnTabAWS').className = 'btn btn-primary';
                if (dualGrid) {
                    dualGrid.style.display = 'grid';
                    if (dualGrid.children[0]) dualGrid.children[0].style.display = 'none';
                    if (dualGrid.children[1]) dualGrid.children[1].style.display = 'block';
                }
                if (matrixSec) matrixSec.style.display = 'none';
                if (roadmapSec) roadmapSec.style.display = 'none';
            } else if (tab === 'matrix') {
                if (document.getElementById('btnTabMatrix')) document.getElementById('btnTabMatrix').className = 'btn btn-primary';
                if (dualGrid) dualGrid.style.display = 'none';
                if (matrixSec) matrixSec.style.display = 'block';
                if (roadmapSec) roadmapSec.style.display = 'none';
                loadCloudMatrixTable();
            } else if (tab === 'roadmap') {
                if (document.getElementById('btnTabRoadmap')) document.getElementById('btnTabRoadmap').className = 'btn btn-primary';
                if (dualGrid) dualGrid.style.display = 'none';
                if (matrixSec) matrixSec.style.display = 'none';
                if (roadmapSec) roadmapSec.style.display = 'block';
                showCareerRoadmap('mr');
            }
        }

        async function loadCloudMatrixTable() {
            try {
                const res = await fetch('/api/cloud-trends/compare');
                const data = await res.json();
                const tbody = document.getElementById('cloudMatrixTableBody');
                if (!tbody) return;
                let html = '';
                data.matrix.forEach(row => {
                    html += '<tr>' +
                        '<td style="font-weight:700; color:#38BDF8;">' + row.category + '<br/><span style="font-size:10.5px; color:#64748B;">' + row.category_mr + '</span></td>' +
                        '<td style="color:#E2E8F0;">❄️ ' + row.snowflake_feature + '</td>' +
                        '<td style="color:#E2E8F0;">🔶 ' + row.aws_feature + '</td>' +
                        '<td style="color:#94A3B8; font-size:11.5px;">' + row.de_impact + '</td>' +
                        '<td><span class="badge" style="background:#0F172A; border:1px solid #10B981; color:#10B981;">' + row.winner + '</span></td>' +
                    '</tr>';
                });
                tbody.innerHTML = html;
            } catch(e) {
                logLocal('CloudTrends', 'Failed to load matrix: ' + e);
            }
        }

        async function showCareerRoadmap(lang) {
            try {
                const res = await fetch('/api/cloud-trends/career-roadmap?lang=' + lang);
                const d = await res.json();
                const headlineEl = document.getElementById('roadmapHeadline');
                const box = document.getElementById('roadmapContentBox');
                if (headlineEl) headlineEl.innerText = d.headline;
                if (box) {
                    let html = '<div style="margin-bottom:12px; font-weight:700; color:#38BDF8;">Essential 2026 Core Skills:</div><ul style="margin-left:18px; margin-bottom:14px;">';
                    d.core_skills.forEach(s => {
                        html += '<li><strong>' + s.skill + '</strong> <span class="badge" style="font-size:10px; padding:1px 6px;">' + s.importance + '</span>: ' + s.desc + '</li>';
                    });
                    html += '</ul><div style="margin-bottom:8px; font-weight:700; color:#10B981;">Strategic Action Plan:</div><ol style="margin-left:18px;">';
                    d.action_plan.forEach(step => {
                        html += '<li>' + step + '</li>';
                    });
                    html += '</ol>';
                    box.innerHTML = html;
                }
            } catch(e) {
                logLocal('CloudTrends', 'Failed to load career roadmap: ' + e);
            }
        }

        async function runCloudBenchmarkSimulation() {
            try {
                const res = await fetch('/api/cloud-trends/benchmark', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({workload: 'enterprise_lakehouse_rag'})
                });
                const d = await res.json();
                alert('Cloud Benchmark Simulation Complete!\n\nPillars: ' + d.benchmark_scores.pillars.join(', ') + '\n\n' + d.strategic_summary_mr);
            } catch(e) {
                alert('Simulation error: ' + e);
            }
        }

        function exportCloudTrendsCSV() {
            if (!allCloudTrendsData) return;
            let csv = "Platform,Rank,Feature Name,Status,Category,Use Case,Marathi Use Case\n";
            allCloudTrendsData.snowflake_trends.forEach(i => {
                csv += 'Snowflake,' + i.rank + ',"' + i.name + '","' + i.status + '","' + i.category + '","' + i.de_use_case + '","' + i.de_use_case_mr + '"\n';
            });
            allCloudTrendsData.aws_trends.forEach(i => {
                csv += 'AWS,' + i.rank + ',"' + i.name + '","' + i.status + '","' + i.category + '","' + i.de_use_case + '","' + i.de_use_case_mr + '"\n';
            });
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "Snowflake_vs_AWS_Trends_October_2026.csv";
            a.click();
            URL.revokeObjectURL(url);
        }

        async function trackAmazonProduct() {
            const url = document.getElementById('amzUrl').value.trim();
            const target_price = parseFloat(document.getElementById('amzTargetPrice').value) || null;
            const frequency = document.getElementById('amzFreq').value;
            if (!url) { alert('Please enter a valid Amazon URL.'); return; }
            logLocal('PriceTracker', 'Registering product for monitoring...');
            try {
                const res = await fetch('/api/amazon/track', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({url, target_price, frequency})
                });
                const data = await res.json();
                if (data.status === 'success') {
                    alert('Successfully registered: ' + data.title + ' (ASIN: ' + data.asin + ')');
                    loadAmazonProducts();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (e) {
                alert('Connection error: ' + e);
            }
        }

        async function loadAmazonProducts() {
            const box = document.getElementById('amazonProductsBox');
            if (!box) return;
            box.innerText = 'Fetching tracked Amazon products...';
            try {
                const res = await fetch('/api/amazon/products');
                const data = await res.json();
                const prods = data.products || [];
                if (prods.length === 0) {
                    box.innerText = 'No Amazon products are currently tracked. Add a product URL above.';
                    return;
                }
                let html = '<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:12px;">';
                prods.forEach(p => {
                    html += `
                    <div style="background:#0F172A; border:1px solid #334155; border-radius:8px; padding:12px;">
                        <b style="color:#38BDF8;">${p.title}</b><br>
                        <span style="font-size:11px; color:#94A3B8;">ASIN: <code>${p.asin}</code> | Cadence: ${p.monitoring_frequency}</span>
                        <div style="margin:8px 0; font-size:13px;">
                            Latest: <b style="color:#10B981;">₹${Number(p.latest_price).toLocaleString()}</b> | Lowest: ₹${Number(p.lowest_price).toLocaleString()}
                        </div>
                        <a href="${p.url}" target="_blank" class="btn btn-secondary" style="padding:3px 8px; font-size:11px; text-decoration:none;">View on Amazon &rarr;</a>
                    </div>`;
                });
                html += '</div>';
                box.innerHTML = html;
            } catch (e) {
                box.innerText = 'Failed to load Amazon products: ' + e;
            }
        }

        async function searchCareerJobs() {
            const box = document.getElementById('careerJobsLandscapeGrid') || document.getElementById('careerJobsLandscapeGrid');
            const role = (document.getElementById('jobSearchQuery') || document.getElementById('jobSearchQuery') || {value:'Data Engineer'}).value;
            const location = (document.getElementById('jobLocationSelect') || document.getElementById('jobLocationSelect') || {value:'all'}).value;
            if (!box) return;
            box.innerText = 'Searching verified job opportunities...';
            try {
                const res = await fetch('/api/career/jobs/search', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({role, location})
                });
                const data = await res.json();
                const jobs = data.jobs || [];
                let html = '<div style="display:flex; flex-direction:column; gap:10px;">';
                jobs.forEach(j => {
                    html += `
                    <div style="background:#0F172A; border:1px solid #334155; border-radius:8px; padding:12px;">
                        <div style="display:flex; justify-content:space-between;">
                            <b style="font-size:14px; color:#38BDF8;">${j.title}</b>
                            <span style="font-size:11px; color:#10B981;">${j.salary_info}</span>
                        </div>
                        <div style="font-size:12px; color:#94A3B8; margin:4px 0;">${j.company} — 📍 ${j.location} (${j.experience_level})</div>
                        <div style="font-size:11.5px;"><b>Skills:</b> <code>${j.skills_required}</code></div>
                        <div style="font-size:11px; color:#64748B; margin-top:4px;"><i>${j.notes}</i></div>
                        <a href="${j.source_url}" target="_blank" class="btn btn-secondary" style="margin-top:6px; padding:3px 8px; font-size:11px; text-decoration:none; display:inline-block;">Apply / Details &rarr;</a>
                    </div>`;
                });
                html += '</div>';
                box.innerHTML = html;
            } catch (e) {
                box.innerText = 'Failed to load jobs: ' + e;
            }
        }

        
        /* --- UPGRADED CAREER & JOB SEARCH HUB (MANGESH BAGUL - 4 YRS DATA ENGINEER) --- */
        let allCareerJobsList = [];
        let allScenariosList = [];
        let activeSelectedJobId = null;

        function switchCareerTab(tab) {
            ['jobs', 'scenarios', 'study', 'resume_vault', 'telegram_radar'].forEach(t => {
                const sec = document.getElementById('careerSection' + (t === 'jobs' ? 'Jobs' : t === 'scenarios' ? 'Scenarios' : t === 'study' ? 'Study' : t === 'resume_vault' ? 'Resume' : 'Telegram'));
                const btn = document.getElementById('btnCareerTab' + (t === 'jobs' ? 'Jobs' : t === 'scenarios' ? 'Scenarios' : t === 'study' ? 'Study' : t === 'resume_vault' ? 'Resume' : 'Telegram'));
                if (sec) sec.style.display = (t === tab) ? 'block' : 'none';
                if (btn) btn.className = (t === tab) ? 'btn btn-primary' : 'btn btn-secondary';
            });
            if (tab === 'jobs' && allCareerJobsList.length === 0) loadCareerJobs();
            if (tab === 'scenarios' && allScenariosList.length === 0) loadScenarioQuestions();
            if (tab === 'study') loadStudyCatalog();
            if (tab === 'resume_vault') loadHrDrafterDefault();
            if (tab === 'telegram_radar') updateTelegramPreviewBox();
        }

        async function loadCareerJobs() {
            const grid = document.getElementById('careerJobsLandscapeGrid');
            if (!grid) return;
            grid.innerHTML = '<div style="color:#94A3B8; padding:14px;">Scanning verified MNC and Banking portals (Mumbai, Thane, Navi Mumbai)...</div>';
            try {
                const res = await fetch('/api/career/jobs/search', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({role: 'Data Engineer', location: 'Mumbai'})
                });
                const d = await res.json();
                allCareerJobsList = d.jobs || [];
                renderCareerJobsGrid();
                populateHrDraftJobSelect();
            } catch(e) {
                grid.innerHTML = '<div style="color:#EF4444; padding:14px;">Failed to scan job portals: ' + e + '</div>';
            }
        }

        function renderCareerJobsGrid() {
            const grid = document.getElementById('careerJobsLandscapeGrid');
            if (!grid) return;
            const searchQ = (document.getElementById('jobSearchQuery') ? document.getElementById('jobSearchQuery').value : '').toLowerCase().trim();
            const locFilter = (document.getElementById('jobLocationSelect') ? document.getElementById('jobLocationSelect').value : 'all').toLowerCase();
            const minSal = parseFloat(document.getElementById('jobSalarySelect') ? document.getElementById('jobSalarySelect').value : 6.0);

            let html = '';
            let count = 0;
            allCareerJobsList.forEach(j => {
                if (searchQ && !j.title.toLowerCase().includes(searchQ) && !j.company.toLowerCase().includes(searchQ) && !j.skills_required.toLowerCase().includes(searchQ)) {
                    return;
                }
                if (locFilter !== 'all' && !j.location.toLowerCase().includes(locFilter)) {
                    return;
                }
                if (j.salary_min_lpa && j.salary_min_lpa < minSal) {
                    return;
                }
                count++;
                html += `
                <div class="panel-card" style="background:linear-gradient(135deg, rgba(17,25,46,0.95), rgba(15,23,42,0.9)); border:1px solid #263354; border-left:4px solid #10B981; padding:16px; border-radius:10px; transition:all 0.25s;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:8px;">
                        <div>
                            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px;">
                                <strong style="font-size:15px; color:#F8FAFC;">${j.title}</strong>
                                <span class="badge" style="background:#064E3B; border:1px solid #10B981; color:#34D399; font-size:10.5px;">✔ ${j.verification_badge}</span>
                                <span class="badge" style="background:#0F172A; border:1px solid #38BDF8; color:#38BDF8; font-size:10.5px;">MATCH: ${j.match_score_pct}%</span>
                            </div>
                            <div style="font-size:12.5px; color:#38BDF8; font-weight:700;">
                                🏢 ${j.company} &bull; 📍 ${j.location}
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:14px; font-weight:800; color:#10B981;">${j.salary_info}</div>
                            <div style="font-size:11px; color:#94A3B8;">Experience: <b>${j.experience_level}</b></div>
                        </div>
                    </div>

                    <div style="font-size:12px; color:#CBD5E1; margin-bottom:10px; line-height:1.45;">
                        <b>Key Skills:</b> <code style="color:#A7F3D0; background:#0B1120; padding:2px 6px; border-radius:4px;">${j.skills_required}</code>
                    </div>

                    <div style="font-size:11.5px; color:#94A3B8; background:#090E1A; padding:8px 12px; border-radius:6px; margin-bottom:12px; border:1px solid #1E293B;">
                        <b>Verification Audit:</b> ${j.verification_reason} &bull; <i>Posted: ${j.posted_date}</i>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                        <span style="font-size:11px; color:#64748B;">Portal: ${j.portal_type}</span>
                        <div style="display:flex; gap:8px;">
                            <button type="button" class="btn btn-secondary" onclick="openJobDetailModal('${j.id}')" style="font-size:11px; padding:4px 10px;">📄 View Full JD</button>
                            <button type="button" class="btn btn-primary" onclick="prepareHrEmailDraft('${j.id}')" style="font-size:11px; padding:4px 12px;">✉️ 1-Click Draft HR Email</button>
                            <a href="${j.source_url}" target="_blank" class="btn btn-accent" style="font-size:11px; padding:4px 10px; text-decoration:none;">Official Portal &rarr;</a>
                        </div>
                    </div>
                </div>`;
            });
            if (count === 0) {
                grid.innerHTML = '<div style="color:#94A3B8; padding:16px;">No jobs found matching the selected filter criteria. Try adjusting the experience or location filter.</div>';
            } else {
                grid.innerHTML = html;
            }
        }

        async function searchCareerJobs() {
            if (allCareerJobsList.length === 0) {
                await loadCareerJobs();
            } else {
                renderCareerJobsGrid();
            }
        }

        function openJobDetailModal(jobId) {
            const j = allCareerJobsList.find(x => x.id === jobId);
            if (!j) return;
            activeSelectedJobId = jobId;
            document.getElementById('modalJobTitle').innerText = j.title;
            document.getElementById('modalJobCompany').innerText = j.company + ' — ' + j.location;
            document.getElementById('modalJobMeta').innerText = `Experience: ${j.experience_level} | Package: ${j.salary_info} | Match: ${j.match_score_pct}%`;
            document.getElementById('btnModalApplyExternal').href = j.source_url;
            document.getElementById('modalJobContent').innerHTML = `<pre style="white-space:pre-wrap; font-family:inherit; color:#E2E8F0; line-height:1.6; margin:0;">${j.jd_full}</pre>`;
            document.getElementById('jobDetailModal').style.display = 'flex';
        }

        function closeJobDetailModal() {
            document.getElementById('jobDetailModal').style.display = 'none';
        }

        function modalDraftEmailClick() {
            closeJobDetailModal();
            if (activeSelectedJobId) {
                prepareHrEmailDraft(activeSelectedJobId);
            }
        }

        function populateHrDraftJobSelect() {
            const sel = document.getElementById('hrDraftJobSelect');
            if (!sel) return;
            sel.innerHTML = '';
            allCareerJobsList.forEach(j => {
                const opt = document.createElement('option');
                opt.value = j.id;
                opt.text = `${j.company} — ${j.title}`;
                sel.appendChild(opt);
            });
            if (allCareerJobsList.length > 0) {
                onHrJobSelectChanged();
            }
        }

        async function onHrJobSelectChanged() {
            const sel = document.getElementById('hrDraftJobSelect');
            if (!sel || !sel.value) return;
            try {
                const res = await fetch('/api/career/draft-email', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({job_id: sel.value})
                });
                const d = await res.json();
                document.getElementById('hrEmailSubject').value = d.subject;
                document.getElementById('hrEmailBody').value = d.body;
                if (!document.getElementById('hrRecipientEmail').value) {
                    const cleanComp = d.company.toLowerCase().replace(/[^a-z]/g, '');
                    document.getElementById('hrRecipientEmail').value = `careers.${cleanComp}@example.com`;
                }
            } catch(e) {
                logLocal('CareerHub', 'Error loading HR draft: ' + e);
            }
        }

        function prepareHrEmailDraft(jobId) {
            switchCareerTab('resume_vault');
            const sel = document.getElementById('hrDraftJobSelect');
            if (sel) {
                sel.value = jobId;
                onHrJobSelectChanged();
            }
        }

        function loadHrDrafterDefault() {
            if (allCareerJobsList.length > 0 && !document.getElementById('hrEmailSubject').value) {
                populateHrDraftJobSelect();
            }
        }

        function copyDraftedHrEmail() {
            const sub = document.getElementById('hrEmailSubject').value;
            const body = document.getElementById('hrEmailBody').value;
            const fullText = `Subject: ${sub}

${body}

[Attachment: Mangesh_Bagul_Data_Engineer.pdf]`;
            navigator.clipboard.writeText(fullText).then(() => {
                alert('HR Application Email copied to clipboard!');
            });
        }

        async function sendDraftedHrEmail() {
            const to = document.getElementById('hrRecipientEmail').value.trim();
            const sub = document.getElementById('hrEmailSubject').value.trim();
            const body = document.getElementById('hrEmailBody').value.trim();
            const sel = document.getElementById('hrDraftJobSelect');
            const jobId = sel ? sel.value : 'job_01';

            if (!to || !to.includes('@')) {
                alert('Please enter a valid HR / Recruiter email address.');
                return;
            }
            if (!confirm(`Send application email with resume attachment (Mangesh_Bagul_Data_Engineer.pdf) to ${to}?`)) {
                return;
            }

            try {
                const res = await fetch('/api/career/send-email', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job_id: jobId,
                        recipient_email: to,
                        subject: sub,
                        body: body
                    })
                });
                const d = await res.json();
                if (d.status === 'success' || d.delivery_status === 'Accepted by Server') {
                    alert(`Application successfully sent to ${to} with attached resume!`);
                } else {
                    alert(`Email dispatch notification: ${d.error || d.error_details || 'Attempted via configured SMTP channel'}`);
                }
            } catch(e) {
                alert('Email transmission error: ' + e);
            }
        }

        async function loadScenarioQuestions(category = 'all') {
            const box = document.getElementById('careerScenariosContainer');
            if (!box) return;
            box.innerHTML = '<div style="color:#94A3B8; padding:12px;">Loading production scenario questions for 4 years experience...</div>';
            try {
                const url = '/api/career/scenarios' + (category !== 'all' ? '?category=' + encodeURIComponent(category) : '');
                const res = await fetch(url);
                const d = await res.json();
                allScenariosList = d.scenarios || [];
                renderScenariosList();
            } catch(e) {
                box.innerHTML = '<div style="color:#EF4444; padding:12px;">Failed to load scenarios: ' + e + '</div>';
            }
        }

        function filterScenarios(cat) {
            loadScenarioQuestions(cat);
        }

        function renderScenariosList() {
            const box = document.getElementById('careerScenariosContainer');
            if (!box) return;
            let html = '';
            allScenariosList.forEach((q, idx) => {
                html += `
                <div class="panel-card" style="background:#0F172A; border:1px solid #263354; border-radius:10px; padding:16px;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                        <div style="font-size:12px; color:#38BDF8; font-weight:700; text-transform:uppercase;">
                            Scenario ${idx+1} &bull; ${q.category}
                        </div>
                        <span class="badge" style="background:#1E293B; border:1px solid #38BDF8; color:#38BDF8; font-size:10px;">4 YRS SENIOR LEVEL</span>
                    </div>
                    <div style="font-size:13.5px; font-weight:700; color:#F8FAFC; margin-bottom:12px; line-height:1.5;">
                        ${q.scenario}
                    </div>
                    <div style="background:#070B16; border:1px solid #1E293B; border-radius:8px; padding:14px; margin-bottom:10px;">
                        <div style="font-size:11px; font-weight:700; color:#10B981; margin-bottom:6px;">PROVEN ARCHITECTURAL SOLUTION &amp; EXPLANATION:</div>
                        <pre style="white-space:pre-wrap; font-family:'Segoe UI', sans-serif; font-size:12px; color:#E2E8F0; line-height:1.6; margin:0;">${q.in_depth_answer}</pre>
                    </div>
                    <div style="font-size:11.5px; color:#F59E0B; background:rgba(245,158,11,0.1); padding:8px 12px; border-radius:6px; border-left:3px solid #F59E0B;">
                        <b>💡 Interviewer Strategy Tip:</b> ${q.interviewer_tip}
                    </div>
                </div>`;
            });
            box.innerHTML = html;
        }

        async function loadStudyCatalog() {
            try {
                const res = await fetch('/api/career/study-materials');
                const d = await res.json();
                
                // Books
                const booksBox = document.getElementById('studyBooksContainer');
                if (booksBox && d.books) {
                    let bHtml = '';
                    d.books.forEach(b => {
                        bHtml += `
                        <div style="background:#0F172A; border:1px solid #263354; border-radius:8px; padding:12px;">
                            <strong style="font-size:13px; color:#38BDF8;">${b.title}</strong>
                            <div style="font-size:11px; color:#94A3B8;">by ${b.author}</div>
                            <div style="font-size:11.5px; color:#E2E8F0; margin:6px 0;">${b.key_focus_4yr}</div>
                            <div style="font-size:10.5px; color:#64748B;">Core Chapters: ${b.core_chapters.join(' &bull; ')}</div>
                        </div>`;
                    });
                    booksBox.innerHTML = bHtml;
                }

                // Shorts
                const shortsBox = document.getElementById('studyShortsContainer');
                if (shortsBox && d.concept_shorts) {
                    let sHtml = '';
                    d.concept_shorts.forEach(s => {
                        sHtml += `
                        <div style="background:#090E1A; border:1px solid #1E293B; border-left:3px solid #10B981; border-radius:6px; padding:10px;">
                            <b style="font-size:12px; color:#10B981;">⚡ ${s.title}</b>
                            <div style="font-size:11.5px; color:#CBD5E1; margin-top:4px;">${s.concept}</div>
                        </div>`;
                    });
                    shortsBox.innerHTML = sHtml;
                }

                // Schedule
                const schedBox = document.getElementById('studyScheduleContainer');
                if (schedBox && d.study_schedule_7days) {
                    let scHtml = '';
                    d.study_schedule_7days.forEach(item => {
                        scHtml += `
                        <div style="background:#0F172A; border:1px solid #263354; border-radius:8px; padding:10px; display:flex; gap:12px; align-items:center;">
                            <div style="width:50px; text-align:center; background:#1E293B; border-radius:6px; padding:6px 0; font-weight:800; font-size:11.5px; color:#F59E0B;">
                                ${item.day}
                            </div>
                            <div style="flex:1;">
                                <strong style="font-size:12.5px; color:#F8FAFC;">${item.focus}</strong>
                                <div style="font-size:11px; color:#94A3B8;">${item.topics}</div>
                            </div>
                        </div>`;
                    });
                    schedBox.innerHTML = scHtml;
                }
            } catch(e) {
                logLocal('CareerHub', 'Error loading study catalog: ' + e);
            }
        }

