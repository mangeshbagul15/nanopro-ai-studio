let pixelOfficeZoom = 1.0;
let pixelOfficeAnimRunning = true;
let pixelOfficeAnimFrameId = null;
let hoveredStationId = null;
let selectedStationId = "agent_01";
let pixelAnimCounter = 0;

function initPixelOffice() {
    const canvas = document.getElementById('pixelOfficeCanvas');
    if (!canvas) return;

    canvas.addEventListener('mousemove', onPixelCanvasMouseMove);
    canvas.addEventListener('mouseleave', () => {
        hoveredStationId = null;
        const tt = document.getElementById('pixelOfficeTooltip');
        if (tt) tt.style.display = 'none';
    });
    canvas.addEventListener('click', onPixelCanvasClick);

    // Initial drawer setup with Manager Agent
    selectPixelAgent("agent_01");

    if (!pixelOfficeAnimFrameId) {
        runPixelOfficeLoop();
    }
}

function runPixelOfficeLoop() {
    if (pixelOfficeAnimRunning) {
        pixelAnimCounter++;
        const canvas = document.getElementById('pixelOfficeCanvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            if (ctx) {
                drawPixelOffice(ctx, canvas);
            }
        }
    }
    pixelOfficeAnimFrameId = requestAnimationFrame(runPixelOfficeLoop);
}

function drawPixelOffice(ctx, canvas) {
    ctx.imageSmoothingEnabled = false;
    ctx.save();
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Apply zoom centering
    if (pixelOfficeZoom !== 1.0) {
        ctx.translate(canvas.width / 2, canvas.height / 2);
        ctx.scale(pixelOfficeZoom, pixelOfficeZoom);
        ctx.translate(-canvas.width / 2, -canvas.height / 2);
    }

    // 1. Floor & Walls
    // Back Wall (Top 75px)
    ctx.fillStyle = "#0A0F1D";
    ctx.fillRect(0, 0, canvas.width, 75);

    // City Skyline Windows (x: 50..180, x: 420..600, x: 820..950)
    drawPixelWindow(ctx, 40, 15, 140, 45);
    drawPixelWindow(ctx, 430, 15, 160, 45);
    drawPixelWindow(ctx, 830, 15, 140, 45);

    // Wood Baseboard
    ctx.fillStyle = "#3D2411";
    ctx.fillRect(0, 72, canvas.width, 4);

    // Checkered Retro Parquet Floor (32x32 tiles)
    const tileSize = 32;
    for (let x = 0; x < canvas.width; x += tileSize) {
        for (let y = 76; y < canvas.height; y += tileSize) {
            const isAlt = ((x / tileSize) + (y / tileSize)) % 2 === 0;
            ctx.fillStyle = isAlt ? "#151B2E" : "#111626";
            ctx.fillRect(x, y, tileSize, tileSize);
            ctx.strokeStyle = "#1A2238";
            ctx.lineWidth = 1;
            ctx.strokeRect(x, y, tileSize, tileSize);
        }
    }

    // Wall Clock
    drawPixelClock(ctx, 330, 35);
    // Bulletin / Whiteboard
    drawPixelWhiteboard(ctx, 690, 20);

    // Break Area (Water Cooler & Coffee Machine)
    drawWaterCoolerArea(ctx, 470, 235);

    // Conference Meeting Table (Center Bottom)
    drawConferenceTable(ctx, 420, 365);

    // Server Rack (Beside Data Engineering Bay)
    drawServerRack(ctx, 30, 95);

    // 2. Draw 10 Workstations & Animated Agents
    PIXEL_WORKSTATIONS.forEach(ws => {
        drawSingleWorkstation(ctx, ws);
    });

    ctx.restore();
}

function drawPixelWindow(ctx, x, y, w, h) {
    // Window frame
    ctx.fillStyle = "#1E293B";
    ctx.fillRect(x, y, w, h);
    // Night sky
    ctx.fillStyle = "#030712";
    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);
    // Distant city buildings
    ctx.fillStyle = "#0F172A";
    ctx.fillRect(x + 8, y + 15, 24, h - 17);
    ctx.fillRect(x + 36, y + 8, 28, h - 10);
    ctx.fillRect(x + 68, y + 20, 20, h - 22);
    ctx.fillRect(x + 92, y + 12, 32, h - 14);
    // Glowing skyscraper windows
    ctx.fillStyle = (pixelAnimCounter % 80 < 40) ? "#FDE047" : "#38BDF8";
    ctx.fillRect(x + 14, y + 22, 3, 3);
    ctx.fillRect(x + 42, y + 16, 3, 3);
    ctx.fillRect(x + 50, y + 26, 3, 3);
    ctx.fillRect(x + 102, y + 20, 3, 3);
    // Window panes
    ctx.strokeStyle = "#1E293B";
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, w, h);
    ctx.beginPath();
    ctx.moveTo(x + w / 2, y);
    ctx.lineTo(x + w / 2, y + h);
    ctx.stroke();
}

function drawPixelClock(ctx, x, y) {
    ctx.fillStyle = "#F8FAFC";
    ctx.beginPath();
    ctx.arc(x, y, 12, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "#1E293B";
    ctx.lineWidth = 2;
    ctx.stroke();
    // Clock hands
    ctx.strokeStyle = "#0F172A";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x, y - 6);
    ctx.moveTo(x, y);
    const secAngle = (pixelAnimCounter * 0.05) % (Math.PI * 2);
    ctx.lineTo(x + Math.cos(secAngle) * 7, y + Math.sin(secAngle) * 7);
    ctx.stroke();
}

function drawPixelWhiteboard(ctx, x, y) {
    ctx.fillStyle = "#E2E8F0";
    ctx.fillRect(x, y, 65, 36);
    ctx.strokeStyle = "#64748B";
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, 65, 36);
    // Diagram lines
    ctx.strokeStyle = "#0284C7";
    ctx.lineWidth = 1;
    ctx.strokeRect(x + 6, y + 8, 12, 8);
    ctx.strokeRect(x + 26, y + 8, 12, 8);
    ctx.strokeRect(x + 46, y + 8, 12, 8);
    ctx.beginPath();
    ctx.moveTo(x + 18, y + 12);
    ctx.lineTo(x + 26, y + 12);
    ctx.moveTo(x + 38, y + 12);
    ctx.lineTo(x + 46, y + 12);
    ctx.stroke();
    // Small text lines
    ctx.fillStyle = "#10B981";
    ctx.fillRect(x + 8, y + 24, 48, 2);
}

function drawServerRack(ctx, x, y) {
    ctx.fillStyle = "#0F172A";
    ctx.fillRect(x, y, 42, 70);
    ctx.strokeStyle = "#334155";
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, 42, 70);
    for (let i = 0; i < 5; i++) {
        const sy = y + 8 + i * 12;
        ctx.fillStyle = "#1E293B";
        ctx.fillRect(x + 4, sy, 34, 8);
        // Blinking LEDs
        ctx.fillStyle = (pixelAnimCounter + i * 15) % 30 < 15 ? "#10B981" : "#059669";
        ctx.fillRect(x + 8, sy + 3, 3, 3);
        ctx.fillStyle = (pixelAnimCounter + i * 20) % 40 < 20 ? "#38BDF8" : "#0284C7";
        ctx.fillRect(x + 14, sy + 3, 3, 3);
        ctx.fillStyle = (pixelAnimCounter + i * 25) % 50 < 25 ? "#EF4444" : "#991B1B";
        ctx.fillRect(x + 20, sy + 3, 3, 3);
    }
}

function drawWaterCoolerArea(ctx, x, y) {
    // Water cooler stand
    ctx.fillStyle = "#CBD5E1";
    ctx.fillRect(x, y + 20, 24, 40);
    ctx.strokeStyle = "#94A3B8";
    ctx.strokeRect(x, y + 20, 24, 40);
    // Blue bottle
    ctx.fillStyle = "rgba(56, 189, 248, 0.75)";
    ctx.fillRect(x + 4, y, 16, 20);
    // Dispenser spigots
    ctx.fillStyle = "#EF4444";
    ctx.fillRect(x + 6, y + 32, 4, 3);
    ctx.fillStyle = "#38BDF8";
    ctx.fillRect(x + 14, y + 32, 4, 3);
    // Potted plant next to cooler
    ctx.fillStyle = "#78350F";
    ctx.fillRect(x + 36, y + 42, 18, 18);
    ctx.fillStyle = "#15803D";
    ctx.beginPath();
    ctx.arc(x + 45, y + 34, 14, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = "#16A34A";
    ctx.beginPath();
    ctx.arc(x + 42, y + 28, 8, 0, Math.PI * 2);
    ctx.fill();
}

function drawConferenceTable(ctx, x, y) {
    // Shadow
    ctx.fillStyle = "rgba(0,0,0,0.3)";
    ctx.fillRect(x + 6, y + 20, 168, 50);
    // Table
    ctx.fillStyle = "#78350F";
    ctx.fillRect(x + 10, y + 16, 160, 44);
    ctx.strokeStyle = "#92400E";
    ctx.lineWidth = 2;
    ctx.strokeRect(x + 10, y + 16, 160, 44);
    // Chairs around table
    const chairs = [
        { cx: x + 30, cy: y + 4 },
        { cx: x + 80, cy: y + 4 },
        { cx: x + 130, cy: y + 4 },
        { cx: x + 30, cy: y + 64 },
        { cx: x + 80, cy: y + 64 },
        { cx: x + 130, cy: y + 64 }
    ];
    chairs.forEach(ch => {
        ctx.fillStyle = "#1E293B";
        ctx.fillRect(ch.cx, ch.cy, 18, 12);
        ctx.fillStyle = "#334155";
        ctx.fillRect(ch.cx + 2, ch.cy + 2, 14, 8);
    });
    // Table items (water glasses, notepad)
    ctx.fillStyle = "#F8FAFC";
    ctx.fillRect(x + 50, y + 26, 12, 16);
    ctx.fillStyle = "rgba(56,189,248,0.7)";
    ctx.fillRect(x + 100, y + 28, 6, 8);
}

function drawSingleWorkstation(ctx, ws) {
    const isHovered = hoveredStationId === ws.id;
    const isSelected = selectedStationId === ws.id;
    const isWorking = ws.state === "Running" || ws.state === "Assigned" || ws.state === "Working";
    const isThinking = ws.state === "Thinking";

    // 1. Desk Base & Shadow
    ctx.fillStyle = "rgba(0,0,0,0.35)";
    ctx.fillRect(ws.x + 4, ws.y + ws.h - 10, ws.w - 8, 14);

    // Desk Table Top
    ctx.fillStyle = ws.deskColor;
    ctx.fillRect(ws.x, ws.y + 24, ws.w, 42);
    ctx.strokeStyle = isSelected ? "#FDE047" : (isHovered ? "#38BDF8" : "#1E293B");
    ctx.lineWidth = isSelected ? 2 : 1.5;
    ctx.strokeRect(ws.x, ws.y + 24, ws.w, 42);

    // 2. Computer Monitors
    const monW = ws.deskType === "executive" ? 36 : 28;
    const monH = 22;
    const monX = ws.x + (ws.w - monW) / 2;
    const monY = ws.y + 12;

    // Monitor Stand
    ctx.fillStyle = "#475569";
    ctx.fillRect(monX + monW / 2 - 2, monY + monH, 4, 6);
    ctx.fillRect(monX + monW / 2 - 8, monY + monH + 6, 16, 3);

    // Monitor Bezel
    ctx.fillStyle = "#0F172A";
    ctx.fillRect(monX, monY, monW, monH);
    ctx.strokeStyle = "#334155";
    ctx.strokeRect(monX, monY, monW, monH);

    // Monitor Screen Active Glow
    let screenGlow = "#0284C7";
    if (ws.deskType === "engineering") screenGlow = "#059669";
    if (ws.deskType === "python") screenGlow = "#D97706";
    if (ws.deskType === "security") screenGlow = "#DC2626";
    if (ws.deskType === "analytics") screenGlow = "#7C3AED";
    if (ws.deskType === "testing") screenGlow = "#0D9488";

    ctx.fillStyle = isWorking ? screenGlow : "#090D1A";
    ctx.fillRect(monX + 2, monY + 2, monW - 4, monH - 4);

    // Dynamic screen code / graph pixels
    if (isWorking) {
        ctx.fillStyle = "#F8FAFC";
        const tick = Math.floor(pixelAnimCounter / 8) % 4;
        ctx.fillRect(monX + 4, monY + 4 + tick * 3, monW - 8, 2);
        ctx.fillRect(monX + 4, monY + 6, 8, 2);
        ctx.fillRect(monX + 14, monY + 12, 10, 2);
    }

    // Second Monitor (For Executive & Engineering & ML)
    if (ws.deskType === "executive" || ws.deskType === "engineering" || ws.deskType === "ml_lab") {
        const sideMonX = monX + monW + 4;
        if (sideMonX + 18 <= ws.x + ws.w - 4) {
            ctx.fillStyle = "#0F172A";
            ctx.fillRect(sideMonX, monY + 2, 18, 18);
            ctx.fillStyle = isWorking ? "#10B981" : "#090D1A";
            ctx.fillRect(sideMonX + 2, monY + 4, 14, 14);
        }
    }

    // Keyboard & Mouse
    ctx.fillStyle = "#1E293B";
    ctx.fillRect(monX + 2, ws.y + 46, monW - 4, 8);
    ctx.fillStyle = "#475569";
    ctx.fillRect(monX + monW + 2, ws.y + 48, 5, 5);

    // Coffee Mug on desk
    ctx.fillStyle = "#E2E8F0";
    ctx.fillRect(ws.x + 8, ws.y + 40, 6, 7);
    ctx.fillStyle = "#B45309";
    ctx.fillRect(ws.x + 9, ws.y + 41, 4, 2);

    // 3. Pixel Agent Character (Sitting Behind / Beside Desk)
    // Vertical breathing bob
    const bob = (isWorking || isThinking) ? (Math.floor(pixelAnimCounter / 20) % 2) : (Math.floor(pixelAnimCounter / 35) % 2);
    const charX = ws.x + (ws.w / 2) - 8;
    const charY = ws.y - 2 + bob;

    // Chair Back
    ctx.fillStyle = "#1E293B";
    ctx.fillRect(charX - 4, charY - 2, 24, 28);

    // Torso / Suit
    ctx.fillStyle = ws.suitColor;
    ctx.fillRect(charX, charY + 10, 16, 14);

    // Head / Face
    ctx.fillStyle = "#FDE68A"; // Skin
    ctx.fillRect(charX + 2, charY + 2, 12, 10);

    // Hair
    ctx.fillStyle = ws.hairColor;
    ctx.fillRect(charX + 1, charY, 14, 5);
    ctx.fillRect(charX, charY + 2, 3, 4);

    // Eyes
    ctx.fillStyle = "#0F172A";
    ctx.fillRect(charX + 4, charY + 6, 2, 2);
    ctx.fillRect(charX + 9, charY + 6, 2, 2);

    // Typing Hands Animation (moving up and down)
    ctx.fillStyle = "#FDE68A";
    const handAlt = (pixelAnimCounter % 16 < 8);
    ctx.fillRect(charX - 2, ws.y + 42 + (handAlt ? 1 : 0), 4, 4);
    ctx.fillRect(charX + 14, ws.y + 42 + (handAlt ? 0 : 1), 4, 4);

    // 4. Above Character: Status Badge & Name Tag
    // Name Tag
    ctx.fillStyle = "rgba(11,17,32,0.85)";
    ctx.fillRect(ws.x + (ws.w / 2) - 36, ws.y - 18, 72, 13);
    ctx.strokeStyle = ws.color;
    ctx.lineWidth = 1;
    ctx.strokeRect(ws.x + (ws.w / 2) - 36, ws.y - 18, 72, 13);

    ctx.fillStyle = "#F8FAFC";
    ctx.font = "8px monospace";
    ctx.textAlign = "center";
    ctx.fillText(ws.name.replace(" Agent", ""), ws.x + (ws.w / 2), ws.y - 8);

    // Status Indicator Beacon (Glowing LED)
    let stateColor = "#64748B"; // Idle
    if (isWorking) stateColor = "#10B981";
    else if (isThinking) stateColor = "#A855F7";
    else if (ws.state === "Waiting" || ws.state.includes("Approval")) stateColor = "#F59E0B";

    ctx.fillStyle = stateColor;
    ctx.beginPath();
    ctx.arc(ws.x + ws.w - 10, ws.y + 14, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "#FFFFFF";
    ctx.lineWidth = 1;
    ctx.stroke();

    // Thought Bubble if Thinking
    if (isThinking) {
        ctx.fillStyle = "#F8FAFC";
        ctx.fillRect(charX + 16, charY - 8, 12, 10);
        ctx.fillRect(charX + 13, charY - 4, 3, 3);
        ctx.fillStyle = "#9333EA";
        ctx.font = "8px monospace";
        ctx.fillText("?", charX + 22, charY);
    }

    // Selection or Hover Bracket Highlight
    if (isHovered || isSelected) {
        const bracketColor = isSelected ? "#FDE047" : "#38BDF8";
        ctx.strokeStyle = bracketColor;
        ctx.lineWidth = 2;
        const bLen = 8;
        // Top-left
        ctx.beginPath();
        ctx.moveTo(ws.x - 4, ws.y + bLen);
        ctx.lineTo(ws.x - 4, ws.y - 4);
        ctx.lineTo(ws.x - 4 + bLen, ws.y - 4);
        ctx.stroke();
        // Top-right
        ctx.beginPath();
        ctx.moveTo(ws.x + ws.w + 4 - bLen, ws.y - 4);
        ctx.lineTo(ws.x + ws.w + 4, ws.y - 4);
        ctx.lineTo(ws.x + ws.w + 4, ws.y + bLen);
        ctx.stroke();
        // Bottom-left
        ctx.beginPath();
        ctx.moveTo(ws.x - 4, ws.y + ws.h + 4 - bLen);
        ctx.lineTo(ws.x - 4, ws.y + ws.h + 4);
        ctx.lineTo(ws.x - 4 + bLen, ws.y + ws.h + 4);
        ctx.stroke();
        // Bottom-right
        ctx.beginPath();
        ctx.moveTo(ws.x + ws.w + 4 - bLen, ws.y + ws.h + 4);
        ctx.lineTo(ws.x + ws.w + 4, ws.y + ws.h + 4);
        ctx.lineTo(ws.x + ws.w + 4, ws.y + ws.h + 4 - bLen);
        ctx.stroke();
    }
}

function onPixelCanvasMouseMove(e) {
    const canvas = document.getElementById('pixelOfficeCanvas');
    if (!canvas) return;

    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;

    let mx = (e.clientX - rect.left) * scaleX;
    let my = (e.clientY - rect.top) * scaleY;

    if (pixelOfficeZoom !== 1.0) {
        mx = (mx - canvas.width / 2) / pixelOfficeZoom + canvas.width / 2;
        my = (my - canvas.height / 2) / pixelOfficeZoom + canvas.height / 2;
    }

    let found = null;
    for (const ws of PIXEL_WORKSTATIONS) {
        if (mx >= ws.x - 4 && mx <= ws.x + ws.w + 4 &&
            my >= ws.y - 18 && my <= ws.y + ws.h + 4) {
            found = ws;
            break;
        }
    }

    const tooltip = document.getElementById('pixelOfficeTooltip');
    if (found) {
        hoveredStationId = found.id;
        canvas.style.cursor = 'pointer';
        if (tooltip) {
            tooltip.style.display = 'block';
            tooltip.style.left = (e.clientX - rect.left + 14) + 'px';
            tooltip.style.top = (e.clientY - rect.top + 14) + 'px';
            tooltip.innerHTML = `
                <div style="font-weight:700; color:#38BDF8;">${escapeHtml(found.name)}</div>
                <div style="font-size:10px; color:#94A3B8;">${escapeHtml(found.role)}</div>
                <div style="font-size:10px; color:#10B981; margin-top:2px;">Status: <strong>${escapeHtml(found.state.toUpperCase())}</strong></div>
                <div style="font-size:9.5px; color:#CBD5E1; margin-top:1px;">Task: ${escapeHtml(found.current_task || found.defaultTask)}</div>
            `;
        }
    } else {
        hoveredStationId = null;
        canvas.style.cursor = 'default';
        if (tooltip) tooltip.style.display = 'none';
    }
}

function onPixelCanvasClick(e) {
    if (hoveredStationId) {
        selectPixelAgent(hoveredStationId);
    }
}

function selectPixelAgent(agentId) {
    selectedStationId = agentId;
    const ws = PIXEL_WORKSTATIONS.find(w => w.id === agentId);
    if (!ws) return;

    const drawer = document.getElementById('pixelAgentDetailDrawer');
    if (drawer) drawer.style.display = 'block';

    const avatarEl = document.getElementById('padAgentAvatar');
    if (avatarEl) {
        const avatars = {
            "agent_01": "👑", "agent_06": "👷", "agent_18": "❄️",
            "agent_39": "🐍", "agent_23": "📊", "agent_25": "🧠",
            "agent_33": "🔍", "agent_05": "🧪", "agent_35": "🛡️",
            "agent_41": "📝"
        };
        avatarEl.innerText = avatars[ws.id] || "🤖";
    }

    const nameEl = document.getElementById('padAgentName');
    if (nameEl) nameEl.innerText = ws.name;

    const roleEl = document.getElementById('padAgentRole');
    if (roleEl) roleEl.innerText = ws.role;

    const badgeEl = document.getElementById('padAgentStatusBadge');
    if (badgeEl) {
        badgeEl.innerText = ws.state.toUpperCase();
        badgeEl.className = 'pixel-status-badge ' + (ws.state === 'Running' ? 'working' : 'idle');
    }

    const taskEl = document.getElementById('padAgentTask');
    if (taskEl) taskEl.innerText = ws.current_task || ws.defaultTask;

    const areaEl = document.getElementById('padAgentArea');
    if (areaEl) areaEl.innerText = ws.area;

    const modelEl = document.getElementById('padAgentModel');
    if (modelEl) modelEl.innerText = ws.model + " (Local Ollama Engine)";

    const toolsEl = document.getElementById('padAgentTools');
    if (toolsEl) toolsEl.innerText = ws.tools;

    const pBar = document.getElementById('padAgentProgressBar');
    const pPct = document.getElementById('padAgentProgressPct');
    const pct = ws.progress_pct || (ws.state === 'Running' ? 65 : (ws.state === 'Completed' ? 100 : 0));
    if (pBar) pBar.style.width = pct + '%';
    if (pPct) pPct.innerText = pct + '%';
}

function closePixelAgentDrawer() {
    const drawer = document.getElementById('pixelAgentDetailDrawer');
    if (drawer) drawer.style.display = 'none';
}

function talkToManagerAboutAgent() {
    const ws = PIXEL_WORKSTATIONS.find(w => w.id === selectedStationId);
    if (!ws) return;
    switchView('ai_manager');
    quickFillPrompt(`What is ${ws.name} currently working on?`);
}

async function promptAssignTaskToAgent() {
    const ws = PIXEL_WORKSTATIONS.find(w => w.id === selectedStationId);
    if (!ws) return;
    const task = prompt(`Enter new task for ${ws.name}:`, `Run analytical verification on BANK_DB`);
    if (!task) return;

    try {
        const res = await fetch(`/api/agents/${ws.key || ws.id}/assign`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ task: task })
        });
        const d = await res.json();
        alert(`Task assigned to ${ws.name}!`);
        if (typeof refreshOfficeLiveState === 'function') refreshOfficeLiveState();
    } catch(err) {
        alert('Assignment Error: ' + err.message);
    }
}

async function togglePauseAgentFromDrawer() {
    const ws = PIXEL_WORKSTATIONS.find(w => w.id === selectedStationId);
    if (!ws) return;
    const isPaused = ws.state === "Paused";
    const action = isPaused ? "resume" : "pause";
    try {
        await fetch(`/api/agents/${ws.key || ws.id}/action/${action}`, { method: 'POST' });
        alert(`${ws.name} is now ${isPaused ? 'Resumed' : 'Paused'}.`);
        if (typeof refreshOfficeLiveState === 'function') refreshOfficeLiveState();
    } catch(err) {
        alert('Action Error: ' + err.message);
    }
}

function zoomPixelOffice(factor) {
    pixelOfficeZoom = Math.max(0.7, Math.min(2.0, pixelOfficeZoom * factor));
}

function resetPixelOfficeZoom() {
    pixelOfficeZoom = 1.0;
}

function togglePixelOfficeFullscreen() {
    const vp = document.getElementById('pixelOfficeViewport');
    if (!vp) return;
    if (!document.fullscreenElement) {
        vp.requestFullscreen().catch(() => {});
    } else {
        document.exitFullscreen().catch(() => {});
    }
}

function togglePixelOfficeAnim() {
    pixelOfficeAnimRunning = !pixelOfficeAnimRunning;
    const btn = document.getElementById('btnPixelAnimToggle');
    if (btn) {
        btn.innerText = pixelOfficeAnimRunning ? "⏸ Pause" : "▶ Resume";
    }
}

function updatePixelOfficeAgents(agents) {
    if (!agents || !Array.isArray(agents)) return;
    agents.forEach(a => {
        const ws = PIXEL_WORKSTATIONS.find(w => w.id === a.agent_id || w.name.toLowerCase() === (a.name || '').toLowerCase() || w.key === a.agent_id);
        if (ws) {
            ws.state = a.state || "Idle";
            ws.current_task = a.current_task || "";
            ws.progress_pct = a.progress_pct || 0;
            ws.duration_sec = a.duration_sec || 0;
            if (a.model) ws.model = a.model;
        }
    });

    if (selectedStationId) {
        selectPixelAgent(selectedStationId);
    }
}

</script>
</body>
</html>
'''
