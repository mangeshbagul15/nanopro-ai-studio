        function logLocal(comp, msg) {
            const time = new Date().toTimeString().split(' ')[0];
            const line = '[' + time + '] [' + comp + '] ' + msg;
            const el1 = document.getElementById('rightLogsStream');
            const el2 = document.getElementById('fullLogsBox');
            if (el1) { el1.innerText += '\n' + line; el1.scrollTop = el1.scrollHeight; }
            if (el2) { el2.innerText += '\n' + line; el2.scrollTop = el2.scrollHeight; }
            fetch('/api/logs/log', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ component: comp, message: msg })
            }).catch(e => {});
        }

        let navigationHistory = [];
        let historyIndex = -1;
        let isNavigatingHistory = false;

        function switchView(viewName, skipHistoryPush = false) {
            if (!viewName) return;
            logLocal('Navigation', 'Switched center workspace to: ' + viewName);
            currentActiveView = viewName;

            // Highlight sidebar nav item
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('active');
                if (el.getAttribute('onclick') && el.getAttribute('onclick').includes("'" + viewName + "'")) {
                    el.classList.add('active');
                }
            });

            // Activate workspace view
            document.querySelectorAll('.workspace-view').forEach(v => v.classList.remove('active'));
            const targetView = document.getElementById('view-' + viewName);
            if (targetView) {
                targetView.classList.add('active');
            }

            // Update Browser History and In-App Navigation Stack
            if (!skipHistoryPush && !isNavigatingHistory) {
                if (historyIndex < navigationHistory.length - 1) {
                    navigationHistory = navigationHistory.slice(0, historyIndex + 1);
                }
                navigationHistory.push(viewName);
                historyIndex = navigationHistory.length - 1;
                window.history.pushState({ view: viewName }, '', '#' + viewName);
            }
            updateHistoryButtons();

