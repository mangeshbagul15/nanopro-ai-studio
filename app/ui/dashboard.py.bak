        async function runDataAnalystReport() {
            const outEl = (document.getElementById('analystChartContainer') || document.getElementById('analystSqlInput'));
            outEl.innerText = 'Compiling executive data quality report...';
            try {
                const res = await fetch('/api/data_analyst/report');
                const d = await res.json();
                outEl.innerText = d.summary_markdown || JSON.stringify(d, null, 2);
            } catch (e) {
                outEl.innerText = 'Report Error: ' + e.message;
            }
        }

        /* --- FILE CONVERTER --- */
        async function executeFileConvert() {
            const p = document.getElementById('convSourcePath').value.trim();
            const fmt = document.getElementById('convTargetFmt').value;
            const dedup = document.getElementById('convDedupCheck').checked;
            const outEl = document.getElementById('convOutput');
            outEl.innerText = `Converting to ${fmt.toUpperCase()}...`;
            logLocal('FileConverter', `Converting file to: ${fmt}`);
            try {
                const res = await fetch('/api/converter/convert', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ source_path: p, target_format: fmt, remove_duplicates: dedup })
                });
                const d = await res.json();
                outEl.innerText = JSON.stringify(d, null, 2);
            } catch (e) {
                outEl.innerText = 'Conversion Error: ' + e.message;
            }
        }

