                <div class="office-floor" id="dashOfficeFloor">
                    <!-- Dynamic stations injected here -->
                </div>
            </div>

            <!-- Output Preview -->
            <div class="panel-card">
                <h2>Manager Deliverable &amp; Execution Output <button type="button" class="btn btn-secondary" onclick="copyViewer('dashOutput')" style="font-size:11px; padding:3px 10px;">Copy</button></h2>
                <div class="viewer-box" id="dashOutput">Awaiting instructions. Select an agent from the left sidebar or execute a command above.</div>
            </div>
        </div>

        <!-- VIEW: SQL VIDEO MAKER -->
        <div class="workspace-view" id="view-sql_video">
            <div class="panel-card">
                <h2>SQL Video Creation Workspace</h2>
                <label class="input-label">SQL Interview Question / Topic</label>
                <textarea class="studio-input" id="sqlQuestion" rows="2" placeholder="e.g. Find customers who have never made a transaction using LEFT JOIN."></textarea>
                
                <label class="input-label" style="margin-top:10px;">SQL Query &amp; Table Schema</label>
                <textarea class="studio-input code-editor" id="sqlQueryLogic" rows="4" placeholder="SELECT c.CUSTOMER_ID, c.NAME FROM CUSTOMERS c LEFT JOIN TRANSACTIONS t ON c.CUSTOMER_ID = t.CUSTOMER_ID WHERE t.CUSTOMER_ID IS NULL;"></textarea>

                <!-- Local Audio Browse Integration -->
                <div class="audio-controls-box">
                    <div style="font-size:12px; font-weight:700; color:var(--accent-blue);">LOCAL AUDIO BROWSE &amp; DURATION SYNCHRONIZATION</div>
                    <div class="audio-row">
                        <button type="button" class="btn btn-secondary" id="sqlAudioToggle" onclick="toggleAudio('sql')">Audio: OFF</button>
                        <input type="file" id="sqlAudioFileInput" accept=".mp3,.wav,.aac,.m4a" style="display:none;" onchange="handleAudioFileSelect('sql', this)" />
                        <button type="button" class="btn btn-primary" onclick="document.getElementById('sqlAudioFileInput').click()">&#128194; Browse Audio File</button>
                        <input type="text" class="studio-input" id="sqlAudioPath" placeholder="Selected local audio file path..." style="flex:1; font-size:12px;" />
                        <button type="button" class="btn btn-secondary" onclick="probeAudio('sql')">Probe Duration</button>
                    </div>
                    <div class="audio-row" style="font-size:12px; color:var(--text-muted);">
                        <span>Volume: <input type="range" id="sqlAudioVol" min="0" max="1" step="0.1" value="0.5" style="vertical-align:middle;"></span>
                        <span id="sqlAudioDurDisplay">Audio Duration: --</span>
                        <span>Fallback: <select class="studio-input" id="sqlAudioFallback" style="width:auto; padding:2px 8px; display:inline-block;"><option value="loop">Loop Shorter Audio</option><option value="silence">Pad with Silence</option></select></span>
                    </div>
                </div>

                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="generateVideo('sql')">&#9658; Create SQL Video</button>
                    <button type="button" class="btn btn-secondary" onclick="generateThumbnailMeta('sql')">Create 9:16 Thumbnail</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('sql', 'title')">Generate Title</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('sql', 'description')">Description</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('sql', 'tags')">Hashtags</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>SQL Video Status &amp; Deliverables <button type="button" class="btn btn-secondary" onclick="copyViewer('sqlOutput')" style="font-size:11px; padding:3px 10px;">Copy</button></h2>
                <div class="viewer-box" id="sqlOutput">No video rendering job initiated. Enter SQL problem above and click [Create SQL Video].</div>
            </div>
        </div>

        <!-- VIEW: PYTHON VIDEO MAKER -->
        <div class="workspace-view" id="view-python_video">
            <div class="panel-card">
                <h2>Python Video Creation Workspace</h2>
                <label class="input-label">Python Interview Concept / Question</label>
                <textarea class="studio-input" id="pyQuestion" rows="2" placeholder="e.g. Explain Python list comprehensions with three real-world examples."></textarea>
                
                <label class="input-label" style="margin-top:10px;">Python Code / Logic</label>
                <textarea class="studio-input code-editor" id="pyQueryLogic" rows="4" placeholder="numbers = [1, 2, 3, 4, 5]&#10;evens = [n for n in numbers if n % 2 == 0]&#10;print(evens)"></textarea>

                <!-- Local Audio Browse Integration -->
                <div class="audio-controls-box">
                    <div style="font-size:12px; font-weight:700; color:var(--accent-blue);">LOCAL AUDIO BROWSE &amp; DURATION SYNCHRONIZATION</div>
                    <div class="audio-row">
                        <button type="button" class="btn btn-secondary" id="pyAudioToggle" onclick="toggleAudio('python')">Audio: OFF</button>
                        <input type="file" id="pyAudioFileInput" accept=".mp3,.wav,.aac,.m4a" style="display:none;" onchange="handleAudioFileSelect('python', this)" />
                        <button type="button" class="btn btn-primary" onclick="document.getElementById('pyAudioFileInput').click()">&#128194; Browse Audio File</button>
                        <input type="text" class="studio-input" id="pyAudioPath" placeholder="Selected local audio file path..." style="flex:1; font-size:12px;" />
                        <button type="button" class="btn btn-secondary" onclick="probeAudio('python')">Probe Duration</button>
                    </div>
                    <div class="audio-row" style="font-size:12px; color:var(--text-muted);">
                        <span>Volume: <input type="range" id="pyAudioVol" min="0" max="1" step="0.1" value="0.5" style="vertical-align:middle;"></span>
                        <span id="pyAudioDurDisplay">Audio Duration: --</span>
                        <span>Fallback: <select class="studio-input" id="pyAudioFallback" style="width:auto; padding:2px 8px; display:inline-block;"><option value="loop">Loop Shorter Audio</option><option value="silence">Pad with Silence</option></select></span>
                    </div>
                </div>

                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="generateVideo('python')">&#9658; Create Python Video</button>
                    <button type="button" class="btn btn-secondary" onclick="generateThumbnailMeta('python')">Create 9:16 Thumbnail</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('python', 'title')">Generate Title</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('python', 'description')">Description</button>
                    <button type="button" class="btn btn-secondary" onclick="generateMeta('python', 'tags')">Hashtags</button>
                </div>
            </div>

            <div class="panel-card">
                <h2>Python Video Deliverables <button type="button" class="btn btn-secondary" onclick="copyViewer('pyOutput')" style="font-size:11px; padding:3px 10px;">Copy</button></h2>
                <div class="viewer-box" id="pyOutput">Ready to create Python educational video.</div>
            </div>
        </div>

        <!-- VIEW: IMAGE MAKER -->
        <div class="workspace-view" id="view-image_agent">
            <div class="panel-card">
                <h2>Image &amp; Thumbnail Generator Workspace</h2>
                <label class="input-label">Image Generation Prompt</label>
                <textarea class="studio-input" id="imgPrompt" rows="3" placeholder="e.g. Create a professional YouTube thumbnail for a SQL interview video about second-highest salary. Use navy blue, white, and grey with readable text."></textarea>
                
                <div class="btn-row" style="margin-top:10px;">
                    <div style="flex:1;">
                        <label class="input-label">Style Preset</label>
                        <select class="studio-input" id="imgStyle">
                            <option value="modern_tech">Modern Tech &amp; Programming</option>
                            <option value="youtube_vertical">YouTube Shorts Vertical 9:16</option>
                            <option value="corporate_dark">Corporate Dark Navy</option>
                            <option value="neon_cyber">Cyberpunk &amp; Glowing AI</option>
                        </select>
                    </div>
                    <div style="width:160px;">
                        <label class="input-label">Aspect Ratio</label>
