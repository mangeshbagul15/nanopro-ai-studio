            }

            if (secEl) {
                secEl.value = '';
                secEl.placeholder = 'Enter new password / secret to update';
                secEl.focus();
            }

            if (servEl) {
                servEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        let isRefreshingHealth = false;
        async function refreshConnectionHealthTable() {
            if (isRefreshingHealth) return;
            isRefreshingHealth = true;

            const tbody = document.getElementById('vaultHealthTableBody');
            const btn = document.querySelector('button[onclick="refreshConnectionHealthTable()"]');
            const origHtml = btn ? btn.innerHTML : '↺ Refresh Health Status';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '⏳ Refreshing...';
            }

            try {
                const res = await fetch('/api/connections/list', { headers: { 'Accept': 'application/json' } });
                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    if (tbody) tbody.innerHTML = `<tr><td colspan="8" style="padding:14px; text-align:center; color:#EF4444;">Server error (${res.status}): ${raw.slice(0, 100)}</td></tr>`;
                    return;
                }

                const connections = d.connections || [];
                if (!tbody) return;

                if (connections.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="padding:14px; text-align:center; color:var(--text-muted);">No connection profiles configured.</td></tr>';
                    return;
                }

                tbody.innerHTML = connections.map(c => {
                    let badgeColor = '#64748B';
                    let badgeBg = 'rgba(100,116,139,0.15)';
                    const st = c.current_status || 'Not Tested';

                    if (st === 'Connected') {
                        badgeColor = '#10B981';
                        badgeBg = 'rgba(16,185,129,0.15)';
                    } else if (st.includes('Failed') || st.includes('Unreachable') || st.includes('Denied') || st === 'Timed Out') {
                        badgeColor = '#EF4444';
                        badgeBg = 'rgba(239,68,68,0.15)';
                    } else if (st === 'Degraded' || st.includes('Warning') || st === 'Driver Missing') {
                        badgeColor = '#F59E0B';
                        badgeBg = 'rgba(245,158,11,0.15)';
                    } else if (st === 'Testing...') {
                        badgeColor = '#38BDF8';
                        badgeBg = 'rgba(56,189,248,0.15)';
                    }

                    // Sync top cards status badges if matching
                    if (c.connection_name === 'NANO_PRO_SNOWFLAKE') {
                        const b = document.getElementById('badgeSnowflakeStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'MY_ORACLE_XE_REMOTE') {
                        const b = document.getElementById('badgeOracleStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'GMAIL_SMTP') {
                        const b = document.getElementById('badgeGmailStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'AWS_S3_DATA_LAKE') {
                        const b = document.getElementById('badgeAwsStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'TELEGRAM_ALERTS') {
                        const b = document.getElementById('badgeTelegramStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'STUDIO_MEMORY_DB') {
                        const b = document.getElementById('badgeSqliteStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    } else if (c.connection_name === 'ORACLE_AWS_SNOWFLAKE_PIPELINE') {
                        const b = document.getElementById('badgeInteroperabilityStatus');
                        if (b) { b.innerText = st; b.style.color = badgeColor; b.style.background = badgeBg; }
                    }

                    const respTime = c.response_time_ms !== null && c.response_time_ms !== undefined ? `${c.response_time_ms} ms` : '—';
                    const lastErr = c.last_error ? `<span style="color:#EF4444;" title="${c.last_error}">${c.last_error.length > 35 ? c.last_error.slice(0, 35) + '...' : c.last_error}</span>` : '<span style="color:#10B981;">None</span>';
                    const activeCtx = c.target || c.user_role || '—';
                    const nextChk = c.next_health_check || 'On Demand';

                    return `
                        <tr style="border-bottom:1px solid #1E293B;">
                            <td style="padding:10px; font-weight:700; color:#E2E8F0;">${c.connection_name}</td>
                            <td style="padding:10px; color:#94A3B8;">${c.service_type}</td>
                            <td style="padding:10px; font-family:monospace; color:#38BDF8; font-size:11px;">${c.host_identifier}</td>
                            <td style="padding:10px;">
                                <span class="badge" style="background:${badgeBg}; color:${badgeColor}; font-weight:700; padding:3px 8px; border-radius:10px; font-size:11px;">
                                    ${st}
                                </span>
                            </td>
                            <td style="padding:10px; color:#E2E8F0; font-family:monospace;">${respTime}</td>
                            <td style="padding:10px; color:#94A3B8;">${activeCtx}</td>
                            <td style="padding:10px; font-size:11px;">${lastErr}</td>
                            <td style="padding:10px; color:#64748B; font-size:11px;">${nextChk}</td>
                        </tr>
                    `;
                }).join('');

            } catch (e) {
                if (tbody) tbody.innerHTML = `<tr><td colspan="8" style="padding:14px; text-align:center; color:#EF4444;">Failed to load health metrics: ${e.message || e}</td></tr>`;
            } finally {
                isRefreshingHealth = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }

        let isTestingSnowflake = false;
        async function testSnowflakeConnectionAction() {
            if (isTestingSnowflake) return;
            isTestingSnowflake = true;

            const btn = document.getElementById('btnTestSnowflake');
            const badge = document.getElementById('badgeSnowflakeStatus');
            const resultBox = document.getElementById('snowflakeTestResultBox');
            const origHtml = btn ? btn.innerHTML : '🔍 Test Snowflake Connection';

            if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Testing Snowflake...'; }
            if (badge) { badge.innerText = 'Testing...'; badge.style.color = '#38BDF8'; badge.style.background = 'rgba(56,189,248,0.15)'; }
            if (resultBox) {
                resultBox.style.display = 'block';
                resultBox.style.background = '#0F172A';
                resultBox.style.border = '1px solid #334155';
                resultBox.innerHTML = '<span class="spinner-sm"></span> Establishing real authenticated Snowflake connection to EGPKNWZ-XH53504...<br>• Verifying active user, role (ACCOUNTADMIN), and warehouse (COMPUTE_WH)...<br>• Verifying access to BANK_DB.L0_STAGING...';
            }

            try {
                const res = await fetch('/api/connections/test/snowflake', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });

                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    d = { success: false, status: 'Server Error', error_message: `Server returned non-JSON (${res.status}): ${raw.slice(0, 150)}` };
                }

                const isSuccess = d && (d.success === true || d.status === 'Connected');
                if (badge) {
                    badge.innerText = d.status || (isSuccess ? 'Connected' : 'Failed');
                    badge.style.color = isSuccess ? '#10B981' : '#EF4444';
                    badge.style.background = isSuccess ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
                }

                if (resultBox) {
                    let html = `<div style="font-weight:700; color:${isSuccess ? '#10B981' : '#EF4444'}; margin-bottom:6px;">
                        ${isSuccess ? '✅ Snowflake Connection & Verification Successful' : '❌ Snowflake Connection Test Result: ' + (d.status || 'Failed')}
                    </div>`;
                    html += `<div style="line-height:1.5; color:#CBD5E1;">
                        <div><strong>Account:</strong> ${d.account || 'EGPKNWZ-XH53504'}</div>
                        <div><strong>Active User / Role:</strong> ${d.active_user || d.user || 'mangeshbagul15'} (${d.active_role || d.role || 'ACCOUNTADMIN'})</div>
                        <div><strong>Warehouse:</strong> ${d.active_warehouse || d.warehouse || 'COMPUTE_WH'}</div>
                        <div><strong>Database & Schema:</strong> ${d.active_database || d.database || 'BANK_DB'}.${d.active_schema || d.schema || 'L0_STAGING'}</div>
                        <div><strong>Response Time:</strong> ${d.response_time_ms ? d.response_time_ms + ' ms' : '—'}</div>
                        <div><strong>Timestamp:</strong> ${d.timestamp || new Date().toLocaleString()}</div>
                    </div>`;

                    if (d.error_message) {
                        html += `<div style="margin-top:6px; color:#EF4444; font-size:11px; background:rgba(239,68,68,0.1); padding:6px; border-radius:4px;">
                            <strong>Error Details:</strong> ${d.error_message}
                        </div>`;
                    }
                    if (d.troubleshooting) {
                        html += `<div style="margin-top:6px; color:#F59E0B; font-size:11px; background:rgba(245,158,11,0.1); padding:6px; border-radius:4px;">
                            <strong>Troubleshooting:</strong> ${d.troubleshooting}
                        </div>`;
                    }
                    resultBox.innerHTML = html;
                }

                await refreshConnectionHealthTable();
            } catch (e) {
                if (resultBox) {
                    resultBox.innerHTML = `<div style="color:#EF4444;">❌ Network / Server Error: ${e.message || e}</div>`;
                }
            } finally {
                isTestingSnowflake = false;
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

        let isTestingOracle = false;
        async function testOracleConnectionAction(connectionName = 'MY_ORACLE_XE_REMOTE') {
            if (isTestingOracle) return;
            isTestingOracle = true;

            let btnId = 'btnTestOracle';
            let badgeId = 'badgeOracleStatus';
