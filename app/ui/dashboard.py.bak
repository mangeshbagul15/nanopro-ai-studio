        async function saveRepoToLibrary(name, url, descEncoded) {
            try {
                const desc = decodeURIComponent(descEncoded);
                const res = await fetch('/api/discovery/library/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        title: name,
                        category: 'github_project',
                        source_url: url,
                        summary: desc,
                        technical_requirements: 'Git, Python 3.10+',
                        tags: 'github, open_source, ai_tool',
                        is_favorite: true
                    })
                });
                const d = await res.json();
                alert('Saved ' + name + ' to AI Research Library!');
            } catch (err) {
                alert('Failed to save to library: ' + err);
            }
        }

        /* ========================================================
           CORE AI: AI RESEARCH LIBRARY JAVASCRIPT
           ======================================================== */
        async function loadResearchLibrary() {
            const container = document.getElementById('researchLibraryContainer');
            if (!container) return;
            const query = document.getElementById('librarySearchInput') ? document.getElementById('librarySearchInput').value : '';
            const category = document.getElementById('libraryCategorySelect') ? document.getElementById('libraryCategorySelect').value : 'All';
            const favoritesOnly = document.getElementById('libraryFavoritesOnly') ? document.getElementById('libraryFavoritesOnly').checked : false;

            try {
                const url = `/api/discovery/library?category=${encodeURIComponent(category)}&search=${encodeURIComponent(query)}&favorites_only=${favoritesOnly}`;
                const res = await fetch(url);
                const data = await res.json();
                renderResearchLibraryList(data.library || []);
            } catch (e) {
                container.innerHTML = '<div style="color:var(--accent-red);">Failed to load library: ' + e + '</div>';
            }
        }

        function renderResearchLibraryList(items) {
            const container = document.getElementById('researchLibraryContainer');
            if (!container) return;
            if (!items || items.length === 0) {
                container.innerHTML = '<div style="color:var(--text-muted); padding:20px;">No research items saved in this view. Use the discovery tools or click "+ Add Research Note" above.</div>';
                return;
            }

            container.innerHTML = items.map(item => `
                <div class="research-card">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <div>
                            <span style="font-size:10px; font-weight:700; color:#10B981; background:rgba(16,185,129,0.1); padding:2px 8px; border-radius:4px;">${item.category.toUpperCase()}</span>
                            <h3 style="font-size:14.5px; color:#F8FAFC; margin:6px 0 2px 0;">${item.title}</h3>
                            <a href="${item.source_url}" target="_blank" style="font-size:11.5px; color:#38BDF8; text-decoration:none;">${item.source_url}</a>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            <button type="button" class="btn btn-secondary" style="font-size:12px; padding:3px 8px;" onclick="toggleFavoriteLibraryItem('${item.resource_id}')">${item.is_favorite ? '⭐ Favorited' : '☆ Favorite'}</button>
                            <button type="button" class="btn btn-secondary" style="font-size:11px; padding:3px 8px; color:#EF4444;" onclick="deleteLibraryItem('${item.resource_id}')">Delete</button>
                        </div>
                    </div>
                    <p style="font-size:12.5px; color:#CBD5E1; margin:8px 0; white-space:pre-wrap;">${item.summary}</p>
                    <div style="background:#1E293B; padding:8px; border-radius:4px; font-size:11.5px; color:#94A3B8;">
                        <div><strong>Tech Specs:</strong> ${item.technical_requirements || 'Standard'}</div>
                        <div><strong>User Notes:</strong> ${item.user_notes || 'Verified by NanoPro Studio.'}</div>
                        <div><strong>Tags:</strong> <code>${item.tags}</code></div>
                    </div>
                </div>
            `).join('');
        }

        async function toggleFavoriteLibraryItem(resId) {
            await fetch(`/api/discovery/library/favorite/${resId}`, { method: 'POST' });
            loadResearchLibrary();
        }

        async function deleteLibraryItem(resId) {
            if (confirm('Delete this research item from memory?')) {
                await fetch(`/api/discovery/library/${resId}`, { method: 'DELETE' });
                loadResearchLibrary();
            }
        }

        function openAddResearchModal() {
            const title = prompt('Enter Research Title:');
            if (!title) return;
            const summary = prompt('Enter Summary / Findings:');
            if (!summary) return;
            const sourceUrl = prompt('Enter Source URL (optional):') || 'https://ai.google.dev';

            fetch('/api/discovery/library/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: title,
                    category: 'custom_notes',
                    source_url: sourceUrl,
                    summary: summary,
                    technical_requirements: 'User created',
                    tags: 'user_research, notes',
                    is_favorite: true
                })
            }).then(() => loadResearchLibrary());
        }

        /* ========================================================
           CORE AI: LIVE DISCOVERY MONITOR JAVASCRIPT
           ======================================================== */
        async function loadDiscoveryMonitor() {
            try {
                // 1. Fetch live jobs
                const resJobs = await fetch('/api/discovery/jobs');
                const dJobs = await resJobs.json();
                const jobsContainer = document.getElementById('discoveryJobsLogContainer');
                if (jobsContainer && dJobs.jobs) {
                    if (dJobs.jobs.length === 0) {
                        jobsContainer.innerHTML = '<div style="color:var(--text-muted); padding:10px;">No recent discovery jobs.</div>';
                    } else {
                        jobsContainer.innerHTML = dJobs.jobs.map(j => `
                            <div style="background:#0F172A; border:1px solid #334155; border-radius:6px; padding:10px; font-size:12px;">
                                <div style="display:flex; justify-content:space-between;">
                                    <strong>Query: ${j.query}</strong>
                                    <span style="font-weight:700; color:${j.status === 'COMPLETED' ? '#10B981' : '#38BDF8'};">${j.status}</span>
                                </div>
                                <div style="color:#94A3B8; font-size:11px; margin-top:4px;">
                                    Source: ${j.source} | Processed: ${j.results_processed} | New Saved: ${j.new_resources} | Skipped: ${j.duplicates_skipped}
                                </div>
                            </div>
                        `).join('');
                    }
                }

                // 2. Fetch recurring schedules
                const resSched = await fetch('/api/discovery/schedules');
                const dSched = await resSched.json();
                const schedContainer = document.getElementById('schedulesListContainer');
                if (schedContainer && dSched.schedules) {
                    document.getElementById('kpiActiveSchedules').innerText = dSched.schedules.filter(s => s.status === 'active').length;
                    schedContainer.innerHTML = dSched.schedules.map(s => `
                        <div style="background:#0F172A; border:1px solid #334155; border-radius:6px; padding:10px; font-size:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <strong>${s.task_name}</strong>
                                    <div style="font-size:11px; color:#94A3B8;">Frequency: ${s.frequency} | Found: ${s.results_count} items</div>
                                </div>
                                <button type="button" class="btn btn-secondary" style="font-size:10px; padding:3px 8px;" onclick="toggleDiscoverySchedule(${s.id}, '${s.status === 'active' ? 'paused' : 'active'}')">
                                    ${s.status === 'active' ? '⏸ Pause' : '▶ Resume'}
                                </button>
                            </div>
                        </div>
                    `).join('');
                }
            } catch (err) {
                console.error('Error loading discovery monitor:', err);
            }
        }

        async function toggleDiscoverySchedule(schedId, newStatus) {
            await fetch('/api/discovery/schedules/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ schedule_id: schedId, status: newStatus })
            });
            loadDiscoveryMonitor();
        }

