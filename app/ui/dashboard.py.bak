                const res = await fetch('/api/learning/drills/sql', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({topic: 'Window Functions & Ranking', difficulty: 'medium'})
                });
                const d = await res.json();
                let html = `<h3>🎓 SQL Practice Drill: ${d.topic}</h3><p style="color:#94A3B8;"><b>Context:</b> ${d.scenario}</p><hr style="border-color:#334155; margin:10px 0;">`;
                d.questions.forEach((q, i) => {
                    html += `<div style="margin-bottom:12px;"><b>Q${i+1}:</b> ${q.question}<br><span style="color:#F59E0B; font-size:12px;">💡 Hint: ${q.hint}</span><br><code style="color:#34D399; font-size:11px; display:block; margin-top:4px;">Solution: ${q.solution}</code></div>`;
                });
                box.innerHTML = html;
            } catch (e) {
                box.innerText = 'Error generating SQL drill: ' + e;
