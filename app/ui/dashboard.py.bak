                <input type="text" class="studio-input" id="remTitle" placeholder="e.g. Review Q3 SQL Tutorial Performance" />
                
                <div class="btn-row" style="margin-top:10px;">
                    <div style="flex:1;">
                        <label class="input-label">Due Time / Schedule</label>
                        <input type="text" class="studio-input" id="remDue" placeholder="Tomorrow 10:00 AM" />
                    </div>
