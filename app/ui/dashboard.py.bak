                        <button type="button" class="btn btn-primary" style="margin-top:10px; width:100%; font-size:11px; padding:6px 0;">&#128640; Broadcast 360°</button>
                    </div>

                    <div class="conn-node-card" style="cursor:pointer;" onclick="dispatchTgBroadcast('movies')">
                        <div class="conn-node-header">
                            <div class="conn-node-title">🎬 Movies &amp; OTT Releases</div>
                            <span class="conn-status-dot"></span>
                        </div>
                        <div class="conn-node-meta">Latest theatrical blockbusters (Devara, Stree 2) and Netflix/Prime OTT releases.</div>
                        <button type="button" class="btn btn-secondary" style="margin-top:10px; width:100%; font-size:11px; padding:6px 0;">&#127916; Send Movies</button>
                    </div>

                    <div class="conn-node-card" style="cursor:pointer;" onclick="dispatchTgBroadcast('github')">
