        /* Periodic Polling for Stats & Live Logs */
        async function pollStatsAndAgents() {
            try {
                const res = await fetch('/api/stats');
                const d = await res.json();
                if (d.agents) {
                    updateRobotStates(d.agents);
                    renderAgentControlGrid(d.agents);
                    let running = 0;
                    for (const [ag, st] of Object.entries(d.agents)) {
                        if (st.status === 'working' || st.status === 'running') {
                            running++;
                            document.getElementById('statAgent').innerText = ag.replace('_', ' ').toUpperCase();
                            document.getElementById('statTask').innerText = 'Task: ' + (st.task || 'Active execution');
                            document.getElementById('statStatus').innerText = '⚡ ACTIVE PROCESSING';
                            document.getElementById('statStatus').style.color = 'var(--accent-magenta)';
                        }
                    }
                    if (running === 0) {
                        document.getElementById('statAgent').innerText = 'Manager Agent';
                        document.getElementById('statTask').innerText = 'Task: Standby';
                        document.getElementById('statStatus').innerText = '🟢 SYSTEM READY';
                        document.getElementById('statStatus').style.color = 'var(--accent-green)';
                    }
                }
            } catch (e) {}
        }

        async function pollLogs() {
            try {
                const res = await fetch('/api/logs/live');
                const d = await res.json();
                if (d.logs && d.logs.length > 0) {
                    const text = d.logs.join('\n');
                    const rEl = document.getElementById('rightLogsStream');
                    const fEl = document.getElementById('fullLogsBox');
                    if (rEl) { rEl.innerText = text; rEl.scrollTop = rEl.scrollHeight; }
                    if (fEl && currentActiveView === 'logs') { fEl.innerText = text; fEl.scrollTop = fEl.scrollHeight; }
                }
            } catch (e) {}
        }

        // Initialize on load
        
        /* --- AI MANAGER CHAT INTERACTION --- */
        
        // Enter key to send in managerChatInput (Shift+Enter for newline)
        document.addEventListener('DOMContentLoaded', () => {
            const mInput = document.getElementById('managerChatInput');
            if (mInput) {
                mInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendManagerMessage();
                    }
                });
            }
        });

        let isManagerGenerating = false;
        let managerChatHistory = [];
        var chatTablesRegistry = window.chatTablesRegistry || {};
        var chatChartsRegistry = window.chatChartsRegistry || {};

        function formatMarkdownChat(text) {
            if (!text) return '';
            let html = escapeHtml(text);

            // Bold
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            // Italic
            html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
            html = html.replace(/_(.*?)_/g, '<em>$1</em>');
            // Inline code
            html = html.replace(/`([^`]+)`/g, '<code style="background:#1E293B; color:#38BDF8; padding:2px 6px; border-radius:4px; font-family:monospace; font-size:11.5px;">$1</code>');
            // Headings
            html = html.replace(/^### (.*$)/gim, '<h3 style="color:#38BDF8; font-size:13px; margin:10px 0 4px 0; font-weight:700;">$1</h3>');
            html = html.replace(/^## (.*$)/gim, '<h2 style="color:#F8FAFC; font-size:14px; margin:12px 0 6px 0; font-weight:800;">$1</h2>');
            // Lists
            html = html.replace(/^\s*•\s*(.*$)/gim, '<div style="padding-left:14px; margin:3px 0;">&bull; $1</div>');
            html = html.replace(/^\s*-\s*(.*$)/gim, '<div style="padding-left:14px; margin:3px 0;">&ndash; $1</div>');
            // Line breaks
            html = html.replace(/\n/g, '<br>');
            return html;
        }

        function createCodeBlockHtml(lang, code, blockId) {
            const safeCode = escapeHtml(code);
            return `
                <div class="code-block-wrapper" id="${blockId}">
                    <div class="code-header">
                        <span style="font-weight:700; text-transform:uppercase;">${lang}</span>
                        <button type="button" class="copy-btn" onclick="copyCodeBlock('${blockId}')">&#128203; Copy Code</button>
                    </div>
                    <pre class="code-content"><code>${safeCode}</code></pre>
                </div>
            `;
        }

        function copyCodeBlock(blockId) {
            const el = document.getElementById(blockId);
            if (!el) return;
            const codeEl = el.querySelector('code');
            if (codeEl) {
                navigator.clipboard.writeText(codeEl.innerText);
                const btn = el.querySelector('.copy-btn');
                if (btn) {
                    const orig = btn.innerHTML;
                    btn.innerHTML = '&#10004; Copied!';
                    setTimeout(() => btn.innerHTML = orig, 2000);
                }
            }
        }

        function renderSolutionPlanCard(plan) {
            if (!plan) return '';
            const planId = plan.plan_id || ('plan_' + Date.now());
            const reqList = (plan.requirements || []).map(r => `<li>${escapeHtml(r)}</li>`).join('');
            const agentsList = (plan.required_agents || []).map(a => `<li><strong>${escapeHtml(a.name)}</strong>: ${escapeHtml(a.role)}</li>`).join('');
            const depsList = (plan.dependencies || []).map(d => `<li>${escapeHtml(d)}</li>`).join('');
            const delivList = (plan.expected_deliverables || []).map(d => `<li>${escapeHtml(d)}</li>`).join('');
            const risksList = (plan.risks_and_limitations || []).map(r => `<li>${escapeHtml(r)}</li>`).join('');

            return `
                <div class="solution-card" id="${planId}">
                    <div class="solution-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-size:16px;">&#128736;</span>
                            <div>
                                <div style="font-size:13px; font-weight:800; color:#38BDF8;">STRUCTURED IMPLEMENTATION PLAN</div>
                                <div style="font-size:11px; color:#CBD5E1;">${escapeHtml(plan.objective || 'Task Execution Plan')}</div>
                            </div>
                        </div>
                        <span style="background:rgba(56,189,248,0.15); border:1px solid #38BDF8; color:#38BDF8; font-size:10px; font-weight:700; padding:2px 8px; border-radius:4px;">AWAITING APPROVAL</span>
                    </div>

                    <div class="solution-grid">
                        <div class="solution-item">
                            <h4>&#127919; Objective &amp; Scope</h4>
                            <p>${escapeHtml(plan.objective || '')}</p>
                        </div>
                        <div class="solution-item">
                            <h4>&#128260; Proposed Approach</h4>
                            <p>${escapeHtml(plan.proposed_approach || '')}</p>
                        </div>
                        <div class="solution-item">
                            <h4>&#128203; Core Requirements</h4>
                            <ul>${reqList}</ul>
                        </div>
                        <div class="solution-item">
                            <h4>&#129302; Required Agents &amp; Roles</h4>
                            <ul>${agentsList}</ul>
                        </div>
                        <div class="solution-item">
                            <h4>&#128279; Dependencies &amp; Target Systems</h4>
                            <ul>${depsList}</ul>
                        </div>
                        <div class="solution-item">
                            <h4>&#128230; Expected Deliverables</h4>
                            <ul>${delivList}</ul>
                        </div>
                        <div class="solution-item">
                            <h4>&#9888;&#65039; Risks &amp; Guardrails</h4>
                            <ul>${risksList}</ul>
                        </div>
                        <div class="solution-item">
                            <h4>&#9654;&#65039; Next Recommended Action</h4>
                            <p style="color:#10B981; font-weight:600;">${escapeHtml(plan.next_action || 'Review and approve to trigger autonomous execution.')}</p>
                        </div>
                    </div>

                    <!-- Expandable Architecture Details Drawer (Hidden by default) -->
                    <div id="plan_details_${planId}" style="display:none; background:#060A14; border:1px solid #1E2D4A; border-radius:6px; padding:10px 14px; margin-bottom:10px; font-size:11.5px; color:#CBD5E1;">
                        <div style="font-weight:700; color:#38BDF8; margin-bottom:6px;">Technical Architecture &amp; Execution Specifications:</div>
                        <div>• Connections: <code>${escapeHtml(plan.required_connections || 'NANO_PRO_SNOWFLAKE, Oracle XE, AWS S3')}</code></div>
                        <div>• Execution Model: Pre-load Python schema validation AST + In-warehouse Snowflake SQL transforms</div>
                        <div>• Verification: Automated SQL test suite verifying primary key uniqueness &amp; zero null foreign keys</div>
                    </div>

                    <div class="solution-actions-row">
                        <button type="button" class="btn btn-primary" onclick="approveAndExecutePlan('${planId}')" style="font-size:11.5px; padding:5px 14px; background:#10B981; border-color:#10B981; color:#FFF;">&#10004; Approve &amp; Execute</button>
                        <button type="button" class="btn btn-secondary" onclick="modifyPlanPrompt('${planId}')" style="font-size:11.5px; padding:5px 12px;">&#9998; Modify Plan</button>
                        <button type="button" class="btn btn-secondary" onclick="discussPlanPrompt('${planId}')" style="font-size:11.5px; padding:5px 12px;">&#128172; Discuss Further</button>
                        <button type="button" class="btn btn-secondary" onclick="togglePlanDetails('${planId}')" style="font-size:11.5px; padding:5px 12px;">&#128269; Show Details</button>
                        <button type="button" class="btn btn-secondary" onclick="cancelPlan('${planId}')" style="font-size:11.5px; padding:5px 12px; color:#EF4444;">&times; Cancel</button>
                    </div>
                </div>
            `;
        }

        function renderOperationalEvents(events) {
            if (!events || events.length === 0) return '';
            const items = events.map(e => `<div class="event-line"><span>&bull;</span> <span>${escapeHtml(e)}</span></div>`).join('');
            return `
                <div class="events-timeline">
                    <div style="font-weight:700; color:#10B981; margin-bottom:6px; display:flex; align-items:center; gap:6px;">
                        <span>&#9889;</span> REAL-TIME OPERATIONAL EVENTS STREAM
                    </div>
                    ${items}
                </div>
            `;
        }

        function renderExecutionCardHtml(card) {
            if (!card) return '';
            const stepsHtml = (card.steps || []).map(s => `
                <div style="display:flex; align-items:center; gap:8px; padding:3px 0; border-bottom:1px solid #1E293B; font-size:11px;">
                    <span style="color:#10B981; font-weight:800;">✓ Stage ${s.step}:</span>
                    <span style="color:#F8FAFC; font-weight:600;">${escapeHtml(s.name)}</span>
                    <span style="color:#94A3B8;">&mdash; ${escapeHtml(s.detail)}</span>
                </div>
            `).join('');

            return `
                <div style="background:#0B1120; border:1px solid #10B981; border-radius:8px; padding:12px; margin-top:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <span style="font-weight:800; color:#10B981; font-size:12px;">&#9989; EXECUTION COMPLETED (${card.elapsed_ms || 0} ms)</span>
                        <span style="font-size:10px; color:#94A3B8; font-family:monospace;">${escapeHtml(card.target || '')}</span>
                    </div>
                    ${stepsHtml}
                </div>
            `;
        }

        function appendUserMessage(msgText) {
            const stream = document.getElementById('managerChatStream');
            if (!stream) return;
            const timeStr = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-msg user';
            msgDiv.innerHTML = `
                <div class="msg-avatar">&#128100;</div>
                <div class="msg-bubble">
                    <div class="msg-sender" style="color:#38BDF8; justify-content:flex-end;">You</div>
                    <div class="msg-text">${escapeHtml(msgText).replace(/\n/g, '<br>')}</div>
                    <div class="msg-meta" style="text-align:right;">${timeStr}</div>
                </div>
            `;
            stream.appendChild(msgDiv);
            stream.scrollTop = stream.scrollHeight;
        }

        function appendManagerMessage(data) {
            const stream = document.getElementById('managerChatStream');
            if (!stream) return;
            const timeStr = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-msg manager';

            let bodyHtml = formatMarkdownChat(data.response || '');

            // Solution Plan Card
            if (data.solution_plan) {
                bodyHtml += renderSolutionPlanCard(data.solution_plan);
            }

            // Operational Events
            if (data.operational_events) {
                bodyHtml += renderOperationalEvents(data.operational_events);
            }

            // Execution Card
            if (data.execution_card) {
                bodyHtml += renderExecutionCardHtml(data.execution_card);
            }

            // Table Data
            if (data.table_data && data.table_data.columns) {
                const tableId = 'table_' + Date.now();
                chatTablesRegistry[tableId] = {
                    data: data.table_data,
                    filteredRows: [...data.table_data.rows],
                    page: 1,
                    pageSize: 5,
                    sortCol: null,
                    sortAsc: true
                };
                bodyHtml += `<div id="${tableId}" style="margin-top:10px;"></div>`;
                setTimeout(() => renderTableComponent(tableId), 50);
            }

            // Chart Data
            if (data.chart_data && data.chart_data.labels) {
                const chartId = 'chart_' + Date.now();
                chatChartsRegistry[chartId] = data.chart_data;
                bodyHtml += `
                    <div style="background:#0F172A; border:1px solid #1E2D4A; border-radius:8px; padding:12px; margin-top:10px;">
                        <div style="font-weight:700; color:#38BDF8; font-size:12px; margin-bottom:8px;">${escapeHtml(data.chart_data.title || 'Data Visualization')}</div>
                        <canvas id="${chartId}" style="width:100%; max-height:220px;"></canvas>
                    </div>
                `;
                setTimeout(() => renderCanvasChart(chartId, data.chart_data.type || 'bar'), 100);
            }

            // Code Artifacts
            if (data.code_artifacts) {
                if (data.code_artifacts.python_validation) {
                    bodyHtml += createCodeBlockHtml('Python Validation Script', data.code_artifacts.python_validation, 'code_py_' + Date.now());
                }
                if (data.code_artifacts.snowflake_sql) {
                    bodyHtml += createCodeBlockHtml('Snowflake Medallion SQL', data.code_artifacts.snowflake_sql, 'code_sql_' + Date.now());
                }
                if (data.code_artifacts.sql_tests) {
                    bodyHtml += createCodeBlockHtml('SQL Test Assertions', data.code_artifacts.sql_tests, 'code_tests_' + Date.now());
                }
            }

            msgDiv.innerHTML = `
                <div class="msg-avatar">&#129302;</div>
                <div class="msg-bubble" style="width:100%;">
                    <div class="msg-sender">AI Manager <span class="msg-tag">Central Orchestrator</span></div>
                    <div class="msg-text">${bodyHtml}</div>
                    <div class="msg-meta">
                        <span>${timeStr}</span> &bull; <span>Agent: ${escapeHtml((data.agent_id || 'manager').toUpperCase())}</span> &bull; <span>Status: ${escapeHtml(data.status || 'READY')}</span>
                    </div>
                </div>
            `;
            stream.appendChild(msgDiv);
            stream.scrollTop = stream.scrollHeight;

            // Update action suggestion chips if present
            if (data.actions && Array.isArray(data.actions) && data.actions.length > 0) {
                updateSuggestionsChips(data.actions);
            }
        }

        function updateSuggestionsChips(actions) {
            const bar = document.getElementById('managerSuggestionsBar');
            if (!bar) return;
            bar.innerHTML = actions.map(act => `
                <button type="button" class="action-chip" onclick="quickFillPrompt('${escapeHtml(act)}')">${escapeHtml(act)}</button>
            `).join('');
        }

        async function sendManagerMessage(overrideMsg) {
            const input = document.getElementById('managerChatInput');
            const msg = (typeof overrideMsg === 'string' && overrideMsg.trim()) ? overrideMsg.trim() : (input ? input.value.trim() : '');
            if (!msg) {
                alert('Please enter a message for the AI Manager.');
                return;
            }

            if (input) {
                input.value = '';
                input.style.height = '46px';
            }

            appendUserMessage(msg);

            // Show Thinking Indicator Bubble
            const stream = document.getElementById('managerChatStream');
            const thinkingId = 'thinking_' + Date.now();
            if (stream) {
                const thinkingDiv = document.createElement('div');
                thinkingDiv.className = 'chat-msg manager';
                thinkingDiv.id = thinkingId;
                thinkingDiv.innerHTML = `
                    <div class="msg-avatar">&#129302;</div>
                    <div class="msg-bubble" style="color:var(--text-muted); font-style:italic;">
                        <span style="display:inline-block; animation:pulseListen 1s infinite;">&#9889;</span> AI Manager is analyzing requirements, consulting agent registry, and reasoning...
                    </div>
                `;
                stream.appendChild(thinkingDiv);
                stream.scrollTop = stream.scrollHeight;
            }

            // Update UI State
            const stateIndicator = document.getElementById('managerStateIndicator');
            if (stateIndicator) stateIndicator.innerText = 'Thinking & Planning...';
            const sendBtn = document.getElementById('managerSendBtn');
            const stopBtn = document.getElementById('managerStopBtn');
            if (sendBtn) sendBtn.style.display = 'none';
            if (stopBtn) stopBtn.style.display = 'inline-flex';
            isManagerGenerating = true;

            try {
                const res = await fetch('/api/manager/chat', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ message: msg, session_id: 'default' })
                });
                const d = await res.json();

                // Remove thinking indicator
                const thEl = document.getElementById(thinkingId);
                if (thEl) thEl.remove();

                appendManagerMessage(d);

                // Spoken speech response if enabled
                const ttsCheck = document.getElementById('managerTtsCheckbox');
                if (ttsCheck && ttsCheck.checked && d.response) {
                    const shortSpoken = d.response.split('\n')[0].replace(/[*#`_]/g, '');
                    const langSel = document.getElementById('managerVoiceLangSelect');
                    const lang = langSel ? langSel.value : 'en-IN';
                    speakTextAloud(shortSpoken, lang);
                }

                // Sync live office telemetry so pixel office reflects any state changes
                if (typeof refreshOfficeLiveState === 'function') {
                    refreshOfficeLiveState();
                }

                if (d.status === 'WAITING_FOR_APPROVAL') {
                    if (typeof loadApprovals === 'function') loadApprovals();
                }

            } catch (err) {
                const thEl = document.getElementById(thinkingId);
                if (thEl) thEl.remove();
                if (stream) {
                    const errDiv = document.createElement('div');
                    errDiv.className = 'chat-msg manager';
                    errDiv.innerHTML = `
                        <div class="msg-avatar" style="background:#EF4444; color:#FFF;">!</div>
                        <div class="msg-bubble" style="border-color:#EF4444; color:#FCA5A5;">
                            <strong>Communication Notice:</strong> ${escapeHtml(err.message || 'Unable to connect to AI Manager service.')}
                        </div>
                    `;
                    stream.appendChild(errDiv);
                    stream.scrollTop = stream.scrollHeight;
                }
            } finally {
                isManagerGenerating = false;
                if (stateIndicator) stateIndicator.innerText = 'Ready';
                if (sendBtn) sendBtn.style.display = 'inline-flex';
                if (stopBtn) stopBtn.style.display = 'none';
            }
        }

        async function approveAndExecutePlan(planId) {
            appendUserMessage("Approved. Execute plan: " + planId);
            const stateIndicator = document.getElementById('managerStateIndicator');
            if (stateIndicator) stateIndicator.innerText = 'Executing Approved Plan...';

            const stream = document.getElementById('managerChatStream');
            const execThinkingId = 'exec_thinking_' + Date.now();
            if (stream) {
                const tDiv = document.createElement('div');
                tDiv.className = 'chat-msg manager';
                tDiv.id = execThinkingId;
                tDiv.innerHTML = `
                    <div class="msg-avatar">&#129302;</div>
                    <div class="msg-bubble" style="color:var(--text-muted); font-style:italic;">
                        <span style="display:inline-block; animation:pulseListen 1s infinite;">&#9889;</span> Plan approved! Assigning tasks to Data Engineer, Python Developer, and SQL Developer agents...
                    </div>
                `;
                stream.appendChild(tDiv);
                stream.scrollTop = stream.scrollHeight;
            }

            try {
                const res = await fetch('/api/manager/execute-plan', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ message: "Execute plan " + planId, session_id: 'default', action: 'approve_and_execute', plan_id: planId })
                });
                const d = await res.json();
                const thEl = document.getElementById(execThinkingId);
                if (thEl) thEl.remove();

                appendManagerMessage(d);

                if (typeof refreshOfficeLiveState === 'function') {
                    refreshOfficeLiveState();
                }

                const ttsCheck = document.getElementById('managerTtsCheckbox');
                if (ttsCheck && ttsCheck.checked && d.response) {
                    const shortSpoken = "Snowflake ETL pipeline successfully executed and verified with 100% test assertions.";
                    speakTextAloud(shortSpoken, 'en-IN');
                }
            } catch (err) {
                const thEl = document.getElementById(execThinkingId);
                if (thEl) thEl.remove();
                if (stream) {
                    const errDiv = document.createElement('div');
                    errDiv.className = 'chat-msg manager';
                    errDiv.innerHTML = `
                        <div class="msg-avatar" style="background:#EF4444; color:#FFF;">!</div>
                        <div class="msg-bubble" style="border-color:#EF4444; color:#FCA5A5;">
                            <strong>Execution Error:</strong> ${escapeHtml(err.message)}
                        </div>
                    `;
                    stream.appendChild(errDiv);
                }
            } finally {
                if (stateIndicator) stateIndicator.innerText = 'Ready';
            }
        }

        function modifyPlanPrompt(planId) {
            const input = document.getElementById('managerChatInput');
            if (input) {
                input.value = "Modify the previous solution: ";
                input.focus();
            }
        }

        function discussPlanPrompt(planId) {
            quickFillPrompt("Let's discuss alternative approaches for this pipeline.");
        }

        function togglePlanDetails(planId) {
            const el = document.getElementById('plan_details_' + planId);
            if (el) {
                el.style.display = el.style.display === 'none' ? 'block' : 'none';
            }
        }

        function cancelPlan(planId) {
            const card = document.getElementById(planId);
            if (card) {
                card.style.opacity = '0.5';
                const actionsRow = card.querySelector('.solution-actions-row');
                if (actionsRow) {
                    actionsRow.innerHTML = '<span style="color:#EF4444; font-size:11px; font-weight:700;">&times; Plan Cancelled by User</span>';
                }
            }
            appendUserMessage("Cancel plan: " + planId);
            const stream = document.getElementById('managerChatStream');
            if (stream) {
                const div = document.createElement('div');
                div.className = 'chat-msg manager';
                div.innerHTML = `
                    <div class="msg-avatar">&#129302;</div>
                    <div class="msg-bubble">
                        Plan <code>${escapeHtml(planId)}</code> has been cancelled. What would you like to work on next?
                    </div>
                `;
                stream.appendChild(div);
                stream.scrollTop = stream.scrollHeight;
            }
        }

        function stopManagerGeneration() {
            isManagerGenerating = false;
            if (typeof stopSpeaking === 'function') stopSpeaking();
            const sendBtn = document.getElementById('managerSendBtn');
            const stopBtn = document.getElementById('managerStopBtn');
            if (sendBtn) sendBtn.style.display = 'inline-flex';
            if (stopBtn) stopBtn.style.display = 'none';
            const stateIndicator = document.getElementById('managerStateIndicator');
            if (stateIndicator) stateIndicator.innerText = 'Ready';
            logLocal('AIManager', 'Response generation stopped by user.');
        }

        function quickFillPrompt(txt) {
            const input = document.getElementById('managerChatInput');
            if (input) {
                input.value = txt;
                input.focus();
            }
            if (typeof currentActiveView !== 'undefined' && currentActiveView !== 'ai_manager') {
                switchView('ai_manager');
            }
            sendManagerMessage();
        }

        function clearManagerConversation() {
            const stream = document.getElementById('managerChatStream');
            if (!stream) return;
            stream.innerHTML = `
                <div class="chat-msg manager" id="welcomeManagerMsg">
                    <div class="msg-avatar">&#129302;</div>
                    <div class="msg-bubble">
                        <div class="msg-sender">AI Manager <span class="msg-tag">Central Orchestrator</span></div>
                        <div class="msg-text">
                            AI Manager Ready. How can I assist you with your models, data pipelines, coding, or automation today?
                            <br><br>
                            I discuss requirements, formulate multi-agent architecture plans, secure credentials into the Vault, and orchestrate our 45 specialized agents with verified test executions. Speak or type in <strong>English</strong>, <strong>मराठी (Marathi)</strong>, or <strong>हिंदी (Hindi)</strong>.
                        </div>
                        <div class="msg-meta">
                            <span>Just now</span> &bull; <span>Status: Ready</span>
                        </div>
                    </div>
                </div>
            `;
            const stateIndicator = document.getElementById('managerStateIndicator');
            if (stateIndicator) stateIndicator.innerText = 'Ready';
        }

        function exportChatTranscript() {
            const stream = document.getElementById('managerChatStream');
            if (!stream) return;
            const txt = stream.innerText;
            const blob = new Blob([txt], {type: 'text/plain;charset=utf-8'});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `NanoPro_AI_Manager_Transcript_${Date.now()}.txt`;
            a.click();
        }

        let isManagerVoiceRecording = false;
        let managerSpeechRecognition = null;

        function onManagerVoiceLanguageChanged() {
            const langSel = document.getElementById('managerVoiceLangSelect');
            if (managerSpeechRecognition && langSel) {
                managerSpeechRecognition.lang = langSel.value;
            }
        }

        function toggleManagerVoiceRecording() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert('Web Speech API is not supported in this browser. Please type your message into the composer.');
                return;
            }

            const micBtn = document.getElementById('managerVoiceMicBtn');
            const micText = document.getElementById('managerMicStatusText');
            const statePill = document.getElementById('managerVoiceStatePill');

            if (isManagerVoiceRecording) {
                if (managerSpeechRecognition) {
                    try { managerSpeechRecognition.stop(); } catch(e) {}
                }
                isManagerVoiceRecording = false;
                if (micBtn) micBtn.classList.remove('mic-recording');
                if (micText) micText.style.display = 'none';
                if (statePill) statePill.style.display = 'none';
                return;
            }

            try {
                managerSpeechRecognition = new SpeechRecognition();
                const langSel = document.getElementById('managerVoiceLangSelect');
                managerSpeechRecognition.lang = langSel ? langSel.value : 'en-IN';
                managerSpeechRecognition.continuous = false;
                managerSpeechRecognition.interimResults = false;

                isManagerVoiceRecording = true;
                if (micBtn) micBtn.classList.add('mic-recording');
                if (micText) micText.style.display = 'inline';
                if (statePill) statePill.style.display = 'inline';

                managerSpeechRecognition.onresult = function(event) {
                    const transcript = event.results[0][0].transcript;
                    logLocal('Voice', 'Speech recognized: ' + transcript);
                    const input = document.getElementById('managerChatInput');
                    if (input) input.value = transcript;
                    
                    isManagerVoiceRecording = false;
                    if (micBtn) micBtn.classList.remove('mic-recording');
                    if (micText) micText.style.display = 'none';
                    if (statePill) statePill.style.display = 'none';

                    sendManagerMessage();
                };

                managerSpeechRecognition.onerror = function(event) {
                    isManagerVoiceRecording = false;
                    if (micBtn) micBtn.classList.remove('mic-recording');
                    if (micText) micText.style.display = 'none';
                    if (statePill) statePill.style.display = 'none';
                };

                managerSpeechRecognition.onend = function() {
                    isManagerVoiceRecording = false;
                    if (micBtn) micBtn.classList.remove('mic-recording');
                    if (micText) micText.style.display = 'none';
                    if (statePill) statePill.style.display = 'none';
                };

                managerSpeechRecognition.start();
            } catch(e) {
                isManagerVoiceRecording = false;
                if (micBtn) micBtn.classList.remove('mic-recording');
                if (micText) micText.style.display = 'none';
                if (statePill) statePill.style.display = 'none';
            }
        }

        /* --- APPROVALS QUEUE --- */
        async function loadApprovals() {
            const el = document.getElementById('approvalsListBox');
            if (!el) return;
            try {
                const res = await fetch('/api/approvals/list?status=pending');
                const d = await res.json();
                const list = d.approvals || [];
                if (list.length === 0) {
                    el.innerText = 'No pending approvals. All operations within normal safety bounds.';
                } else {
                    el.innerHTML = list.map(a => `
                        <div style="background:#0F172A; border:1px solid #EF4444; border-radius:8px; padding:12px; margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between;">
                                <b>Action: ${a.action_name}</b>
                                <span style="background:#EF4444; color:#fff; font-size:10px; font-weight:800; padding:2px 8px; border-radius:10px;">${a.risk_level}</span>
                            </div>
                            <div style="font-size:12px; color:#CBD5E1; margin:6px 0;">Reason: ${a.reason}</div>
                            <div style="font-size:11px; color:#94A3B8;">Target: ${a.target_system} | Agent: ${a.agent_id}</div>
                            <div style="margin-top:8px;">
                                <button class="btn btn-primary" style="font-size:11px; padding:4px 10px;" onclick="decideApproval('${a.id}', 'approved')">&#10004; Approve Action</button>
                                <button class="btn btn-secondary" style="font-size:11px; padding:4px 10px; margin-left:8px;" onclick="decideApproval('${a.id}', 'rejected')">&#10006; Reject</button>
                            </div>
                        </div>
                    `).join('');
                }
            } catch (e) {
                el.innerText = 'Error loading approvals: ' + e.message;
            }
        }

        async function decideApproval(apprId, decision) {
            logLocal('ApprovalQueue', `Decision on [${apprId}]: ${decision}`);
            try {
                const res = await fetch('/api/approvals/decide', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ approval_id: apprId, decision: decision })
                });
                const data = await res.json();
                if (typeof showStudioToast === 'function') {
                    showStudioToast('Approval ' + decision.toUpperCase(), 'Action authorized and executed immediately.', 'success');
                }
                alert(`✅ Approval Request ${decision.toUpperCase()}!\nAction authorized and executed in NanoPro engine.`);
            } catch (err) {
                alert('Approval processing error: ' + err.message);
            }
            loadApprovals();
        }

        /* --- CREDENTIALS VAULT & CONNECTION MANAGER --- */
        let isSavingVault = false;
        async function saveVaultCredentialAction() {
            if (isSavingVault) return;

            const service = (document.getElementById('vaultService')?.value || '').trim();
            const type = document.getElementById('vaultType')?.value || 'database';
            const host = (document.getElementById('vaultHost')?.value || '').trim();
            const port = (document.getElementById('vaultPort')?.value || '').trim();
            const user = (document.getElementById('vaultUser')?.value || '').trim();
            const secret = (document.getElementById('vaultSecret')?.value || '').trim();

            if (!service) {
                alert('Please enter a Service Name (e.g. NANO_PRO_SNOWFLAKE, MY_ORACLE_XE_REMOTE, or GMAIL_SMTP).');
                return;
            }

            const btn = document.querySelector('button[onclick="saveVaultCredentialAction()"]');
            const origHtml = btn ? btn.innerHTML : 'Save Credential';

            isSavingVault = true;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '⏳ Encrypting & Saving...';
            }

            try {
                const res = await fetch('/api/vault/store', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
                    body: JSON.stringify({
                        service_name: service,
                        credential_type: type,
                        username: user,
                        secret_value: secret,
                        host: host,
                        port: port
                    })
                });

                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    d = { status: 'error', message: `Server returned non-JSON: ${raw.slice(0, 200)}` };
                }

                if (d.status === 'stored' || res.ok) {
                    // Synchronize connection manager & .env if password provided
                    if (secret && (service.toUpperCase().includes('ORACLE') || service.toUpperCase().includes('SNOWFLAKE'))) {
                        try {
                            await fetch('/api/connections/password', {
                                method: 'POST',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({ connection_name: service, new_password: secret })
                            });
                        } catch(pe) {
                            console.error('Password sync error:', pe);
                        }
                    }

                    if (typeof showStudioToast === 'function') {
                        showStudioToast('Vault Synchronized', `✅ Credential for '${service}' successfully encrypted with AES-256-GCM and stored in Vault!`, 'success');
                    }
                    alert(`✅ Credential for '${service}' successfully encrypted with AES-256-GCM and stored in Vault!\nCredential ID: ${d.credential_id || 'saved'}`);
                    const secInput = document.getElementById('vaultSecret');
                    if (secInput) {
                        secInput.value = '';
                        secInput.placeholder = '•••••••••••••••• (Encrypted in Vault)';
                    }
                    await loadVaultList();
                    await refreshConnectionHealthTable();
                } else {
                    alert('❌ Failed to store credential: ' + (d.message || JSON.stringify(d)));
                }
            } catch (e) {
                alert('❌ Vault Network/Execution Error: ' + (e.message || e));
            } finally {
                isSavingVault = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }
        function saveVaultCredential() { return saveVaultCredentialAction(); }

        async function loadVaultList() {
            const el = document.getElementById('vaultListBox');
            if (!el) return;
            el.innerHTML = '<div style="color:var(--text-muted); padding:8px;"><span class="spinner-sm"></span> Fetching encrypted credentials from Vault...</div>';
            try {
                const res = await fetch('/api/vault/list', { headers: { 'Accept': 'application/json' } });
                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    el.innerHTML = `<div style="color:#EF4444; padding:8px;">Server error (${res.status}): ${raw.slice(0, 150)}</div>`;
                    return;
                }

                const list = d.credentials || [];
                if (list.length === 0) {
                    el.innerHTML = '<div style="color:var(--text-muted); padding:10px; font-style:italic;">No credentials currently stored in the Vault. Use the form above to add a credential.</div>';
                } else {
                    el.innerHTML = list.map(c => {
                        const updatedDate = c.updated_at ? new Date(c.updated_at * 1000).toLocaleString() : 'N/A';
                        return `
                        <div style="background:#0F172A; border:1px solid #334155; border-radius:8px; padding:12px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; gap:12px;">
                            <div style="flex:1;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <b style="color:#38BDF8; font-size:13px;">${c.service_name}</b>
                                    <span class="badge" style="background:#1E293B; color:#94A3B8; font-size:10px; text-transform:uppercase;">${c.credential_type}</span>
                                    <span style="font-size:10px; color:#10B981; background:rgba(16,185,129,0.1); padding:2px 6px; border-radius:4px;">AES-256-GCM</span>
                                </div>
                                <div style="font-size:11.5px; color:#94A3B8; margin-top:4px; line-height:1.4;">
                                    <span><strong>User:</strong> ${c.username || '—'}</span> &bull; 
                                    <span><strong>Endpoint:</strong> ${c.host || '—'}${c.port ? ':' + c.port : ''}</span> &bull; 
                                    <span><strong>Secret:</strong> <code style="color:#F59E0B; background:#1E293B; padding:2px 6px; border-radius:4px;">${c.secret_value || '••••••••'}</code></span>
                                </div>
                                <div style="font-size:10px; color:#64748B; margin-top:2px;">
                                    Last Updated: ${updatedDate}
                                </div>
                            </div>
                            <div style="display:flex; gap:6px;">
                                <button type="button" class="btn btn-secondary" style="font-size:11px; padding:4px 10px;" onclick="openVaultEditModal('${c.service_name}', '${c.credential_type}')">⚙ Edit</button>
                                <button type="button" class="btn btn-secondary" style="font-size:11px; padding:4px 10px; color:#EF4444;" onclick="deleteVaultCred('${c.id}')">&#128465; Delete</button>
                            </div>
                        </div>
                    `}).join('');
                }
            } catch (e) {
                el.innerHTML = '<div style="color:#EF4444; padding:8px;">Error loading vault: ' + (e.message || e) + '</div>';
            }
        }

        async function deleteVaultCred(credId) {
            if (!confirm('Are you sure you want to delete this credential from the Vault?')) return;
            try {
                await fetch('/api/vault/' + credId, { method: 'DELETE' });
                await loadVaultList();
                await refreshConnectionHealthTable();
            } catch (e) {
                alert('Delete failed: ' + (e.message || e));
            }
        }

        function openVaultEditModal(connName, serviceType) {
            const servEl = document.getElementById('vaultService');
            const typeEl = document.getElementById('vaultType');
            const hostEl = document.getElementById('vaultHost');
            const portEl = document.getElementById('vaultPort');
            const userEl = document.getElementById('vaultUser');
            const secEl = document.getElementById('vaultSecret');

            if (servEl) servEl.value = connName || '';
            if (typeEl && serviceType) typeEl.value = serviceType;

            if (connName === 'NANO_PRO_SNOWFLAKE') {
