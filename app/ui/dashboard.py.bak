        /* ========================================================
           CENTRAL DISCOVERY & ISSUE MANAGEMENT JAVASCRIPT
           ======================================================== */
        async function loadDiscoveryDashboard() {
            const issuesContainer = document.getElementById('discoveryIssuesContainer');
            const cyclesContainer = document.getElementById('discoveryCyclesContainer');
            if (!issuesContainer) return;

            const status = document.getElementById('issueFilterStatus') ? document.getElementById('issueFilterStatus').value : 'all';
            const severity = document.getElementById('issueFilterSeverity') ? document.getElementById('issueFilterSeverity').value : 'all';
            const category = document.getElementById('issueFilterCategory') ? document.getElementById('issueFilterCategory').value : 'all';

            try {
                // 1. Fetch Issues
                const res = await fetch(`/api/discovery/system/issues?status=${status}&severity=${severity}&category=${category}`);
                const data = await res.json();
                const issues = data.issues || [];

                // Update KPI counts
                const unres = issues.filter(i => i.status !== 'resolved');
                const crits = unres.filter(i => i.severity === 'CRITICAL');
                const warns = unres.filter(i => i.severity === 'WARNING');
                const resolved = issues.filter(i => i.status === 'resolved');

                document.getElementById('kpiTotalIssues').innerText = unres.length;
                document.getElementById('kpiCriticalCount').innerText = crits.length + ' Critical';
                document.getElementById('kpiWarningCount').innerText = warns.length + ' Warnings';
                document.getElementById('kpiResolvedCount').innerText = resolved.length;

                const healthEl = document.getElementById('kpiOverallHealth');
                if (crits.length > 0) {
                    healthEl.innerText = 'CRITICAL';
                    healthEl.style.color = '#EF4444';
                } else if (warns.length > 0) {
                    healthEl.innerText = 'WARNING';
                    healthEl.style.color = '#F59E0B';
                } else {
                    healthEl.innerText = 'HEALTHY';
                    healthEl.style.color = '#10B981';
                }

                if (issues.length === 0) {
                    issuesContainer.innerHTML = '<div style="color:var(--text-muted); padding:16px;">No issues or discoveries match the selected filters.</div>';
                } else {
                    issuesContainer.innerHTML = issues.map(iss => {
                        const sevClass = iss.severity === 'CRITICAL' ? 'badge-critical' : (iss.severity === 'WARNING' ? 'badge-warning' : (iss.severity === 'OPPORTUNITY' ? 'badge-opportunity' : 'badge-info'));
                        const isResolved = (iss.status === 'resolved');
                        const isAck = (iss.status === 'acknowledged');
                        return `
                        <div style="background:#0F172A; border:1px solid ${iss.severity === 'CRITICAL' ? '#EF4444' : '#334155'}; border-radius:8px; padding:14px;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
                                <div>
                                    <span class="${sevClass}">${iss.severity}</span>
                                    <span style="font-size:11px; color:#94A3B8; margin-left:8px;">Category: <b>${iss.category.replace('_', ' ').toUpperCase()}</b></span>
                                    <h3 style="font-size:14.5px; color:#F8FAFC; margin:6px 0 3px 0;">${iss.title}</h3>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    ${!isResolved ? `
                                        <button type="button" class="btn btn-secondary" style="font-size:11px; padding:3px 8px;" onclick="updateIssueStatus('${iss.id}', 'acknowledged')">${isAck ? '✓ Acknowledged' : 'Acknowledge'}</button>
                                        <button type="button" class="btn btn-primary" style="font-size:11px; padding:3px 8px;" onclick="updateIssueStatus('${iss.id}', 'resolved')">✓ Mark Resolved</button>
                                    ` : `<span style="color:#10B981; font-weight:700; font-size:11.5px;">✓ Resolved</span>`}
                                </div>
                            </div>
                            <p style="font-size:12.5px; color:#CBD5E1; margin:8px 0;">${iss.description}</p>
                            <div style="background:#1E293B; border-radius:6px; padding:8px 10px; font-size:11.5px; color:#94A3B8; margin-bottom:8px;">
                                <div><strong>Evidence:</strong> ${iss.evidence}</div>
                                <div style="color:#38BDF8; margin-top:3px;"><strong>Recommended Action:</strong> ${iss.recommended_action}</div>
                            </div>
                            <div style="font-size:11px; color:#64748B;">Detected: ${new Date(iss.detected_at * 1000).toLocaleString()} | ID: <code>${iss.id}</code></div>
                        </div>`;
                    }).join('');
                }

                // 2. Fetch Discovery Cycles
                const resCycles = await fetch('/api/discovery/system/cycles');
                const dCycles = await resCycles.json();
                const cycles = dCycles.cycles || [];
                if (cycles.length > 0) {
                    document.getElementById('kpiLastCycleTime').innerText = 'Last Cycle: ' + new Date(cycles[0].executed_at * 1000).toLocaleTimeString();
                    if (cyclesContainer) {
                        cyclesContainer.innerHTML = `
                            <table class="studio-table">
                                <thead>
                                    <tr>
                                        <th>Cycle ID</th>
                                        <th>Status</th>
                                        <th>Duration</th>
                                        <th>Issues Detected</th>
                                        <th>Telegram Status</th>
                                        <th>Executed At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${cycles.map(c => `
                                        <tr>
                                            <td><code>${c.id}</code></td>
                                            <td><span class="${c.overall_status === 'HEALTHY' ? 'badge-info' : (c.overall_status === 'WARNING' ? 'badge-warning' : 'badge-critical')}">${c.overall_status}</span></td>
                                            <td>${c.duration_sec}s</td>
                                            <td>${c.total_issues} (${c.critical_count} Crit, ${c.warning_count} Warn)</td>
                                            <td>${c.telegram_sent ? '<span style="color:#10B981;">✓ Delivered</span>' : '<span style="color:#94A3B8;">Skipped / N/A</span>'}</td>
                                            <td>${new Date(c.executed_at * 1000).toLocaleString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        `;
                    }
                }
            } catch (err) {
                console.error('Error loading discovery dashboard:', err);
            }
        }

        async function updateIssueStatus(issueId, newStatus) {
            try {
                await fetch(`/api/discovery/system/issues/${issueId}/status`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ new_status: newStatus })
                });
                loadDiscoveryDashboard();
            } catch (e) {
                alert('Failed to update issue status: ' + e);
            }
        }

        async function runDiscoveryCycleManual() {
            logLocal('DiscoveryScheduler', 'Manual discovery cycle initiated by user.');
            const btn = window.event ? window.event.currentTarget : null;
            if (btn) btn.disabled = true;
            try {
                const res = await fetch('/api/discovery/system/run', { method: 'POST' });
                const d = await res.json();
                alert(`Discovery Cycle Completed!\nStatus: ${d.overall_status}\nIssues Checked: ${d.total_issues}\nDuration: ${d.duration_sec}s\nTelegram Sent: ${d.telegram_sent ? 'Yes' : 'No'}`);
                loadDiscoveryDashboard();
            } catch (e) {
                alert('Error running discovery cycle: ' + e);
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        /* ========================================================
           LOCAL STORAGE & DATA USAGE DASHBOARD JAVASCRIPT
           ======================================================== */
        async function loadStorageDashboard() {
            const tableBox = document.getElementById('storageCategoriesTable');
            const dbBox = document.getElementById('storageDbTablesContainer');
            const recBox = document.getElementById('storageRecommendationsContainer');
            if (!tableBox) return;

            tableBox.innerHTML = '<div style="color:var(--text-muted); padding:10px;">Reading filesystem and SQLite database storage measurements...</div>';

            try {
                const res = await fetch('/api/storage/usage');
                const data = await res.json();

                // Update KPIs defensively
                const cats = data.categories || {};
                const disk = data.disk_overall || {};
                
                if (document.getElementById('kpiTotalStorageUsed')) {
                    document.getElementById('kpiTotalStorageUsed').innerText = data.total_app_formatted || '0.0 MB';
                }
                if (document.getElementById('kpiDatabaseStorage')) {
                    document.getElementById('kpiDatabaseStorage').innerText = (cats.sqlite_database && cats.sqlite_database.size_formatted) ? cats.sqlite_database.size_formatted : '0.0 MB';
                }
                
                const mediaBytes = (cats.generated_videos?.size_bytes || cats.video_output?.size_bytes || 0) + 
                                   (cats.generated_images?.size_bytes || cats.image_output?.size_bytes || 0) + 
                                   (cats.generated_code?.size_bytes || 0);
                if (document.getElementById('kpiMediaStorage')) {
                    document.getElementById('kpiMediaStorage').innerText = (mediaBytes / (1024*1024)).toFixed(1) + ' MB';
                }
                
                if (document.getElementById('kpiSystemDiskFree')) {
                    document.getElementById('kpiSystemDiskFree').innerText = (disk.free_gb != null ? disk.free_gb : 0) + ' GB';
                }
                if (document.getElementById('kpiDiskUsedPct')) {
                    document.getElementById('kpiDiskUsedPct').innerText = (disk.used_percentage != null ? disk.used_percentage : 0) + '% Used (' + (disk.used_gb || 0) + ' / ' + (disk.total_gb || 0) + ' GB)';
                }

                // Render Categories Table
                let rowsHtml = '';
                for (const [key, cat] of Object.entries(cats)) {
                    rowsHtml += `
                        <tr>
                            <td><b>${cat.title || key}</b></td>
                            <td><code>${cat.path || 'N/A'}</code></td>
                            <td>${(cat.file_count || 0).toLocaleString()}</td>
                            <td><b style="color:#38BDF8;">${cat.size_formatted || '0 B'}</b></td>
                            <td>${cat.last_modified || 'N/A'}</td>
                            <td>
                                ${cat.can_cleanup ? `<button type="button" class="btn btn-secondary" style="font-size:10.5px; padding:3px 8px; color:#EF4444;" onclick="executeCategoryCleanup('${key}', '${cat.title || key}')">Safe Clean</button>` : '<span style="color:#64748B; font-size:11px;">Protected</span>'}
                            </td>
                        </tr>
                    `;
                }

                tableBox.innerHTML = `
                    <table class="studio-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Storage Location Path</th>
                                <th>Files</th>
                                <th>Disk Usage</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                    </table>
                `;

                // Render Database Tables
                if (dbBox && data.database_tables) {
                    dbBox.innerHTML = `
                        <table class="studio-table">
                            <thead>
                                <tr><th>Table Name</th><th>Record Count</th></tr>
                            </thead>
                            <tbody>
                                ${data.database_tables.map(t => `<tr><td><code>${t.table_name}</code></td><td><b>${t.record_count.toLocaleString()}</b></td></tr>`).join('')}
                            </tbody>
                        </table>
                    `;
                }

                // Render Recommendations
                if (recBox && data.recommendations) {
                    recBox.innerHTML = data.recommendations.map(r => `• <span style="color:#F8FAFC;">${r}</span>`).join('<br><br>');
                }

            } catch (err) {
                tableBox.innerHTML = '<div style="color:var(--accent-red); padding:10px;">Failed to inspect storage: ' + err + '</div>';
            }
        }

        async function executeCategoryCleanup(catKey, catTitle) {
            if (!confirm(`Are you sure you want to safely clean temporary files in [${catTitle}]?\n\nCore application code, databases, and saved credentials will NOT be touched.`)) return;
            try {
                const res = await fetch('/api/storage/cleanup', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ category: catKey })
                });
                const d = await res.json();
                alert(d.message || 'Cleanup completed.');
                loadStorageDashboard();
            } catch (err) {
                alert('Cleanup failed: ' + err);
            }
        }

        /* ========================================================
           DISCOVERY SCHEDULER SETTINGS & NOTIFICATIONS JAVASCRIPT
           ======================================================== */
        function onCadenceChange() {
            const val = document.getElementById('schedCadenceSelect').value;
            const customDiv = document.getElementById('customIntervalDiv');
            if (customDiv) customDiv.style.display = (val === 'custom') ? 'block' : 'none';
        }

        async function loadDiscoverySchedulerConfig() {
            try {
                const res = await fetch('/api/discovery/system/config');
                const cfg = await res.json();

                const cadenceSelect = document.getElementById('schedCadenceSelect');
                if (cadenceSelect) {
                    const sec = String(cfg.interval_seconds);
                    if (['3600', '7200', '21600', '86400'].includes(sec)) {
                        cadenceSelect.value = sec;
                    } else {
                        cadenceSelect.value = 'custom';
                        document.getElementById('schedCustomSeconds').value = cfg.interval_seconds;
                    }
                    onCadenceChange();
                }

                document.getElementById('schedTgEnabled').value = cfg.telegram_notifications_enabled ? 'true' : 'false';
                document.getElementById('schedHealthyDigest').value = cfg.send_all_healthy_summary ? 'true' : 'false';

                const enabledSet = new Set(cfg.enabled_categories || []);
                document.querySelectorAll('.sched-cat-chk').forEach(chk => {
                    chk.checked = enabledSet.has(chk.value);
                });
            } catch (err) {
                console.error('Error loading discovery config:', err);
            }
        }

        async function saveDiscoverySystemConfig() {
            let intervalSec = parseInt(document.getElementById('schedCadenceSelect').value);
            let cadenceLabel = document.getElementById('schedCadenceSelect').options[document.getElementById('schedCadenceSelect').selectedIndex].text;
            if (document.getElementById('schedCadenceSelect').value === 'custom') {
                intervalSec = parseInt(document.getElementById('schedCustomSeconds').value) || 3600;
                cadenceLabel = `Custom (${intervalSec}s)`;
            }

            const tgEnabled = document.getElementById('schedTgEnabled').value === 'true';
            const healthyDigest = document.getElementById('schedHealthyDigest').value === 'true';

            const enabledCategories = [];
            document.querySelectorAll('.sched-cat-chk').forEach(chk => {
                if (chk.checked) enabledCategories.push(chk.value);
            });

            try {
                const res = await fetch('/api/discovery/system/config', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        interval_seconds: intervalSec,
                        interval_label: cadenceLabel,
                        telegram_notifications_enabled: tgEnabled,
                        send_all_healthy_summary: healthyDigest,
                        enabled_categories: enabledCategories,
                        status: 'active'
                    })
                });
                const d = await res.json();
                alert('Discovery Scheduler configuration saved successfully!');
            } catch (err) {
                alert('Failed to save scheduler config: ' + err);
            }
        }

        async function sendTestTelegramNotification() {
            logLocal('TelegramAgent', 'Sending test Telegram notification...');
            try {
                const res = await fetch('/api/notifications/test', { method: 'POST' });
                const d = await res.json();
                if (d.status === 'sent') {
                    alert('Success! Verified test notification delivered to your Telegram (@mangesh_technews_bot).');
                } else {
                    alert('Telegram test failed: ' + (d.telegram_response?.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Error sending test notification: ' + err);
            }
        }


        /* ========================================================
           DATA ENGINEER, TELEGRAM BROADCAST & LIVE TOASTS JAVASCRIPT
           ======================================================== */
        
        // 1. Studio Toast Notification System
        function showStudioToast(title, message, type = 'info') {
            const container = document.getElementById('studioToastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'studio-toast';
            if (type === 'success') toast.style.borderLeftColor = '#10B981';
            else if (type === 'warning') toast.style.borderLeftColor = '#F59E0B';
            else if (type === 'error') toast.style.borderLeftColor = '#EF4444';

            toast.innerHTML = `
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
                    <b style="font-size:12.5px; color:#FFFFFF;">${title}</b>
                    <span style="font-size:10px; color:#94A3B8; cursor:pointer;" onclick="this.parentElement.parentElement.remove()">&times;</span>
                </div>
                <div style="font-size:11.5px; color:#CBD5E1; line-height:1.4;">${message}</div>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                setTimeout(() => toast.remove(), 400);
            }, 5000);
        }

        // 2. Notification Center Drawer
        function toggleNotificationDrawer() {
            const drawer = document.getElementById('notifDrawer');
            const backdrop = document.getElementById('notifDrawerBackdrop');
            if (!drawer) return;
            if (drawer.style.display === 'flex') {
                drawer.style.display = 'none';
                backdrop.style.display = 'none';
            } else {
                drawer.style.display = 'flex';
                backdrop.style.display = 'block';
                loadLiveNotifications();
            }
        }

        async function loadLiveNotifications() {
            const feed = document.getElementById('notifFeedList');
            const badge = document.getElementById('topbarNotifBadge');
            try {
                const res = await fetch('/api/notifications/live');
                const data = await res.json();
                if (badge) {
                    badge.innerText = data.unread_count > 0 ? data.unread_count : 'LIVE';
                }
                if (!feed) return;
                if (!data.notifications || data.notifications.length === 0) {
                    feed.innerHTML = '<div style="color:var(--text-muted); font-size:12px; text-align:center; padding:20px;">No notifications recorded yet.</div>';
                    return;
                }
                let html = '';
                data.notifications.forEach(n => {
                    const icon = n.channel === 'telegram' ? '📱' : (n.channel === 'email' ? '📧' : '🔔');
                    const timeStr = new Date(n.created_at * 1000).toLocaleTimeString();
                    html += `
                        <div class="notif-feed-item">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-weight:700; font-size:12px; color:#38BDF8;">${icon} ${n.title}</span>
                                <span style="font-size:10px; color:#64748B;">${timeStr}</span>
                            </div>
                            <div style="font-size:11.5px; color:#CBD5E1; line-height:1.4;">${n.content}</div>
                            <div style="font-size:10px; color:#10B981; margin-top:2px;">Channel: ${n.channel.toUpperCase()} | Status: ${n.status}</div>
                        </div>
                    `;
                });
                feed.innerHTML = html;
            } catch (err) {
                if (feed) feed.innerHTML = '<div style="color:#EF4444; font-size:11px;">Error loading notifications.</div>';
            }
        }

        // 3. Telegram Multi-Domain Dispatch
        async function dispatchTgBroadcast(category = 'all') {
            logLocal('TelegramAgent', `Triggering multi-domain broadcast: [${category.toUpperCase()}]`);
            showStudioToast('Telegram Broadcast Initiated', `Compiling ${category.toUpperCase()} multi-domain digest...`, 'info');
            const out = document.getElementById('telegramOutput');
            if (out) out.innerText = `Dispatching ${category.toUpperCase()} updates to @mangesh_technews_bot...`;

            try {
                const res = await fetch(`/api/telegram/broadcast?category=${encodeURIComponent(category)}`, { method: 'POST' });
                const d = await res.json();
                if (out) {
                    out.innerText = `[${new Date().toLocaleTimeString()}] Broadcast Dispatched:
` +
                        `• Category: ${d.category.toUpperCase()}
` +
                        `• Telegram Status: ${d.telegram_status || 'QUEUED'}
` +
                        `• Target Chat ID: ${d.chat_id}

` +
                        `Preview Content:
${d.preview}`;
                }
                showStudioToast('Telegram Broadcast Sent!', `Dispatched ${category.toUpperCase()} updates to @mangesh_technews_bot.`, 'success');
                loadLiveNotifications();
            } catch (err) {
                if (out) out.innerText = `Broadcast failed: ${err}`;
                showStudioToast('Broadcast Error', String(err), 'error');
            }
        }

        function quickTelegramBroadcast(category = 'all') {
            dispatchTgBroadcast(category);
        }

        // 4. Data Engineer: Test All Connections with Live Animation
        async function testDataEngineerConnections() {
            logLocal('DataEngineer', 'Testing all studio warehouse and data stream connections...');
            showStudioToast('Connection Diagnostic', 'Pinging SQLite, Files, Telegram, Ollama, SMTP, Snowflake...', 'info');
            
            // Set dots to pulsing
            document.querySelectorAll('.conn-status-dot').forEach(d => d.classList.add('pulsing'));
            const out = document.getElementById('dataEngineerOutput');
            if (out) out.innerText = 'Testing live latency across 6 endpoints...';

            try {
                const res = await fetch('/api/data_engineer/test_connections');
                const d = await res.json();
                
                // Update node cards
                d.nodes.forEach(n => {
                    const statEl = document.getElementById('stat-' + n.id);
                    if (statEl) {
                        statEl.innerText = `PING: ${n.latency_ms} ms | ${n.status}`;
                    }
                });

                if (out) {
                    let logText = `[${new Date().toLocaleTimeString()}] Live Connection Diagnostic Report:
` +
                        `• Overall Status: ${d.overall_health}
` +
                        `• Average Latency: ${d.average_latency_ms} ms
` +
                        `• Verified Endpoints:
`;
                    d.nodes.forEach(n => {
                        logText += `  - ${n.name}: ${n.status} (${n.latency_ms} ms) [${n.throughput_score}]
`;
                    });
                    out.innerText = logText;
                }

                showStudioToast('Connection Test Passed', `All 6 data endpoints verified (Avg Latency: ${d.average_latency_ms} ms).`, 'success');
            } catch (err) {
                if (out) out.innerText = `Connection test error: ${err}`;
                showStudioToast('Connection Test Failed', String(err), 'error');
            }
        }

        // 5. Data Engineer: Real-Time Folder Ingestion
        async function runFolderIngestion() {
            const folderInput = document.getElementById('folderIngestPath');
            const folder = folderInput ? folderInput.value.trim() : 'data_ingestion';
            
            logLocal('DataEngineer', `Initiating batch folder ingestion from: ${folder}`);
            showStudioToast('Batch Ingestion Started', `Scanning folder '${folder}' for Excel, CSV, TSV, and Text files...`, 'info');
            
            const progressCont = document.getElementById('ingestProgressContainer');
            const progressBar = document.getElementById('ingestProgressBar');
            if (progressCont) progressCont.style.display = 'block';
            if (progressBar) progressBar.style.width = '45%';

            const out = document.getElementById('dataEngineerOutput');
            if (out) out.innerText = `Reading files from ${folder}, cleaning columns, and deduplicating...`;

            try {
                const res = await fetch(`/api/data_engineer/ingest_folder?folder=${encodeURIComponent(folder)}&auto_dedup=true`, { method: 'POST' });
                const d = await res.json();

                if (progressBar) progressBar.style.width = '100%';
                setTimeout(() => { if (progressCont) progressCont.style.display = 'none'; }, 1000);

                // Update gauges
                { const _el = document.getElementById('deSpeedGauge'); if (_el) _el.innerText = `${d.throughput_mb_s} MB/s`; }
                { const _el = document.getElementById('deRowsSec'); if (_el) _el.innerText = `${d.rows_per_sec} records/sec`; }
                { const _el = document.getElementById('deLatencyGauge'); if (_el) _el.innerText = `${d.total_duration_ms} ms`; }
                { const _el = document.getElementById('deRecordsCount'); if (_el) _el.innerText = `${d.final_loaded_rows.toLocaleString()} rows`; }
                { const _el = document.getElementById('deDedupCount'); if (_el) _el.innerText = `${d.duplicates_removed} scrubbed`; }

                if (out) {
                    let logText = `[${new Date().toLocaleTimeString()}] Batch Ingestion Completed Successfully:
` +
                        `• Source Directory: ${d.folder}
` +
                        `• Files Ingested: ${d.total_files} files
` +
                        `• Total Records Extracted: ${(d.total_extracted_rows || 0).toLocaleString()}
` +
                        `• Final Unique Loaded Rows: ${(d.final_loaded_rows || 0).toLocaleString()}
` +
                        `• Duplicates Scrubbed: ${d.duplicates_removed}
` +
                        `• Ingestion Speed: ${d.throughput_mb_s} MB/s (${d.rows_per_sec} rows/sec)
` +
                        `• Total Duration: ${d.total_duration_ms} ms (DB Load: ${d.load_duration_ms} ms)
` +
                        `• Destination SQLite Table: '${d.target_table}'

` +
                        `File Breakdown:
`;
                    d.files.forEach(f => {
                        logText += `  - ${f.file_name} (${f.size_kb} KB, ${f.rows_extracted} rows in ${f.latency_ms} ms)
`;
                    });
                    out.innerText = logText;
                }

                showStudioToast('Data Ingestion Complete!', `Loaded ${d.final_loaded_rows} rows from ${d.total_files} files at ${d.throughput_mb_s} MB/s.`, 'success');
                loadLiveNotifications();
            } catch (err) {
                if (progressCont) progressCont.style.display = 'none';
                if (out) out.innerText = `Ingestion error: ${err}`;
                showStudioToast('Ingestion Error', String(err), 'error');
            }
        }

        // 6. Data Engineer: T-1 Reconciliation Report
        async function generateT1Report() {
            logLocal('DataEngineer', 'Compiling T-1 reconciliation report...');
            showStudioToast('T-1 Report Initiated', 'Aggregating past 24h operational metrics...', 'info');
            const out = document.getElementById('dataEngineerOutput');
            if (out) out.innerText = 'Generating executive T-1 data reconciliation report and dispatching via Email & Telegram...';

            try {
                const res = await fetch('/api/data_engineer/t1_report?send_email=true&send_telegram=true', { method: 'POST' });
                const d = await res.json();

                if (out) {
                    out.innerText = `[${new Date().toLocaleTimeString()}] T-1 Reconciliation Report Dispatched:
` +
                        `• Report Date: ${d.report_date}
` +
                        `• Records Reconciled: ${(d.records_analyzed || 0).toLocaleString()}
` +
                        `• Email Dispatched: ${d.email_dispatched ? 'Yes' : 'No'}
` +
                        `• Telegram Dispatched: ${d.telegram_dispatched ? 'Yes' : 'No'}
` +
                        `• Report Saved To: ${d.report_path}

` +
                        d.report_content;
                }

                showStudioToast('T-1 Report Dispatched', `Reconciled ${(d.records_analyzed || 0).toLocaleString()} records and sent notifications.`, 'success');
                loadLiveNotifications();
            } catch (err) {
                if (out) out.innerText = `T-1 Report error: ${err}`;
                showStudioToast('T-1 Report Error', String(err), 'error');
            }
        }

        // 7. Data Engineer: Prompt Enhancer
        function applyETLTemplate(tpl) {
            const raw = document.getElementById('deSqlWorkspaceInput');
            if (!raw) return;
            if (tpl === 'batch') {
                raw.value = 'Auto-ingest all files in data_ingestion directory, detect delimiters, normalize column names, and load to data_engineer_records table.';
            } else if (tpl === 'dedup') {
                raw.value = 'Scrub incoming dataset, impute numeric nulls with 0.0, eliminate duplicate records by primary key, and notify Telegram bot.';
            } else if (tpl === 't1') {
                raw.value = 'Generate automated T-1 daily reconciliation report, verify record counts, check disk space, and dispatch summary via Email and Telegram.';
            }
        }

        async function enhanceETLPromptAction() {
            const raw = document.getElementById('deSqlWorkspaceInput');
            const val = raw ? raw.value.trim() : '';
            if (!val) {
                alert('Please enter a natural language ETL prompt or click a template above.');
                return;
            }
            logLocal('DataEngineer', `Enhancing ETL prompt: ${val.substring(0, 40)}`);
            try {
                const res = await fetch('/api/data_engineer/enhance_prompt', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ prompt: val })
                });
                const d = await res.json();
                { const _el = document.getElementById('deEnhancedPromptWrapper'); if (_el) _el.style.display = 'block'; }
                { const _el = document.getElementById('deEnhancedPromptOutput'); if (_el) _el.innerText = d.enhanced_prompt; }
                showStudioToast('ETL Prompt Synthesized', 'Industrial specification ready for execution.', 'success');
            } catch (err) {
                alert('Prompt enhancement failed: ' + err);
            }
        }

        // Initialize real-time notification polling
        setTimeout(loadLiveNotifications, 1500);
        setInterval(loadLiveNotifications, 12000);


        let isTestingAws = false;
        async function testAwsConnectionAction() {
            if (isTestingAws) return;
            isTestingAws = true;
            const btn = document.getElementById('btnTestAws');
            const badge = document.getElementById('badgeAwsStatus');
            const resultBox = document.getElementById('awsTestResultBox');
            const origHtml = btn ? btn.innerHTML : '🔍 Test AWS Connection';

            if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Testing AWS...'; }
            if (badge) { badge.innerText = 'Testing...'; badge.style.color = '#38BDF8'; badge.style.background = 'rgba(56,189,248,0.15)'; }
            if (resultBox) {
                resultBox.style.display = 'block';
                resultBox.style.background = '#0F172A';
                resultBox.style.border = '1px solid #334155';
                resultBox.innerHTML = '<span class="spinner-sm"></span> Verifying AWS S3 Data Lake (s3://nanopro-data-lake) in ap-southeast-7...';
            }

            try {
                const res = await fetch('/api/connections/test/aws', { method: 'POST', headers: { 'Accept': 'application/json' } });
                let d = null;
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) d = await res.json();
                else d = { success: false, status: 'Error', message: 'Server returned non-JSON' };

                const isSuccess = d && (d.success === true || d.status === 'Connected');
                if (badge) {
                    badge.innerText = d.status || (isSuccess ? 'Connected' : 'Failed');
                    badge.style.color = isSuccess ? '#10B981' : (d.status === 'Not Configured' ? '#94A3B8' : '#EF4444');
                    badge.style.background = isSuccess ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
                }

                if (resultBox) {
                    let html = `<div style="font-weight:700; color:${isSuccess ? '#10B981' : '#F59E0B'}; margin-bottom:4px;">
                        ${isSuccess ? '✅ AWS S3 Connected' : 'Notice: AWS S3 ' + (d.status || 'Status')}
                    </div>`;
                    html += `<div style="color:#CBD5E1; font-size:11.5px; line-height:1.4;">
                        <div><strong>Region:</strong> ${d.region || 'ap-southeast-7'} | <strong>Bucket:</strong> ${d.bucket || 'nanopro-data-lake'}</div>
                        <div>${d.message || ''}</div>
                        ${d.troubleshooting ? `<div style="margin-top:4px; color:#F59E0B;">${d.troubleshooting}</div>` : ''}
                    </div>`;
                    resultBox.innerHTML = html;
                }
                await refreshConnectionHealthTable();
            } catch (e) {
                if (resultBox) resultBox.innerHTML = `<div style="color:#EF4444;">❌ Error: ${e.message || e}</div>`;
            } finally {
                isTestingAws = false;
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

