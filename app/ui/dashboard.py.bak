            <h3 style="font-size:13.5px; color:#F8FAFC; margin:0;">&#128220; Agent Delegation &amp; Collaboration Activity Timeline</h3>
            <span style="font-size:11px; color:#10B981;">&#9679; Live Activity Feed</span>
        </div>
        <div id="officeCollaborationTimeline" style="max-height:160px; overflow-y:auto; font-size:11.5px; font-family:Consolas, monospace; color:#94A3B8; background:#060B18; padding:10px; border-radius:6px; border:1px solid var(--border); line-height:1.6;">
            [Ready] All 205 registered specialist agents standing by in normal operations mode across 13 Pods.
        </div>
    </div>

    <!-- Comprehensive Agent Details Inspector Modal -->
    <div id="agentDetailsModal" class="command-palette-backdrop" style="display:none;" onclick="if(event.target===this) closeAgentDetailsModal()">
        <div class="command-palette-card" style="max-width:620px; padding:20px; background:#0B132B; border:1px solid var(--border-highlight);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">
                <div style="display:flex; gap:12px; align-items:center;">
                    <div id="modalAgentIcon" style="width:48px; height:48px; border-radius:50%; background:#1E293B; border:2px solid #38BDF8; display:flex; align-items:center; justify-content:center; font-size:24px;">&#129302;</div>
                    <div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <h3 id="modalAgentName" style="margin:0; font-size:16px; color:#F8FAFC;">Agent Name</h3>
                            <span id="modalAgentStateBadge" class="badge" style="background:#065F46; color:#34D399; font-size:10px;">IDLE</span>
                        </div>
                        <div id="modalAgentGroup" style="font-size:11px; color:#38BDF8; margin-top:2px;">Group A: Core Orchestration</div>
                    </div>
                </div>
                <button type="button" onclick="closeAgentDetailsModal()" style="background:none; border:none; color:#94A3B8; font-size:22px; cursor:pointer;">&times;</button>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px; font-size:12px;">
                <div>
                    <span style="color:var(--text-muted); font-size:10.5px; text-transform:uppercase;">Role / Mission:</span>
                    <div id="modalAgentRole" style="color:#F8FAFC; font-weight:600; margin-top:2px;">Data Engineering</div>
                </div>
                <div>
                    <span style="color:var(--text-muted); font-size:10.5px; text-transform:uppercase;">Assigned AI Model:</span>
                    <div id="modalAgentModel" style="color:#C084FC; font-weight:600; margin-top:2px;">qwen2.5-coder:7b (Ollama Local)</div>
                </div>
            </div>

            <div style="margin-bottom:12px;">
                <span style="color:var(--text-muted); font-size:10.5px; text-transform:uppercase;">Description &amp; Responsibilities:</span>
                <p id="modalAgentDesc" style="font-size:11.5px; color:#CBD5E1; margin:3px 0 0 0; line-height:1.5;"></p>
            </div>

            <div style="margin-bottom:12px;">
                <span style="color:var(--text-muted); font-size:10.5px; text-transform:uppercase;">Permitted Industrial Tools:</span>
                <div id="modalAgentTools" style="display:flex; flex-wrap:wrap; gap:4px; margin-top:4px;"></div>
            </div>

            <div style="background:#060B18; border:1px solid var(--border); border-radius:6px; padding:10px; margin-bottom:14px; font-size:11.5px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                    <span style="color:var(--text-muted);">Current Task:</span>
                    <strong id="modalAgentTask" style="color:#F8FAFC;">Standing by</strong>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span style="color:var(--text-muted);">Progress:</span>
                    <span id="modalAgentProgressText" style="color:#38BDF8;">0%</span>
                </div>
                <div style="width:100%; height:5px; background:#1E293B; border-radius:3px; overflow:hidden;">
                    <div id="modalAgentProgressBar" style="width:0%; height:100%; background:#38BDF8; transition:width 0.3s;"></div>
                </div>
                <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:10.5px; color:var(--text-muted);">
                    <span>Tasks Completed: <strong id="modalAgentSuccessCount" style="color:#10B981;">0</strong></span>
                    <span>Failed: <strong id="modalAgentFailCount" style="color:#EF4444;">0</strong></span>
                    <span>Elapsed: <strong id="modalAgentElapsed">0s</strong></span>
                </div>
            </div>

            <!-- Custom Task Input & Hidden Agent ID -->
            <input type="hidden" id="modalAgentId" value="" />
            <div style="margin-bottom:12px;">
                <label class="input-label" style="font-size:10.5px; text-transform:uppercase;">Assign Custom Task to Agent:</label>
                <div style="display:flex; gap:8px;">
                    <input type="text" class="studio-input" id="modalAgentTaskInput" placeholder="Enter custom mission (e.g. Ingest S3 table, Run security audit)..." style="flex:1; font-size:12px;" />
                </div>
            </div>

            <!-- Action Controls for Agent -->
            <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end;">
                <button type="button" class="btn btn-secondary" onclick="assignCustomTaskToAgentModal()" style="font-size:11px;">&#10024; Assign Custom Task</button>
                <button type="button" class="btn btn-secondary" onclick="triggerModalAgentAction('pause')" style="font-size:11px; color:#F59E0B;">&#10074;&#10074; Pause</button>
                <button type="button" class="btn btn-secondary" onclick="triggerModalAgentAction('resume')" style="font-size:11px; color:#10B981;">&#9654; Resume</button>
                <button type="button" class="btn btn-secondary" onclick="triggerModalAgentAction('stop')" style="font-size:11px; color:#EF4444;">&#9632; Reset / Stop</button>
                <button type="button" class="btn btn-primary" onclick="openAgentInAiManager()" style="font-size:11px;">Talk in AI Manager &rarr;</button>
            </div>
        </div>
    </div>
</div>

        <div class="workspace-view" id="view-backups">
            <div class="panel-card">
                <h2>Backups &amp; Studio Database Memory</h2>
                <div class="btn-row" style="margin-top:0; margin-bottom:14px;">
                    <button type="button" class="btn btn-primary" onclick="createSystemBackup()">&#128190; Create Full Backup Archive</button>
                    <button type="button" class="btn btn-secondary" onclick="loadMemoryStats()">Refresh Statistics</button>
                </div>
                <div id="memoryStatsBox" style="font-size:13px; color:var(--text-muted); line-height:1.7;">
                    Loading persistent SQLite memory stats...
                </div>
            </div>

            <div class="panel-card">
                <h2>Search Knowledge Base &amp; Historical Prompts</h2>
                <div class="btn-row" style="margin-top:0; margin-bottom:10px;">
                    <input type="text" class="studio-input" id="searchMemInput" placeholder="Search saved prompts, tasks, and knowledge..." style="flex:1;" />
                    <button type="button" class="btn btn-secondary" onclick="searchMemory()">Search Memory</button>
                </div>
                <div class="viewer-box" id="memorySearchResults">Enter keyword above to search database records.</div>
            </div>
        </div>

        <!-- VIEW: LIVE EXECUTION LOGS -->
        <div class="workspace-view" id="view-logs">
            <div class="panel-card" style="flex-grow:1; display:flex; flex-direction:column;">
                <h2>Live Global Activity Stream
                    <div>
                        <button type="button" class="btn btn-secondary" onclick="copyViewer('fullLogsBox')" style="font-size:11px; padding:3px 10px;">Copy All</button>
                        <button type="button" class="btn btn-secondary" onclick="clearLiveLogs()" style="font-size:11px; padding:3px 10px;">Clear View</button>
                    </div>
                </h2>
                <div class="viewer-box" id="fullLogsBox" style="max-height:600px; height:480px; color:#34D399;">Connecting to log stream...</div>
            </div>
        </div>

        <!-- VIEW: SETTINGS -->
        <div class="workspace-view" id="view-settings">
            <div class="panel-card">
                <h2>AI Studio Settings &amp; Model Diagnostics</h2>
                <!-- Background Discovery Schedule & Notification Settings -->
                <div style="background:#0F172A; border:1px solid #334155; border-radius:10px; padding:16px; margin-bottom:16px;">
                    <h3 style="font-size:14px; color:#38BDF8; margin-bottom:6px;">&#9200; Background Discovery Scheduler &amp; Telegram Alerts</h3>
                    <p style="font-size:12px; color:#94A3B8; margin-bottom:14px;">
                        Configure autonomous health checks and hourly Telegram digest delivery. Runs in the background without freezing the UI.
                    </p>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:12px;">
                        <div>
                            <label class="input-label">Schedule Cadence</label>
                            <select class="studio-input" id="schedCadenceSelect" onchange="onCadenceChange()">
                                <option value="3600">Hourly (Every 1 Hour) [Default]</option>
                                <option value="7200">Every 2 Hours</option>
                                <option value="21600">Every 6 Hours</option>
                                <option value="86400">Daily (Every 24 Hours)</option>
                                <option value="custom">Custom Seconds...</option>
                            </select>
                        </div>
                        <div id="customIntervalDiv" style="display:none;">
                            <label class="input-label">Custom Seconds</label>
                            <input type="number" class="studio-input" id="schedCustomSeconds" value="3600" min="60" />
                        </div>
                        <div>
                            <label class="input-label">Telegram Notifications</label>
                            <select class="studio-input" id="schedTgEnabled">
                                <option value="true" selected>Enabled (@mangesh_technews_bot)</option>
                                <option value="false">Disabled (UI Only)</option>
                            </select>
                        </div>
                        <div>
                            <label class="input-label">All Systems Healthy Digest</label>
                            <select class="studio-input" id="schedHealthyDigest">
                                <option value="true" selected>Send Brief Digest Even If Healthy</option>
                                <option value="false">Send Only When Issues/Opportunities Exist</option>
                            </select>
                        </div>
                    </div>

                    <div style="margin-top:14px;">
                        <label class="input-label">Active Discovery Inspection Categories</label>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:8px; font-size:12px; color:#E2E8F0;">
                            <label><input type="checkbox" class="sched-cat-chk" value="application_status" checked> 1. Application Status</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="system_health" checked> 2. System Health</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="feature_health" checked> 3. Feature Health</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="ai_model_health" checked> 4. AI Model Health</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="database_health" checked> 5. Database Health</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="telegram_health" checked> 6. Telegram Health</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="new_improvements" checked> 7. New Improvements</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="development_ideas" checked> 8. Development Ideas</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="issue_detection" checked> 9. Issue Detection</label>
                            <label><input type="checkbox" class="sched-cat-chk" value="security_reliability" checked> 10. Security &amp; Reliability</label>
                        </div>
                    </div>

                    <div class="btn-row" style="margin-top:14px;">
                        <button type="button" class="btn btn-primary" onclick="saveDiscoverySystemConfig()">&#128190; Save Scheduler Configuration</button>
                        <button type="button" class="btn btn-secondary" onclick="sendTestTelegramNotification()">&#128276; Send Test Notification</button>
                        <button type="button" class="btn btn-accent" onclick="runDiscoveryCycleManual()">&#9658; Run Discovery Cycle Now</button>
                    </div>
                </div>

                <label class="input-label">Connected Model Status</label>
                <div class="viewer-box" id="modelsDiagBox">Inspecting model adapter...</div>
                
                <div class="btn-row">
                    <button type="button" class="btn btn-primary" onclick="testSelectedModel('qwen2.5-coder:3b')">Test qwen2.5-coder:3b</button>
                    <button type="button" class="btn btn-secondary" onclick="testSelectedModel('qwen2.5-coder:7b')">Test qwen2.5-coder:7b</button>
                    <button type="button" class="btn btn-secondary" onclick="loadModelList()">Refresh Models</button>
                </div>
            </div>
        </div>

        <!-- VIEW: 1. AI MANAGER (NATURAL LANGUAGE COMMAND & DIALOGUE CENTER) -->

<div class="workspace-view active" id="view-ai_manager">
            <div class="panel-card unified-manager-card">
                <!-- Modern Chat Topbar -->
                <div class="manager-chat-topbar">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div style="width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg, #1E3A8A, #38BDF8); display:flex; align-items:center; justify-content:center; font-size:18px; box-shadow:0 0 10px rgba(56,189,248,0.3);">&#129302;</div>
                        <div>
                            <div style="font-size:14px; font-weight:800; color:#F8FAFC; letter-spacing:0.3px; display:flex; align-items:center; gap:8px;">
                                <span>AI Manager — Conversational Command Center</span>
                                <span style="background:#1E293B; border:1px solid #38BDF8; color:#38BDF8; font-size:10px; padding:2px 8px; border-radius:4px; font-family:monospace;">JARVIS v13</span>
                            </div>
                            <div style="font-size:11px; color:#94A3B8; display:flex; align-items:center; gap:10px;">
                                <span><span style="color:#10B981;">&#9679;</span> Telemetry: <strong>205 Agents Connected</strong></span>
                                <span>&bull;</span>
                                <span>Model: <strong id="topbarManagerModel">qwen2.5-coder:7b (Ollama)</strong></span>
                                <span>&bull;</span>
                                <span id="managerStateIndicator" style="color:#38BDF8; font-weight:600;">Ready</span>
                            </div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <button type="button" class="btn btn-secondary" onclick="clearManagerConversation()" style="font-size:11px; padding:5px 10px;" title="Reset chat session">&#x21BB; New Chat</button>
                        <button type="button" class="btn btn-secondary" onclick="copyViewer('managerChatStream')" style="font-size:11px; padding:5px 10px;" title="Copy transcript">&#128203; Copy Chat</button>
                        <button type="button" class="btn btn-secondary" onclick="exportChatTranscript()" style="font-size:11px; padding:5px 10px;" title="Export transcript">&#128190; Export</button>
                        <button type="button" class="btn btn-accent" onclick="switchView('approvals')" style="font-size:11px; padding:5px 10px;">Approval Queue</button>
                        <button type="button" class="btn btn-accent" onclick="switchView('vault')" style="font-size:11px; padding:5px 10px;">Credentials Vault</button>
                    </div>
                </div>

                <!-- Main Scrollable Conversation Timeline (Holds #managerChatStream) -->
                <div class="manager-timeline-container" id="managerChatStream">
                    <!-- Initial Welcome Message from AI Manager -->
                    <div class="chat-msg manager" id="welcomeManagerMsg">
                        <div class="msg-avatar">&#129302;</div>
                        <div class="msg-bubble">
                            <div class="msg-sender">AI Manager <span class="msg-tag">Central Orchestrator</span></div>
                            <div class="msg-text">
                                AI Manager Ready. How can I assist you with your models, data pipelines, coding, or automation today?
                                <br><br>
                                I discuss requirements, formulate multi-agent architecture plans, secure credentials into the Vault, and orchestrate our 205 specialized agents across 13 Pods with verified test executions. Speak or type in <strong>English</strong>, <strong>मराठी (Marathi)</strong>, or <strong>हिंदी (Hindi)</strong>.
                            </div>
                            <div class="msg-meta">
                                <span>Just now</span> &bull; <span>Status: Ready</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contextual Follow-up Suggestion Chips Bar -->
                <div class="manager-chips-bar" id="managerSuggestionsBar">
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Build a Snowflake ETL pipeline with Python validation and SQL testing.')">&#128736; "Build Snowflake ETL pipeline"</button>
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Connect these two tables and show me customer balances.')">&#128452; "Customer balances"</button>
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Explain this in simple language.')">&#128161; "Explain in simple language"</button>
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Make a graph.')">&#128202; "Make a graph"</button>
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Top 10 upcoming / latest trends: Snowflake vs AWS for data engineering in 2026')">&#9729; "Snowflake vs AWS 2026 trends"</button>
                    <button type="button" class="action-chip" onclick="quickFillPrompt('Check database table inventory and records count.')">&#128451; "Table inventory"</button>
                </div>

                <!-- Modern Message Composer (Docked at Bottom) -->
                <div class="manager-composer-container">
                    <!-- Composer Input Row -->
                    <div style="display:flex; gap:10px; align-items:flex-end;">
                        <div style="flex:1; position:relative;">
                            <textarea class="studio-input" id="managerChatInput" rows="2" style="width:100%; resize:vertical; max-height:140px; min-height:46px; font-size:13px; line-height:1.45; padding:10px 14px; background:#060A14; border:1px solid #283C62; border-radius:8px; color:#F8FAFC;" placeholder="Ask, discuss solutions, or command: e.g. 'Build a Snowflake ETL pipeline with Python validation and SQL testing' (Enter to send, Shift+Enter for newline)..."></textarea>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            <!-- Voice Mic Button -->
                            <button type="button" id="managerVoiceMicBtn" class="btn btn-secondary" onclick="toggleManagerVoiceRecording()" style="height:46px; min-width:46px; padding:0 12px; font-size:16px; display:flex; align-items:center; justify-content:center; gap:6px;" title="Speak in Marathi, Hindi, or English">
                                <span>&#127908;</span>
                                <span id="managerMicStatusText" style="font-size:11px; font-weight:600; display:none;">Listening...</span>
                            </button>
                            <!-- Send Button -->
                            <button type="button" id="managerSendBtn" class="btn btn-primary" onclick="sendManagerMessage()" style="height:46px; padding:0 18px; font-size:12.5px; font-weight:700; display:flex; align-items:center; gap:6px;">
                                <span>&#9658;</span> Send
                            </button>
                            <!-- Stop Button (Hidden by default) -->
                            <button type="button" id="managerStopBtn" class="btn btn-secondary" onclick="stopManagerGeneration()" style="display:none; height:46px; padding:0 14px; background:#EF4444; color:#FFF; font-size:12px; font-weight:700;">
                                &#9209; Stop
                            </button>
                        </div>
                    </div>

                    <!-- Composer Sub-toolbar -->
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px; font-size:11.5px; color:#94A3B8;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <div style="display:flex; align-items:center; gap:6px;">
                                <label style="color:#64748B;">Voice Language:</label>
                                <select id="managerVoiceLangSelect" class="studio-input" style="padding:2px 8px; font-size:11px; height:24px; background:#0B1120;" onchange="onManagerVoiceLanguageChanged()">
                                    <option value="mr-IN">मराठी (mr-IN)</option>
                                    <option value="hi-IN">हिंदी (hi-IN)</option>
                                    <option value="en-IN" selected>Indian English (en-IN)</option>
                                    <option value="en-US">US English (en-US)</option>
                                </select>
                            </div>
                            <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                                <input type="checkbox" id="managerTtsCheckbox" checked style="cursor:pointer;">
                                <span>Spoken Voice Response</span>
                            </label>
                            <span id="managerVoiceStatePill" style="display:none; color:#38BDF8; font-weight:600;">&#9679; Listening</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="color:#64748B;">Tip: Enter to send &bull; Shift+Enter for new line</span>
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('managerChatInput').value=''" style="padding:2px 8px; font-size:10.5px;">Clear</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="workspace-view" id="view-voice_assistant">
    <div class="panel-card" style="text-align:center; max-width:820px; margin:0 auto;">
        <h2>Nano Pro Voice Operating Station</h2>
        <p style="font-size:12.5px; color:var(--text-muted); max-width:680px; margin:0 auto 16px auto;">
            Speak naturally in <strong>मराठी (Marathi)</strong>, <strong>हिंदी (Hindi)</strong>, or <strong>English</strong>. Say <em>"Hi NanoPro"</em> to activate or click the central AI Manager Symbol below.
        </p>

        <!-- Central AI Manager Voice Symbol -->
        <div style="margin:24px 0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <div id="bigVoiceOrb" class="ai-manager-symbol-container state-ready" onclick="toggleVoiceRecording()" style="padding:14px 28px; border-radius:40px; transform:scale(1.2);">
                <div class="manager-core-orb" style="width:36px; height:36px;">
                    <div class="orb-inner" style="width:18px; height:18px;"></div>
                    <div class="orb-ring ring-1" style="width:30px; height:30px;"></div>
                    <div class="orb-ring ring-2" style="width:36px; height:36px;"></div>
                </div>
                <div class="manager-symbol-label">
                    <span class="symbol-name" style="font-size:13px;">AI MANAGER</span>
                    <span class="symbol-state" id="bigVoiceState" style="font-size:10px;">CLICK TO SPEAK</span>
                </div>
            </div>
            <div id="voiceFeedbackText" style="font-size:13px; color:#F8FAFC; margin-top:20px; font-weight:600;">
                Click Symbol or Say "Hi NanoPro" to Begin Speaking
            </div>
        </div>

        <!-- Voice Settings & Privacy Controls -->
        <div style="display:flex; flex-wrap:wrap; gap:12px; justify-content:center; align-items:center; background:#11192E; padding:12px 16px; border-radius:8px; border:1px solid #263354; margin-top:14px;">
            <div>
                <label style="font-size:11px; color:var(--text-muted); display:block; text-align:left;">Language Mode:</label>
                <select id="voiceLanguageSelect" class="studio-input" style="padding:5px 8px; font-size:12px;" onchange="onVoiceLanguageChanged()">
                    <option value="mr-IN" selected>मराठी (Marathi - mr-IN)</option>
                    <option value="hi-IN">हिंदी (Hindi - hi-IN)</option>
                    <option value="en-IN">Indian English (en-IN)</option>
                    <option value="en-US">US English (en-US)</option>
                </select>
            </div>
            <div>
                <label style="font-size:11px; color:var(--text-muted); display:block; text-align:left;">Wake-Word Detection:</label>
                <button type="button" id="btnWakeWordToggle" class="btn btn-secondary" onclick="toggleWakeWordListener()" style="font-size:11px; padding:5px 10px;">
                    &#127908; Wake-Word: DISABLED
                </button>
            </div>
            <div style="display:flex; gap:6px; align-items:flex-end;">
                <button type="button" class="btn btn-secondary" onclick="stopSpeaking()" style="font-size:11px; padding:6px 12px; background:#EF4444; color:#FFF;">&#9209; Stop Speaking</button>
                <button type="button" class="btn btn-secondary" onclick="switchView('ai_manager')" style="font-size:11px; padding:6px 12px;">Open Conversation Stream</button>
            </div>
        </div>

        <!-- Voice Telemetry, Spoken Transcript & AI Response -->
        <div style="margin-top:16px; text-align:left; background:#0B1120; border:1px solid #1E293B; border-radius:8px; padding:14px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <span style="font-size:11px; font-weight:700; color:#38BDF8;">🎙️ Live Speech Transcript</span>
                <span id="voiceStatusBadge" class="badge" style="background:#10B981; color:#FFFFFF; font-size:10px;">VOICE READY</span>
            </div>
