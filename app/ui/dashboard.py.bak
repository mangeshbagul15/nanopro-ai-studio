            </div>
        </div>

        
<div class="workspace-view" id="view-ai_office">
    <!-- Header with 8 Overview KPI Gauges -->
    <div class="panel-card" style="margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
            <div>
                <h2>Animated AI Agent Office — Futuristic Operations Center</h2>
                <p style="font-size:12px; color:var(--text-muted); margin:0;">
                    Real-time operational command center orchestrating all 205 registered specialist AI agents across 13 pods.
                </p>
