            <button type="button" class="btn btn-primary" onclick="runDSExperiment()">&#9889; Run Quick ML Pipeline</button>
        </div>
    </div>

    <!-- Dataset Explorer & Feature Preprocessing -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
        <div class="panel-card">
            <h3 style="font-size:13px; color:#38BDF8; margin-bottom:8px;">1. Dataset Explorer &amp; Feature Preprocessing</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:11.5px; margin-bottom:10px;">
                <div>
                    <label class="input-label">Dataset Source:</label>
                    <select class="studio-input" id="dsDatasetSelect" onchange="onDsDatasetChanged()">
                        <option value="financial_transactions">Financial Transactions (142.5K rows)</option>
                        <option value="customer_churn">Customer Churn &amp; Balances (10K rows)</option>
                        <option value="credit_risk">Credit Risk &amp; Default Scoring</option>
                    </select>
                </div>
                <div>
                    <label class="input-label">Target Feature (Y):</label>
                    <input type="text" class="studio-input" id="dsTargetCol" value="total_amount" />
                </div>
            </div>
            <div style="font-size:11.5px; color:var(--text-muted); line-height:1.6;">
                <div>• Cleaned Missing Values: <strong style="color:#10B981;">0 NaNs (Imputed via Median)</strong></div>
                <div>• Categorical Encoding: <strong style="color:#38BDF8;">One-Hot Encoding Applied</strong></div>
                <div>• Train / Test Split: <strong style="color:#A78BFA;">80% Train / 20% Validation</strong></div>
            </div>
        </div>

        <div class="panel-card">
            <h3 style="font-size:13px; color:#38BDF8; margin-bottom:8px;">2. Model Training Configuration</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:11.5px; margin-bottom:10px;">
                <div>
                    <label class="input-label">Algorithm:</label>
                    <select class="studio-input" id="dsModelAlgorithm">
                        <option value="rf">Random Forest Regressor</option>
                        <option value="linear">Ridge / Linear Regression</option>
                        <option value="dt">Gradient Boosted Trees</option>
                        <option value="logistic">Logistic Classifier</option>
                    </select>
                </div>
                <div>
                    <label class="input-label">Hyperparameters:</label>
                    <input type="text" class="studio-input" id="dsHyperparams" value="n_estimators=100, max_depth=12" />
                </div>
            </div>
            <button type="button" class="btn btn-primary" onclick="trainCustomDsModel()" style="width:100%; justify-content:center;">
                &#128300; Train Model &amp; Compute Metrics
            </button>
        </div>
    </div>

    <!-- Evaluation Metrics & Prediction Playground -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <div class="panel-card">
            <h3 style="font-size:13px; color:#F8FAFC; margin-bottom:8px;">Model Evaluation &amp; Validation Scores</h3>
            <div id="dsMetricsGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                <div class="kpi-card" style="padding:10px; text-align:center;">
                    <div class="kpi-title">R² SCORE / ACCURACY</div>
                    <div class="kpi-value" style="color:#10B981; font-size:20px;" id="dsMetricAccuracy">0.942</div>
                </div>
                <div class="kpi-card" style="padding:10px; text-align:center;">
                    <div class="kpi-title">RMSE / LOSS</div>
                    <div class="kpi-value" style="color:#38BDF8; font-size:20px;" id="dsMetricRmse">0.038</div>
                </div>
            </div>
            <div class="viewer-box" id="dsOutput" style="max-height:160px;">Click [Train Model &amp; Compute Metrics] to evaluate model performance.</div>
        </div>

        <div class="panel-card">
            <h3 style="font-size:13px; color:#F8FAFC; margin-bottom:8px;">Live Prediction Playground</h3>
            <div style="font-size:11.5px; margin-bottom:8px;">
                <label class="input-label">Feature Vector Input (CSV):</label>
                <input type="text" class="studio-input" id="dsPredictVector" value="101, 14500.0, 1.2, 0.45" />
            </div>
            <button type="button" class="btn btn-secondary" onclick="predictDsInstance()" style="margin-bottom:8px;">
                &#9889; Predict Outcome
            </button>
            <div style="background:#060B18; border:1px solid var(--border); border-radius:6px; padding:10px; font-size:12px; color:#34D399;" id="dsPredictionResult">
                Prediction: Expected Transaction Balance = ₹18,420.50 (Confidence: 96.8%)
            </div>
        </div>
    </div>
</div>

