            } else {
                subjRow.style.display = 'none';
                lbl.innerText = 'Telegram Chat ID';
                recip.value = '1200023268';
                recip.placeholder = 'Telegram Chat ID';
            }
        }

        async function loadSmtpConfig() {
            try {
                const res = await fetch('/api/communication/smtp/config');
                const d = await res.json();
                if (d.configured && d.config) {
                    document.getElementById('smtpHostInput').value = d.config.host || 'smtp.gmail.com';
                    document.getElementById('smtpPortInput').value = d.config.port || 587;
                    document.getElementById('smtpUserInput').value = d.config.username || 'mangeshbagul15@gmail.com';
                    document.getElementById('smtpSenderEmail').value = d.config.sender_email || 'mangeshbagul15@gmail.com';
                    document.getElementById('smtpSenderName').value = d.config.sender_name || 'Mangesh AI Studio';
                    document.getElementById('smtpPassInput').value = 'agunjgvexwcjudbx';
                    document.getElementById('kpiSmtpStatus').innerText = 'CONNECTED';
                    document.getElementById('kpiSmtpStatus').style.color = '#10B981';
                }
            } catch (err) {
                console.error('Error loading SMTP config:', err);
            }
        }

        async function saveSmtpConfigAction() {
            const host = (document.getElementById('smtpHostInput')?.value || '').trim();
            const port = parseInt(document.getElementById('smtpPortInput')?.value, 10) || 587;
            const user = (document.getElementById('smtpUserInput')?.value || '').trim();
            const pwd = (document.getElementById('smtpPassInput')?.value || '').trim();
            const sender = (document.getElementById('smtpSenderEmail')?.value || '').trim();
            const name = (document.getElementById('smtpSenderName')?.value || 'Mangesh AI Studio').trim();
            const mode = document.getElementById('smtpSecurityMode')?.value || 'STARTTLS';

            if (!host) {
                alert('Please enter SMTP Server Host (e.g. smtp.gmail.com).');
                return;
            }
            if (!user) {
                alert('Please enter your Authentication Username / Email.');
                return;
            }

            try {
                const res = await fetch('/api/communication/smtp/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        host: host, port: port, username: user,
                        password: pwd, sender_email: sender || user,
                        sender_name: name, security_mode: mode
                    })
                });
                let d = null;
                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    d = { status: 'error', message: `Server error: ${raw.slice(0, 200)}` };
                }
                const logBox = document.getElementById('commLogBox');
                if (logBox) logBox.innerText = 'SMTP Configuration Saved in Vault (AES-256-GCM):\n' + JSON.stringify(d, null, 2);
                alert('SMTP configuration saved and encrypted in Credentials Vault (AES-256-GCM)!');
                if (pwd) {
                    const passInput = document.getElementById('smtpPassInput');
                    if (passInput) {
                        passInput.value = '';
                        passInput.placeholder = '•••••••••••••••• (Encrypted in Vault)';
                    }
                }
                loadSmtpConfig();
            } catch (err) {
                alert('Failed to save SMTP: ' + (err.message || err));
            }
        }

        let isTestingSmtp = false;
        async function testSmtpConnectionAction() {
            if (isTestingSmtp) return;

            const host = (document.getElementById('smtpHostInput')?.value || '').trim();
            const portInput = (document.getElementById('smtpPortInput')?.value || '').trim();
            const port = parseInt(portInput, 10);
            const user = (document.getElementById('smtpUserInput')?.value || '').trim();
            const pwd = (document.getElementById('smtpPassInput')?.value || '').trim();
            const mode = document.getElementById('smtpSecurityMode')?.value || 'STARTTLS';
            const logBox = document.getElementById('commLogBox');
            const testBtn = document.querySelector('button[onclick="testSmtpConnectionAction()"]');

            // 1. Client-Side Field Validation
            if (!host) {
                if (logBox) logBox.innerText = '❌ Validation Error: SMTP Server Host is required.';
                alert('Please enter the SMTP Server Host (e.g., smtp.gmail.com).');
                return;
            }
            if (!port || isNaN(port) || port < 1 || port > 65535) {
                if (logBox) logBox.innerText = `❌ Validation Error: Invalid SMTP Port "${portInput}". Must be between 1 and 65535.`;
                alert('Please enter a valid SMTP Port (e.g., 587 for STARTTLS or 465 for SSL/TLS).');
                return;
            }
            if (!user) {
                if (logBox) logBox.innerText = '❌ Validation Error: Authentication Username / Email is required.';
                alert('Please enter your Authentication Username (e.g., your email address).');
                return;
            }

            // 2. Port & Security Mode Compatibility Warnings
            if (mode === 'STARTTLS' && port === 465) {
                if (!confirm('Notice: Port 465 is typically reserved for SSL/TLS mode. Port 587 is standard for STARTTLS.\n\nDo you want to proceed with STARTTLS on Port 465?')) {
                    return;
                }
            } else if ((mode === 'SSL' || mode === 'SSL/TLS') && port === 587) {
                if (!confirm('Notice: Port 587 is typically used with STARTTLS mode. Port 465 is standard for SSL/TLS.\n\nDo you want to proceed with SSL/TLS on Port 587?')) {
                    return;
                }
            } else if (mode === 'Plain') {
                if (!confirm('⚠️ Security Warning: Plain unencrypted SMTP transmits credentials over the network in cleartext without encryption.\n\nAre you sure you want to test an unencrypted connection?')) {
                    return;
                }
            }

            // 3. UI Loading State & Prevent Duplicate Requests
            isTestingSmtp = true;
            const originalBtnHtml = testBtn ? testBtn.innerHTML : '🔍 Test Connection Handshake';
            if (testBtn) {
                testBtn.disabled = true;
                testBtn.innerHTML = '⏳ Testing Handshake...';
            }
            if (logBox) {
                logBox.innerText = `[${new Date().toLocaleTimeString()}] Initiating live SMTP handshake to ${host}:${port} (${mode})...\n• Checking socket reachability...\n• Negotiating TLS/SSL encryption...\n• Verifying authentication handshake...`;
            }

            // 4. Safe Fetch & Response Parsing
            try {
                const res = await fetch('/api/communication/smtp/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        host: host,
                        port: port,
                        username: user,
                        password: pwd,
                        security_mode: mode,
                        timeout: 10.0
                    })
                });

                let d = null;
                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    try {
                        d = await res.json();
                    } catch (jsonErr) {
                        const rawText = await res.text().catch(() => '');
                        d = {
                            success: false,
                            status: 'Response Parse Error',
                            error_code: 'INVALID_JSON_RESPONSE',
                            message: `Server returned malformed JSON: ${rawText.slice(0, 300)}`
                        };
                    }
                } else {
                    const rawText = await res.text().catch(() => '');
                    d = {
                        success: false,
                        status: `HTTP ${res.status}`,
                        error_code: 'NON_JSON_RESPONSE',
                        message: `Server returned non-JSON response (${res.status} ${res.statusText}): ${rawText.slice(0, 300)}`
                    };
                }

                // Format Output
                const isSuccess = d && (d.success === true || d.status === 'Connected');
                let report = `=======================================================\n`;
                report += `       SMTP CONNECTION HANDSHAKE DIAGNOSTIC REPORT     \n`;
                report += `=======================================================\n`;
                report += `Status            : ${isSuccess ? '✅ ' + (d.status || 'Connected') : '❌ ' + (d.status || 'Connection Failed')}\n`;
                report += `Target Host       : ${d.host || host}:${d.port || port}\n`;
                report += `Security Mode     : ${d.security_mode || mode}\n`;
                report += `Username          : ${d.username || user}\n`;
                if (d.response_time_ms !== undefined) {
                    report += `Response Time     : ${d.response_time_ms} ms\n`;
                }
                if (d.timestamp) {
                    report += `Timestamp         : ${d.timestamp}\n`;
                }
                if (d.provider_response) {
                    report += `Provider Response : ${d.provider_response}\n`;
                }
                if (d.message) {
                    report += `Summary Message   : ${d.message}\n`;
                }
                if (d.warning) {
                    report += `Warning           : ${d.warning}\n`;
                }
                if (d.error_code) {
                    report += `Error Code        : ${d.error_code}\n`;
                }
                if (d.troubleshooting) {
                    report += `\nTroubleshooting Instructions:\n${d.troubleshooting}\n`;
                }
                report += `=======================================================\n`;

                if (logBox) logBox.innerText = report;
            } catch (err) {
                if (logBox) {
                    logBox.innerText = `❌ Network / Execution Error:\nCould not complete request to backend server: ${err.message || err}\nCheck that the backend server is running on port 8000.`;
                }
            } finally {
                isTestingSmtp = false;
                if (testBtn) {
                    testBtn.disabled = false;
                    testBtn.innerHTML = originalBtnHtml;
                }
            }
        }

        let isSendingTestEmail = false;
        async function sendTestEmailAction() {
            if (isSendingTestEmail) return;

            const recipient = prompt("Enter recipient email address for live test message:", "mangeshbagul15@gmail.com");
            if (!recipient || !recipient.trim()) return;

            if (!confirm(`Are you sure you want to send a live test email to: ${recipient.trim()}?\n\nThis will initiate actual SMTP transmission using your saved credentials.`)) {
                return;
            }

            const logBox = document.getElementById('commLogBox');
            const btn = document.querySelector('button[onclick="sendTestEmailAction()"]');
            const origHtml = btn ? btn.innerHTML : '✉️ Send Test Email';

            isSendingTestEmail = true;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '⏳ Sending Email...';
            }
            if (logBox) {
                logBox.innerText = `[${new Date().toLocaleTimeString()}] Submitting test email to ${recipient.trim()} via SMTP...\n• Connecting to SMTP server...\n• Authenticating and submitting message...`;
            }

            try {
                const res = await fetch('/api/communication/smtp/send_test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ recipient: recipient.trim() })
                });

                let d = null;
                const contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    d = await res.json();
                } else {
                    const raw = await res.text().catch(() => '');
                    d = { success: false, status: 'Error', message: `Server error: ${raw.slice(0, 200)}` };
                }

                let report = `=======================================================\n`;
                report += `             LIVE TEST EMAIL DELIVERY REPORT           \n`;
                report += `=======================================================\n`;
                report += `Delivery Status   : ${d.success ? '✅ ' + (d.status || 'Accepted by SMTP Server') : '❌ ' + (d.status || 'Delivery Failed')}\n`;
                report += `Recipient         : ${d.recipient || recipient.trim()}\n`;
                report += `Subject           : ${d.subject || 'Mangesh Nano Pro AI Studio — Gmail Integration Test'}\n`;
                if (d.submission_time) report += `Submission Time   : ${d.submission_time}\n`;
                if (d.provider_response) report += `Provider Response : ${d.provider_response}\n`;
                if (d.note) report += `Delivery Note     : ${d.note}\n`;
                if (d.error) report += `Error Details     : ${d.error}\n`;
                report += `=======================================================\n`;
                if (logBox) logBox.innerText = report;
                if (typeof loadCommLogs === 'function') loadCommLogs();
            } catch (err) {
                if (logBox) logBox.innerText = `❌ Error dispatching test email: ${err.message || err}`;
            } finally {
                isSendingTestEmail = false;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }

