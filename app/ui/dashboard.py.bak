        }

        async function searchGitHubLive() {
            const container = document.getElementById('githubProjectsContainer');
            const query = document.getElementById('githubSearchInput').value || 'ai voice assistant';
            const lang = document.getElementById('githubLanguageSelect').value;

            container.innerHTML = '<div style="color:var(--accent-blue); padding:20px;">Searching GitHub API live with verified local fallback...</div>';

