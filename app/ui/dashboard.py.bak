        <!-- VIEW: 5. DATA ENGINEER WORKSPACE (ANIMATED INGESTION & WAREHOUSE) -->
        <div class="workspace-view" id="view-data_engineer">
    <!-- Header Card -->
    <div class="panel-card" style="margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
                <h2>Data Engineering &amp; 3D Lakehouse Pipeline Center</h2>
