            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">ACTIVE AGENTS</div>
                <div style="font-size:19px; font-weight:800; color:#10B981;" id="officeKpiActive">0</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">PROCESSING TASKS</div>
                <div style="font-size:19px; font-weight:800; color:#EC4899;" id="officeKpiProcessing">0</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">IDLE / STANDBY</div>
                <div style="font-size:19px; font-weight:800; color:#94A3B8;" id="officeKpiStandby">205</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">ATTENTION NEEDED</div>
                <div style="font-size:19px; font-weight:800; color:#EF4444;" id="officeKpiAttention">0</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">RUNNING WORKFLOWS</div>
                <div style="font-size:19px; font-weight:800; color:#A78BFA;" id="officeKpiWorkflows">0</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">PENDING TASKS</div>
                <div style="font-size:19px; font-weight:800; color:#F59E0B;" id="officeKpiPending">0</div>
            </div>
            <div class="office-overview-card">
                <div style="font-size:10px; color:var(--text-muted); font-weight:700;">FAILED TASKS</div>
                <div style="font-size:19px; font-weight:800; color:#EF4444;" id="officeKpiFailed">0</div>
            </div>
        </div>

        <!-- Filter & Search Command Bar -->
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; padding-top:10px; border-top:1px solid var(--border);">
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <input type="text" class="studio-input" id="officeSearchAgentInput" placeholder="Search 205 agents by name, role, or tool..." oninput="filterOfficeAgents(this.value)" style="width:240px; padding:6px 12px; font-size:11.5px;" />
                <select class="studio-input" id="officePodFilter" onchange="filterOfficePod(this.value)" style="padding:6px 10px; font-size:11.5px;">
                    <option value="all">All 13 Pods (205 Agents)</option>
                    <option value="A">Group A: Core Cognitive &amp; Orchestration (5)</option>
                    <option value="B">Group B: Data Engineering &amp; Pipeline Fabric (20)</option>
                    <option value="C">Group C: Snowflake &amp; Oracle Specialized Engine (20)</option>
                    <option value="D">Group D: Data Quality, Governance &amp; Catalog (15)</option>
                    <option value="E">Group E: AWS Database Migration Service (DMS) (15)</option>
                    <option value="F">Group F: Enterprise Analytics &amp; BI (20)</option>
                    <option value="G">Group G: Autonomous AI/MLOps &amp; Deep Learning (20)</option>
                    <option value="H">Group H: Cyber Defense &amp; Vault Security (15)</option>
                    <option value="I">Group I: SRE &amp; Infrastructure Resiliency (15)</option>
                    <option value="J">Group J: Career Radar &amp; MNC HR Outreach (20)</option>
                    <option value="K">Group K: Communication Center (15)</option>
                    <option value="L">Group L: Automated Schedulers &amp; CRON (15)</option>
                    <option value="M">Group M: Lifestyle &amp; Live News (10)</option>
                </select>
                <select class="studio-input" id="officeStatusFilter" onchange="filterOfficeStatus(this.value)" style="padding:6px 10px; font-size:11.5px;">
                    <option value="all">All Statuses</option>
                    <option value="Running">Running / Active</option>
                    <option value="Assigned">Assigned</option>
                    <option value="Idle">Idle / Standby</option>
                    <option value="Completed">Completed</option>
                    <option value="Failed">Failed / Blocked</option>
                </select>
                <select class="studio-input" id="officeSortSelect" onchange="sortOfficeAgents(this.value)" style="padding:6px 10px; font-size:11.5px;">
                    <option value="group">Sort: By Group</option>
                    <option value="name">Sort: By Name</option>
                    <option value="state">Sort: By State</option>
                    <option value="duration">Sort: By Duration</option>
                </select>
            </div>
            <div style="font-size:11px; color:var(--text-muted);" id="officeFilteredCountLabel">
                Showing 205 of 205 agents
            </div>
        </div>
    </div>

    <!-- Live Data Flow & Delegation Banner -->
    <div id="officeDataFlowBanner" style="display:none; background:rgba(30,58,138,0.3); border:1px solid #38BDF8; border-radius:8px; padding:10px 14px; margin-bottom:12px; font-size:12px; color:#38BDF8; align-items:center; gap:10px;">
        <span style="animation:pulseListen 1s infinite; font-size:16px;">&#9889;</span>
        <div style="flex:1;">
            <div style="font-size:10px; color:#94A3B8; text-transform:uppercase; font-weight:700;">Active Task Delegation &amp; Agent Handoff</div>
            <div id="officeDataFlowText" style="font-weight:700; color:#F8FAFC;">Manager Agent &rarr; Snowflake Agent &rarr; Report Agent</div>
        </div>
