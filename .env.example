# Environment Configurations for Mangesh Nano Pro AI Studio

# Studio Settings
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000

# Secure Credentials (Retrieved securely, never hardcoded in source code)
# Gmail SMTP Integration (Sender: mangeshbagul15@gmail.com, Mobile: 8433755448)
GMAIL_APP_PASSWORD=
SMTP_PASSWORD=

# Snowflake Warehouse (NANO_PRO_SNOWFLAKE, EGPKNWZ-XH53504, User: mangeshbagul15)
SNOWFLAKE_PASSWORD=

# Oracle XE Database
ORACLE_HOST=192.168.31.240
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=

# Additional Oracle Connections
ORACLE_LOCAL_HOST=127.0.0.1
ORACLE_REMOTE_HOST=192.168.31.240
ORACLE_TAILSCALE_HOST=100.112.86.83

# AWS Infrastructure & S3 Data Lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_S3_BUCKET=

# NanoPro bank source model seed (BigQuery CBS snapshots + S3 raw zone + Snowflake layers)
# Paste the entire BigQuery service-account JSON file as a single line (no line breaks).
# Then run: python scripts/run_bank_core_seed.py --rows 100
GCP_SERVICE_ACCOUNT_JSON=

# Oracle → AWS DMS → S3 → Snowflake scheduled pipeline
# Keep these blank until a real AWS DMS task and Snowflake landing SQL are configured.
# The DMS task must be configured for Oracle full-load + CDC to an S3 target.
NANOPRO_DMS_TASK_ARN=
# Each SQL statement must be idempotent and target the configured landing/medallion objects.
NANOPRO_SNOWFLAKE_COPY_SQL=
NANOPRO_SNOWFLAKE_L1_SQL=
NANOPRO_SNOWFLAKE_L2_SQL=
# Report SQL may use {report_start}, {report_end}, and {execution_date} ISO date placeholders.
# Include live and T1 measures if a comparison is required by the report.
NANOPRO_SNOWFLAKE_REPORT_SQL=
# Optional AWS DMS create-task support; use ARNs from the same account/region.
DMS_REPLICATION_INSTANCE_ARN=

# Local Ollama Inference (Default)
OLLAMA_HOST=http://127.0.0.1:11434

# Cloud model providers for the data copilot (values only in .env / host env, never in git)
# Groq is the fastest lane for data_analyst routing.
GROQ_API_KEY=
# Google Gemini API key (AI Studio). The AQ.* tokens are Gemini API keys, pass them here.
GEMINI_API_KEY=
GEMINI_API_KEY_SPARE=
OPENROUTER_API_KEY=
# Optional: the Anthropic key must have credit balance, otherwise the adapter fast-fails.
ANTHROPIC_API_KEY=

# Telegram Multi-Bot Integration
# Chat ID (your personal Telegram user ID — same for all bots)
TELEGRAM_CHAT_ID=1200023268

# Bot 1: News & AI Trends (@mangesh_technews_bot)
